---
import type { HydratedTag } from "@modules/tags";

type TagCardTag = HydratedTag & {
  headline?: string | null;
  image_url?: string | null;
  imageAlt?: string | null;
};

interface Props {
  tag: TagCardTag;
  showArticleCount?: boolean;
  articleCount?: number;
}

const { tag, showArticleCount = false, articleCount = 0 } = Astro.props;
const tagUrl = `/tags/${tag.slug}`;
---

<a href={tagUrl} class="tag-card">
  <div class="tag-content">
    {
      tag.image_url && (
        <div class="tag-image">
          <img
            src={tag.image_url}
            alt={tag.imageAlt || tag.label}
            loading="lazy"
          />
        </div>
      )
    }

    <div class="tag-info">
      <h3 class="tag-label">{tag.label}</h3>
      {tag.headline && <p class="tag-headline">{tag.headline}</p>}

      {
        showArticleCount && (
          <span class="article-count">
            {articleCount} {articleCount === 1 ? "recipe" : "recipes"}
          </span>
        )
      }
    </div>
  </div>
</a>

<style>
  .tag-card {
    display: block;
    background: var(--bg-elevated);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: background-color var(--transition-base), color var(--transition-base), transform var(--transition-base);
    border: 1px solid var(--border-subtle);
  }

  .tag-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
    border-color: var(--brand-accent);
  }

  .tag-content {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .tag-image {
    width: var(--space-14);
    height: var(--space-14);
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
  }

  .tag-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tag-info {
    flex: 1;
    min-width: 0;
  }

  .tag-label {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text);
    margin: 0;
    transition: color var(--transition-fast);
  }

  .tag-card:hover .tag-label {
    color: var(--brand-accent);
  }

  .tag-headline {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin: var(--space-1) 0 0 0;
    line-height: var(--leading-snug);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-count {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    background: var(--bg-inset);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs);
  }
</style>