---
import { getEmbedUrl } from '../../utils/embed';
const { block } = Astro.props as { block: any };
const videoUrl = block.provider === 'youtube'
  ? `https://www.youtube.com/embed/${block.video_id}`
  : block.provider === 'vimeo'
    ? `https://player.vimeo.com/video/${block.video_id}`
    : getEmbedUrl(block.url || block.video_id);
if (!videoUrl) return null;
---
<div class="video-embed" style={`aspect-ratio: ${(block.aspect_ratio || '16:9').replace(':', '/')};`}>
  <iframe src={videoUrl} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy" style="width:100%;height:100%;border:0;border-radius:8px;" />
</div>
