---
import { getEmbedUrl } from '../../utils/embed';
import type { ContentBlock } from '@modules/content-blocks/contract/content-blocks.types';
const { block } = Astro.props as { block: ContentBlock };
const blockRec = block as Record<string, unknown>;
const videoUrl = blockRec.provider === 'youtube'
  ? `https://www.youtube.com/embed/${blockRec.video_id}`
  : blockRec.provider === 'vimeo'
    ? `https://player.vimeo.com/video/${blockRec.video_id}`
    : getEmbedUrl(blockRec.url as string || blockRec.video_id as string);
if (!videoUrl) return null;
---
<div class="video-embed" style={`aspect-ratio: ${((blockRec.aspect_ratio as string) || '16:9').replace(':', '/')};`}>
  <iframe src={videoUrl} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy" style="width:100%;height:100%;border:0;border-radius:var(--radius-sm);" />
</div>
