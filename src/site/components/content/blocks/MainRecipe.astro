---
import RecipeCard from '../../RecipeCard.astro';
import type { SiteArticleRenderModel, SiteAuthorRenderModel, SiteCategoryRenderModel } from '@site/utils/content-render';
const { block, article, recipe_json, author, category } = Astro.props as {
  block: { type: 'main_recipe' };
  article: SiteArticleRenderModel;
  recipe_json: unknown;
  author: SiteAuthorRenderModel | null;
  category: SiteCategoryRenderModel | null;
};
if (!article || !recipe_json) return null;
---
<RecipeCard article={article} recipe_json={recipe_json} author={author} category={category} embedded={true} />
