---
import { renderInlineMarkdown, renderMarkdownText } from '../../utils/markdown';

const AlertIcons = {
  tip: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lightbulb"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.9 1.2 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>`,
  warning: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-alert-triangle"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>`,
  info: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`,
  note: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-alert-circle"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>`,
};

const alertVariants = {
  tip: {
    accent: "var(--accent-sage)",
    titleColor: "var(--text)",
    textColor: "var(--text-secondary)",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`,
    defaultTitle: "Why I Love This Recipe",
  },
  warning: {
    accent: "var(--warning)",
    titleColor: "var(--text)",
    textColor: "var(--text-secondary)",
    icon: AlertIcons.warning,
    defaultTitle: "Attention",
  },
  note: {
    accent: "var(--text-secondary)",
    titleColor: "var(--text)",
    textColor: "var(--text-secondary)",
    icon: AlertIcons.note,
    defaultTitle: "Note",
  },
  info: {
    accent: "var(--info)",
    titleColor: "var(--text)",
    textColor: "var(--text-secondary)",
    icon: AlertIcons.info,
    defaultTitle: "Info",
  },
} as {
  [key: string]: {
    accent: string;
    titleColor: string;
    textColor: string;
    icon: string;
    defaultTitle: string;
  };
};

import type { ContentBlock } from '@modules/content-blocks/contract/content-blocks.types';

const { block } = Astro.props as { block: ContentBlock };
const type = (block as Record<string, unknown>).props?.type || (block as Record<string, unknown>).variant || (block.type === 'tip_box' ? 'tip' : 'warning');
const blockRecord = block as Record<string, unknown>;
const v = alertVariants[type] || alertVariants.info;
let alertTitle = (blockRecord.title as string | undefined) || v.defaultTitle;
if (alertTitle.includes('|')) alertTitle = alertTitle.split('|')[0].trim();
const rawText = (blockRecord.text as string | undefined) || (blockRecord.content as string | undefined) || '';
const alertContent = renderMarkdownText(rawText);
---
<div class="tip-box-premium" role={type === 'warning' ? 'alert' : 'note'} style={`--tip-accent: ${v.accent};`}>
  <div class="tip-box-header">
    <div class="tip-box-icon-badge" set:html={v.icon} />
    <h4 class="tip-box-title" set:html={renderInlineMarkdown(alertTitle)} />
  </div>
  <div class="tip-box-content" set:html={alertContent} />
</div>
