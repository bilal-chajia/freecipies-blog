---
import RoundupItemList from '../../RoundupItemList.astro';
import type { ContentBlock } from '@modules/content-blocks/contract/content-blocks.types';
const { block, roundupJson, startNumber } = Astro.props as {
  block: ContentBlock;
  roundupJson?: Record<string, unknown>;
  startNumber?: number;
};
---
<RoundupItemList
  roundup={Astro.props.roundup}
  block={block}
  roundupJson={roundupJson}
  startNumber={startNumber || 1}
/>
