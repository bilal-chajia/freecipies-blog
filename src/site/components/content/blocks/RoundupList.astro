---
import RoundupItemList from '../../RoundupItemList.astro';
import type { MainRoundupBlock } from '@modules/content-blocks/contract/content-blocks.types';
import type { RoundupJson } from '@modules/articles/types/roundups.types';
const { block, roundup_json, startNumber } = Astro.props as {
  block: MainRoundupBlock;
  roundup_json?: RoundupJson | null;
  startNumber?: number;
};
---
<RoundupItemList
  block={block}
  roundup_json={roundup_json}
  startNumber={startNumber || 1}
/>
