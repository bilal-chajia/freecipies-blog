---
import RoundupItemList from '../../RoundupItemList.astro';
import type { RoundupArticleMap } from '@server/site-data';
const { block, roundupJson, startNumber } = Astro.props as {
  block: any;
  roundupJson?: any;
  roundupArticles?: RoundupArticleMap;
  startNumber?: number;
};
const { roundupArticles = {} } = Astro.props as { roundupArticles?: RoundupArticleMap };
---
<RoundupItemList
  roundup={Astro.props.roundup}
  block={block}
  roundupArticles={roundupArticles}
  startNumber={startNumber || 1}
/>
