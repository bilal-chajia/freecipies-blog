---
import Icon from "../ui/Icon.astro";
import type { Article } from "@modules/articles/schema/articles.schema";

interface Props {
  article: Article;
  heroImageUrl?: string | null;
}

const { article, heroImageUrl } = Astro.props;
---

      {/* ═══ Exact Stitch Cooking Mode Overlay ═══ */}
      <div class="cooking-mode-overlay" data-cooking-mode hidden>
        <div
          class="cm-bg-image"
          data-cm-bg-image
          style={`--cm-bg: url('${heroImageUrl}')`}
        />
        <div class="cm-content-wrap">
          {/* Progress Bar Area */}
          <div class="cm-progress-area">
            <div class="cm-progress-header">
              <p class="cm-progress-label">Progress</p>
              <p class="cm-progress-text" data-progress-text>
                0% Completed
              </p>
            </div>
            <div class="cm-progress-track">
              <div
                class="cm-progress-fill"
                data-progress-bar
                style="width: 0%;"
              />
            </div>
          </div>

          {/* Top Navigation Bar */}
          <div class="cm-top-nav">
            <div class="cm-top-titles">
              <h2 class="cm-top-title">{article.headline}</h2>
              <span class="cm-top-subtitle">Cook Mode</span>
            </div>
            <button
              type="button"
              class="cm-close-btn"
              data-close-cook-mode
              title="Exit cook mode (Esc)"
            >
              <Icon name="x" />
            </button>
          </div>

          {/* Main Content (Step Details) */}
          <div class="cm-main-content">
            {/* Pagination Dots */}
            <div class="cm-dots" data-step-dots />

            <div class="cm-steps-container" data-cooking-steps />

            {/* Sophisticated Timer Component */}
            <div class="cm-timer-panel glass-panel" data-timer-section hidden>
              <span class="cm-timer-label">Resting Timer</span>
              <div class="cm-timer-display" data-timer-display>
                00:00
              </div>
              <div class="cm-timer-controls">
                <button
                  type="button"
                  class="cm-timer-btn cm-timer-btn-stop"
                  data-timer-pause
                  hidden
                >
                  <Icon name="pause" />
                  Stop
                </button>
                <button
                  type="button"
                  class="cm-timer-btn cm-timer-btn-start"
                  data-timer-start
                >
                  <Icon name="play" />
                  Start
                </button>
                <button type="button" class="cm-timer-btn cm-timer-btn-stop" data-timer-reset>
                  <Icon name="timer" />
                  Reset
                </button>
              </div>
            </div>
          </div>

          {/* Floating Bottom Navigation */}
          <div class="cm-bottom-nav-wrap">
            <div class="cm-bottom-nav glass-panel">
              <button type="button" class="cm-nav-btn prev" data-step-prev disabled>
                <Icon name="chevron-left" />
                <span>Previous</span>
              </button>
              <div class="cm-nav-divider" />
              <button type="button" class="cm-nav-btn items" data-toggle-ingredients>
                <Icon name="copy" />
                <span>Ingredients</span>
              </button>
              <button type="button" class="cm-nav-btn next primary" data-step-next>
                <span>Next Step</span>
                <Icon name="chevron-right" />
              </button>
            </div>
          </div>

          {/* Slide-over Ingredients Panel */}
          <aside class="cm-ingredients glass-panel" data-cm-ingredients hidden>
            <div class="cm-ingredients-inner">
              <div class="cm-ingredients-header">
                <h3>Ingredients Needed</h3>
                <button
                  type="button"
                  class="cm-btn-close-ing"
                  data-close-ingredients
                >
                  <Icon name="x" />
                </button>
              </div>
              <ul class="cm-ing-list" data-cm-ing-list />
            </div>
          </aside>
        </div>
      </div>


<style>
  /* ===== Cooking Mode Overlay ===== */
  /* ═══════ EXACT STITCH COOK MODE ═══════ */
  .cooking-mode-overlay {
    position: fixed;
    inset: var(--space-0);
    z-index: var(--z-devtools);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--bg-inset);
    font-family: inherit;
    color: var(--text-inverse);
    min-height: 100vh;
  }
  :global(.dark) .cooking-mode-overlay {
    background-color: var(--bg-active);
  }
  .cooking-mode-overlay[hidden] {
    display: none;
  }
  .cm-bg-image {
    position: absolute;
    inset: var(--space-0);
    background-image:
      linear-gradient(to bottom, color-mix(in srgb, var(--brand-primary-hover) 80%, black), color-mix(in srgb, var(--brand-primary-hover) 95%, black)),
      var(--cm-bg, url(""));
    background-size: cover;
    background-position: center;
    z-index: 1;
  }
  .cm-content-wrap {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
  }

  /* Progress Bar Area */
  .cm-progress-area {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-6) var(--space-4) var(--space-6);
  }
  .cm-progress-header {
    display: flex;
    gap: var(--space-6);
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-1);
  }
  .cm-progress-label {
    color: var(--success);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: var(--space-0);
  }
  .cm-progress-text {
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    margin: var(--space-0);
  }
  .cm-progress-track {
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--neutral-900) 50%, transparent);
    height: 6px;
    overflow: hidden;
  }
  .cm-progress-fill {
    height: 100%;
    border-radius: var(--radius-full);
    background-color: var(--success);
    transition: width var(--transition-base);
  }

  /* Top Navigation Bar */
  .cm-top-nav {
    display: flex;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    justify-content: space-between;
  }
  .cm-top-titles {
    display: flex;
    flex-direction: column;
  }
  .cm-top-title {
    color: var(--text-inverse);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    margin: var(--space-0);
  }
  .cm-top-subtitle {
    color: var(--success);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    margin: var(--space-0);
  }
  .cm-close-btn {
    display: flex;
    height: var(--space-10);
    width: var(--space-10);
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--neutral-900) 40%, transparent);
    border: 1px solid color-mix(in srgb, var(--text-inverse) 15%, transparent);
    color: var(--text-inverse);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }
  .cm-close-btn:hover {
    background-color: color-mix(in srgb, var(--neutral-700) 50%, transparent);
  }

  /* Main Content */
  .cm-main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: var(--space-4) var(--space-8) var(--space-0);
    text-align: center;
    overflow-y: auto;
  }

  /* Pagination Dots */
  .cm-dots {
    display: flex;
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .cm-dots :global(.cm-dot) {
    height: 6px;
    width: 6px;
    border-radius: var(--radius-full);
    background-color: var(--neutral-700);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
    border: none;
    padding: var(--space-0);
    cursor: pointer;
  }
  .cm-dots :global(.cm-dot.active) {
    background-color: var(--success);
    width: var(--space-8);
  }
  .cm-dots :global(.cm-dot.done) {
    background-color: var(--success);
  }

  /* Step Details */
  .cm-steps-container {
    width: 100%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cm-steps-container :global(.cook-step) {
    animation: cmFadeIn var(--transition-base);
  }
  .cm-steps-container :global(.cook-step[hidden]) {
    display: none;
  }
  .cm-steps-container :global(.step-counter) {
    color: var(--success);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
    opacity: 0.8;
  }
  .cm-steps-container :global(.cook-step h3) {
    color: var(--text-inverse);
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-12);
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }
  .cm-steps-container :global(.cook-step p) {
    color: var(--text-tertiary);
    font-size: var(--text-lg);
    margin-bottom: var(--space-6);
  }
  .cm-steps-container :global(.step-timer-badge) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--success-bg);
    color: var(--success-text);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    margin-bottom: var(--space-4);
  }
  .cm-steps-container :global(.step-timer-badge svg) {
    width: var(--space-4);
    height: var(--space-4);
    flex-shrink: 0;
  }
  .cm-steps-container :global(.step-tip) {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--text-inverse) 5%, transparent);
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    text-align: left;
  }
  @keyframes cmFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Sophisticated Timer */
  .glass-panel {
    background: color-mix(in srgb, var(--brand-primary-hover) 70%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid color-mix(in srgb, var(--success) 10%, transparent);
  }
  .cm-timer-panel {
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    width: 100%;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: var(--shadow-xl);
    margin: var(--space-0) auto var(--space-8) auto;
  }
  .cm-timer-panel[hidden] {
    display: none;
  }
  .cm-timer-label {
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .cm-timer-display {
    font-size: 3.75rem;
    font-weight: var(--font-light);
    color: var(--text-inverse);
    margin-bottom: var(--space-6);
    letter-spacing: -0.05em;
  }
  .cm-timer-display.warning {
    color: var(--warning);
  }
  .cm-timer-display.finished {
    color: var(--brand-primary);
    animation: cmPulse 1s infinite;
  }
  @keyframes cmPulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  .cm-timer-controls {
    display: flex;
    gap: var(--space-4);
    width: 100%;
  }
  .cm-timer-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-0);
    border-radius: var(--radius-md);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
    border: none;
  }
  .cm-timer-btn svg {
    width: var(--space-4);
    height: var(--space-4);
  }
  .cm-timer-btn-stop {
    border: 1px solid var(--neutral-700);
    color: var(--neutral-400);
    background: transparent;
  }
  .cm-timer-btn-stop:hover {
    background: color-mix(in srgb, var(--neutral-700) 50%, transparent);
  }
  .cm-timer-btn-start {
    background: var(--success);
    color: var(--bg-active);
    font-weight: var(--font-bold);
  }
  .cm-timer-btn-start:hover {
    box-shadow: 0 0 20px color-mix(in srgb, var(--success) 40%, transparent);
  }
  .cm-timer-btn[hidden] {
    display: none;
  }

  /* Floating Bottom Navigation */
  .cm-bottom-nav-wrap {
    padding: var(--space-6) var(--space-6) var(--space-10) var(--space-6);
    position: absolute;
    bottom: var(--space-0);
    left: 0;
    width: 100%;
  }
  .cm-bottom-nav {
    border-radius: var(--radius-lg);
    padding: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: var(--shadow-xl);
    border-color: color-mix(in srgb, var(--text-inverse) 5%, transparent);
  }
  .cm-nav-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-0);
    border-radius: var(--radius-md);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: background-color var(--transition-fast);
    border: none;
    background: transparent;
  }
  .cm-nav-btn svg,
  .cm-nav-btn :global(svg) {
    width: var(--space-5);
    height: var(--space-5);
    flex-shrink: 0;
  }
  .cm-nav-btn.prev {
    color: var(--text-tertiary);
  }
  .cm-nav-btn.prev:hover:not([disabled]) {
    color: var(--text-inverse);
  }
  .cm-nav-btn.prev[disabled] {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .cm-nav-btn.items {
    color: var(--text-inverse);
  }
  .cm-nav-btn.items:hover {
    background: color-mix(in srgb, var(--text-inverse) 5%, transparent);
  }

  .cm-nav-btn.next {
    background: var(--success);
    color: var(--bg-active);
    font-weight: var(--font-bold);
    box-shadow: 0 10px 15px -3px color-mix(in srgb, var(--success) 10%, transparent);
  }
  .cm-nav-btn.next:hover {
    box-shadow: 0 10px 15px -3px color-mix(in srgb, var(--success) 30%, transparent);
  }

  .cm-nav-divider {
    width: 1px;
    height: var(--space-8);
    background-color: color-mix(in srgb, var(--text-inverse) 15%, transparent);
    margin: var(--space-0) var(--space-2);
  }

  /* Ingredients Slide-over */
  .cm-ingredients {
    position: absolute;
    top: var(--space-0);
    right: var(--space-0);
    bottom: var(--space-0);
    width: 100%;
    max-width: 400px;
    z-index: var(--z-dropdown);
    transform: translateX(100%);
    transition: transform var(--transition-base);
    border-left: 1px solid color-mix(in srgb, var(--text-inverse) 10%, transparent);
  }
  .cm-ingredients:not([hidden]) {
    transform: translateX(0);
  }
  .cm-ingredients-inner {
    padding: var(--space-8) var(--space-6);
    height: 100%;
    overflow-y: auto;
  }
  .cm-ingredients-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
  }
  .cm-ingredients-header h3 {
    margin: var(--space-0);
    font-size: var(--text-xl);
    color: var(--text-inverse);
    font-weight: var(--font-bold);
  }
  .cm-btn-close-ing {
    background: none;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    margin-right: -8px;
  }

  .cm-btn-close-ing svg {
    width: var(--space-6);
    height: var(--space-6);
  }

  .cm-btn-close-ing:hover {
    color: var(--text-inverse);
    background: color-mix(in srgb, var(--text-inverse) 10%, transparent);
  }
  .cm-ing-list {
    list-style: none;
    padding: var(--space-0);
    margin: var(--space-0);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .cm-ing-list :global(li) {
    padding: var(--space-4);
    background: color-mix(in srgb, var(--text-inverse) 5%, transparent);
    border-radius: var(--radius-md);
    color: var(--text-inverse);
    cursor: pointer;
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .cm-ing-list :global(li:hover) {
    background: color-mix(in srgb, var(--text-inverse) 10%, transparent);
  }
  .cm-ing-list :global(li.checked) {
    opacity: 0.5;
  }
  .cm-ing-list :global(.cm-ing-amount) {
    color: var(--success);
    font-weight: var(--font-bold);
    margin-right: var(--space-1);
  }
  .cm-ing-list :global(.cm-ing-unit) {
    color: var(--text-tertiary);
    margin-right: var(--space-1);
  }

  /* ── Mobile cook mode ── */
  @media (max-width: 768px) {
    .cm-ingredients {
      position: absolute;
      inset: var(--space-0);
      width: 100%;
      max-width: none;
      z-index: 10;
      background: color-mix(in srgb, var(--brand-primary-hover) 90%, black);
      backdrop-filter: blur(12px);
    }
    .cm-title {
      font-size: var(--text-sm);
      max-width: 50%;
    }
    .cm-steps-container :global(.cook-step h3) {
      font-size: var(--text-2xl);
    }
    .cm-steps-container :global(.cook-step p) {
      font-size: var(--text-base);
    }
    .cm-timer-display {
      font-size: var(--text-4xl);
    }
    .step-nav {
      flex-direction: column;
      gap: var(--space-2.5);
    }
    .step-btn {
      min-width: 100%;
    }
    .cm-shortcuts {
      display: none;
    }
  }

</style>