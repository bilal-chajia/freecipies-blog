---
/**
 * IngredientsSection - Clean ingredient list with checkboxes
 */

import type { IngredientGroup } from "@modules/articles/types/recipes.types";
import { formatAmount, formatUnit } from "@shared/utils";

interface Props {
  ingredients: IngredientGroup[];
  servings?: number;
}

const { ingredients } = Astro.props;


---

<div class="ingredients-list">
  {
    ingredients.map((group, groupIdx) => (
      <div class="ingredient-group" data-group={groupIdx}>
        {group.group_title && (
          <h3 class="group-title">
            {group.group_title}
          </h3>
        )}
        <ul class="group-items">
          {group.items.map((item, itemIdx) => {
            const globalIdx =
              ingredients
                .slice(0, groupIdx)
                .reduce((acc, g) => acc + g.items.length, 0) + itemIdx;

            return (
              <li class="ingredient-item">
                <label for={`ingredient-${globalIdx}`} class="ingredient-label">
                  <input
                    id={`ingredient-${globalIdx}`}
                    type="checkbox"
                    class="ingredient-check"
                    data-ingredient-check
                    data-index={globalIdx}
                    aria-label={`Mark ${item.amount ? formatAmount(item.amount) : ''} ${item.unit ? formatUnit(item.unit, Number(item.amount) || 0) : ''} ${item.name} as checked`}
                  />
                  <span class="checkmark" aria-hidden="true" />
                  <span class="ingredient-text">
                    <span
                      class="amount"
                      data-ingredient-amount
                      data-original-amount={item.amount}
                    >
                      {formatAmount(item.amount)}
                    </span>
                    {item.unit && (
                      <span 
                        class="unit" 
                        data-ingredient-unit 
                        data-original-unit={item.unit}
                      >
                        {formatUnit(item.unit, Number(item.amount) || 0)}
                      </span>
                    )}
                    <span class="name">{item.name}</span>
                    {item.prep && <span class="prep">, {item.prep}</span>}
                    {item.is_optional && (
                      <span class="optional">(optional)</span>
                    )}
                  </span>
                </label>
                {item.notes && <p class="ingredient-note">{item.notes}</p>}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .ingredients-list {
    --space-1-5: 0.375rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }

  .ingredient-group {
    min-width: 0;
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-0) var(--space-0) var(--space-3);
    color: var(--text-secondary);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .group-title::after {
    content: "";
    flex: 1 1 auto;
    min-width: var(--space-8);
    height: 1px;
    background: var(--border);
  }

  .group-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    list-style: none;
    margin: var(--space-0);
    padding: var(--space-0);
    min-width: 0;
  }

  .ingredient-item {
    list-style: none;
    margin: var(--space-0);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--bg-alt);
    transition: background var(--transition-fast);
    min-width: 0;
  }

  .ingredient-item:hover {
    background: var(--bg-hover);
  }

  .ingredient-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    cursor: pointer;
    min-width: 0;
  }

  .ingredient-check {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .checkmark {
    width: 22px;
    height: 22px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xs);
    flex: 0 0 22px;
    margin-top: var(--space-1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  .ingredient-check:checked + .checkmark {
    background: var(--success);
    border-color: var(--success);
  }

  .ingredient-check:checked + .checkmark::after {
    content: "✓";
    color: var(--text-inverse);
    font-size: var(--text-sm);
  }

  .ingredient-check:focus-visible + .checkmark {
    outline: var(--focus-ring-width, 2px) solid var(--focus-ring-color, currentColor);
    outline-offset: var(--focus-ring-offset, 2px);
  }

  .ingredient-text {
    min-width: 0;
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    overflow-wrap: anywhere;
  }

  .ingredient-check:checked ~ .ingredient-text {
    opacity: 0.5;
    text-decoration: line-through;
  }

  .amount {
    margin-right: var(--space-1);
    color: var(--text);
    font-weight: var(--font-bold);
  }

  .unit {
    margin-right: var(--space-1);
    color: var(--text-tertiary);
  }

  .name {
    color: var(--text);
  }

  .prep {
    color: var(--text-tertiary);
    font-style: italic;
  }

  .optional {
    margin-left: var(--space-1);
    color: var(--text-tertiary);
    font-size: var(--text-xs);
  }

  .ingredient-note {
    margin: var(--space-1-5) var(--space-0) var(--space-0) calc(22px + var(--space-3));
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    font-style: italic;
    line-height: var(--leading-normal);
    overflow-wrap: anywhere;
  }

  @media (max-width: 420px) {
    .ingredient-item {
      padding: var(--space-3);
    }

    .ingredient-label {
      gap: var(--space-3);
    }

    .ingredient-text {
      font-size: var(--text-base);
    }

    .ingredient-note {
      margin-left: calc(22px + var(--space-3));
    }
  }

  @media print {
    .ingredient-check {
      position: static;
      width: auto;
      height: auto;
      clip: auto;
      clip-path: none;
    }

    .checkmark {
      display: none;
    }
  }
</style>
