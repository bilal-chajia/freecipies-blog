---
/**
 * HeroImage - Responsive hero image component
 *
 * Displays a hero image with srcset support for responsive loading.
 */

interface Props {
    src?: string;
    alt?: string;
    width?: number;
    height?: number;
    srcset?: string;
    sizes?: string;
    style?: string;
    loading?: "eager" | "lazy";
    class?: string;
}

const {
    src,
    alt = "",
    width,
    height,
    srcset,
    sizes = "(max-width: 768px) 90vw, min(1200px, 100vw - 4rem)",
    style,
    loading = "eager",
    class: className = "",
} = Astro.props;

// Early return if no image
if (!src) {
    return null;
}
---

<div class:list={["hero-image", className]}>
    <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        srcset={srcset || undefined}
        sizes={srcset ? sizes : undefined}
        loading={loading}
        fetchpriority={loading === "eager" ? "high" : undefined}
        decoding="async"
        style={style || undefined}
    />
</div>

<style>
    .hero-image {
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        margin: 1.5rem 0;
    }

    .hero-image img {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
    }
</style>
