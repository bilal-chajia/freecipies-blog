</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document
      .querySelectorAll("[data-toggle-nutrition]")
      .forEach(function (btn) {
        btn.addEventListener("click", function () {
          const section =
            btn.closest(".recipe-card-section") ||
            btn.closest(".nutrition-section");
          const full = section
            ? section.querySelector("[data-full-nutrition]")
            : null;
          if (full) {
            const isHidden = full.hasAttribute("hidden");
            full.toggleAttribute("hidden", !isHidden);
            btn.textContent = isHidden ? "Hide Details" : "Full Details";
          }
        });
      });
  });
</script>
