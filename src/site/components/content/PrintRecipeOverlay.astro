---
/**
 * PrintRecipeOverlay – Custom print-preview overlay for recipes
 *
 * Opens as a full-screen overlay with a clean, print-optimized recipe layout.
 * "Print" button inside prints only the overlay content, "Close" dismisses.
 */

import type { SiteArticleRenderModel, SiteAuthorRenderModel } from "@site/utils/content-render";
import type {
    RecipeJson,
    IngredientGroup,
    InstructionSection,
} from "@modules/articles/types/recipes.types";

interface Props {
    article: SiteArticleRenderModel;
    recipe: RecipeJson;
    author?: SiteAuthorRenderModel | null;
    heroImageUrl?: string;
    heroImageAlt?: string;
}

const { article, recipe, author, heroImageUrl, heroImageAlt } = Astro.props;

const ingredients: IngredientGroup[] = recipe?.ingredients || [];
const instructions: InstructionSection[] = recipe?.instructions || [];
const nutrition = recipe?.nutrition as Record<string, unknown> | null | undefined;
const nutritionCalories = nutrition?.calories as string | number | null | undefined;
const nutritionProtein = nutrition?.protein_g as string | number | null | undefined;
const nutritionFat = nutrition?.total_fat_g as string | number | null | undefined;
const nutritionCarbs = nutrition?.total_carbohydrate_g as string | number | null | undefined;
const nutritionFiber = nutrition?.dietary_fiber_g as string | number | null | undefined;
const nutritionSodium = nutrition?.sodium_mg as string | number | null | undefined;
const tips = recipe?.tips || [];
const servings = recipe?.servings || 4;
const prepTime = recipe?.prep || 0;
const cookTime = recipe?.cook || 0;
const totalTime = recipe?.total || prepTime + cookTime;

function formatTime(minutes: number | null | undefined): string {
    if (!minutes) return "";
    if (minutes < 60) return minutes + " min";
    const hrs = Math.floor(minutes / 60);
    const mins = minutes % 60;
    return mins > 0 ? hrs + " hr " + mins + " min" : hrs + " hr";
}

function formatAmount(amount: number | string | null | undefined): string {
    let num = typeof amount === "string" ? parseFloat(amount) : amount;
    if (num === null || num === undefined || isNaN(num as number)) return "";
    num = num as number;
    if (num === 0) return "";

    const whole = Math.floor(num);
    const remainder = num - whole;

    let fractionStr = "";
    if (remainder > 0.01) {
        const fraction = Math.round(remainder * 16) / 16;
        if (Math.abs(fraction - 0.125) < 0.01) fractionStr = "⅛";
        else if (Math.abs(fraction - 0.25) < 0.01) fractionStr = "¼";
        else if (Math.abs(fraction - 0.33) < 0.02) fractionStr = "⅓";
        else if (Math.abs(fraction - 0.375) < 0.01) fractionStr = "⅜";
        else if (Math.abs(fraction - 0.5) < 0.01) fractionStr = "½";
        else if (Math.abs(fraction - 0.625) < 0.01) fractionStr = "⅝";
        else if (Math.abs(fraction - 0.66) < 0.02) fractionStr = "⅔";
        else if (Math.abs(fraction - 0.75) < 0.01) fractionStr = "¾";
        else if (Math.abs(fraction - 0.875) < 0.01) fractionStr = "⅞";
        else if (whole === 0) fractionStr = remainder.toFixed(2).replace(/\.?0+$/, "").replace(/^0/, "");
    }

    if (whole > 0) {
        return fractionStr ? `${whole} ${fractionStr}` : String(whole);
    }
    return fractionStr || "0";
}

function fmtNutrition(
    value: string | number | null | undefined,
    unit: string = "g",
): string {
    if (value === null || value === undefined || value === "") return "-";
    const num = typeof value === "string" ? parseFloat(value) : value;
    if (isNaN(num)) return String(value);
    return Math.round(num) + unit;
}

let stepCounter = 0;

---

<!-- Print Overlay (hidden by default) -->
<div class="print-overlay" id="print-overlay" hidden>
    <!-- Overlay toolbar -->
    <div class="print-toolbar" id="print-toolbar">
        <span class="print-toolbar-title">Print Preview</span>
        <div class="print-toolbar-actions">
            <button
                type="button"
                class="print-action-btn print-now"
                id="print-now-btn"
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    width="18"
                    height="18"
                >
                    <path
                        d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"
                    ></path>
                </svg>
                Download PDF
            </button>
            <button
                type="button"
                class="print-action-btn print-print"
                id="print-print-btn"
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    width="18"
                    height="18"
                >
                    <path
                        d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"
                    ></path>
                    <path d="M6 14h12v8H6z"></path>
                </svg>
                Print
            </button>
            <button
                type="button"
                class="print-action-btn print-close"
                id="print-close-btn"
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    width="18"
                    height="18"
                >
                    <path d="M18 6L6 18M6 6l12 12"></path>
                </svg>
                Close
            </button>
        </div>
    </div>

    <!-- Printable content -->
    <div class="print-content" id="print-content">
        <div class="print-page">
            <!-- Header with image -->
            {
                heroImageUrl && (
                    <div class="print-hero">
                        <img
                            src={heroImageUrl}
                            alt={heroImageAlt || article.headline}
                            class="print-hero-img"
                        />
                    </div>
                )
            }

            <div class="print-body">
                <!-- Title & Author -->
                <div class="print-header">
                    <h1 class="print-title">{article.headline}</h1>
                    {
                        author?.name && (
                            <p class="print-author">By {author.name}</p>
                        )
                    }
                    {
                        article.short_description && (
                            <p class="print-description">
                                {article.short_description}
                            </p>
                        )
                    }
                </div>

                <!-- Stats Row -->
                <div class="print-stats">
                    <div class="print-stat">
                        <span class="print-stat-label">Servings</span>
                        <span class="print-stat-value" data-print-servings>{servings}</span>
                    </div>
                    {
                        prepTime > 0 && (
                            <div class="print-stat">
                                <span class="print-stat-label">Prep</span>
                                <span class="print-stat-value">
                                    {formatTime(prepTime)}
                                </span>
                            </div>
                        )
                    }
                    {
                        cookTime > 0 && (
                            <div class="print-stat">
                                <span class="print-stat-label">Cook</span>
                                <span class="print-stat-value">
                                    {formatTime(cookTime)}
                                </span>
                            </div>
                        )
                    }
                    {
                        totalTime > 0 && (
                            <div class="print-stat">
                                <span class="print-stat-label">Total</span>
                                <span class="print-stat-value">
                                    {formatTime(totalTime)}
                                </span>
                            </div>
                        )
                    }
                    {
                        nutritionCalories && (
                            <div class="print-stat">
                                <span class="print-stat-label">Calories</span>
                                <span class="print-stat-value">
                                    {nutritionCalories} kcal
                                </span>
                            </div>
                        )
                    }
                </div>

                <!-- Ingredients + Instructions (adaptive layout — JS toggles class) -->
                <div class="print-recipe-content" id="print-recipe-content">
                    <!-- Ingredients -->
                    <div class="print-ingredients">
                        <h2 class="print-section-title">Ingredients</h2>
                        {
                            ingredients.map((group) => (
                                <div class="print-ingredient-group">
                                    {group.group_title && (
                                        <h3 class="print-group-title">
                                            {group.group_title}
                                        </h3>
                                    )}
                                    <ul class="print-ingredient-list">
                                        {group.items.map((item) => (
                                            <li class="print-ingredient-item">
                                                <span class="print-ing-amount">
                                                    <span data-ingredient-amount data-original-amount={item.amount}>{formatAmount(item.amount)}</span>{" "}
                                                    <span data-ingredient-unit data-original-unit={item.unit || ""}>{item.unit || ""}</span>
                                                </span>
                                                <span class="print-ing-name">
                                                    {item.name}
                                                    {item.prep && (
                                                        <em>, {item.prep}</em>
                                                    )}
                                                </span>
                                                {item.is_optional && (
                                                    <span class="print-optional">
                                                        (optional)
                                                    </span>
                                                )}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Instructions -->
                    <div class="print-instructions">
                        <h2 class="print-section-title">Instructions</h2>
                        {
                            instructions.map((section) => (
                                <div class="print-instruction-section">
                                    {section.section_title && (
                                        <h3 class="print-group-title">
                                            {section.section_title}
                                        </h3>
                                    )}
                                    <ol
                                        class="print-steps-list"
                                        start={stepCounter + 1}
                                    >
                                        {section.steps.map((step) => {
                                            stepCounter++;
                                            return (
                                                <li class="print-step">
                                                    <div class="print-step-num">
                                                        {stepCounter}
                                                    </div>
                                                    <div class="print-step-body">
                                                        {step.name && (
                                                            <strong>
                                                                {step.name}
                                                            </strong>
                                                        )}
                                                        <p>{step.text}</p>
                                                        {step.tip && (
                                                            <p class="print-step-tip">
                                                                💡 {step.tip}
                                                            </p>
                                                        )}
                                                    </div>
                                                </li>
                                            );
                                        })}
                                    </ol>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <!-- Nutrition Summary -->
                {
                    nutrition && (
                        <div class="print-nutrition">
                            <h2 class="print-section-title">Nutrition Facts</h2>
                            <div class="print-nutrition-grid">
                                {nutritionCalories && (
                                    <div class="print-nut-item">
                                        <span class="print-nut-val">
                                            {nutritionCalories}
                                        </span>
                                        <span class="print-nut-label">
                                            Calories
                                        </span>
                                    </div>
                                )}
                                {nutritionProtein && (
                                    <div class="print-nut-item">
                                        <span class="print-nut-val">
                                            {fmtNutrition(nutritionProtein)}
                                        </span>
                                        <span class="print-nut-label">
                                            Protein
                                        </span>
                                    </div>
                                )}
                                {nutritionFat && (
                                    <div class="print-nut-item">
                                        <span class="print-nut-val">
                                            {fmtNutrition(nutritionFat)}
                                        </span>
                                        <span class="print-nut-label">Fat</span>
                                    </div>
                                )}
                                {nutritionCarbs && (
                                    <div class="print-nut-item">
                                        <span class="print-nut-val">
                                            {fmtNutrition(nutritionCarbs)}
                                        </span>
                                        <span class="print-nut-label">
                                            Carbs
                                        </span>
                                    </div>
                                )}
                                {nutritionFiber && (
                                    <div class="print-nut-item">
                                        <span class="print-nut-val">
                                            {fmtNutrition(nutritionFiber)}
                                        </span>
                                        <span class="print-nut-label">
                                            Fiber
                                        </span>
                                    </div>
                                )}
                                {nutritionSodium && (
                                    <div class="print-nut-item">
                                        <span class="print-nut-val">
                                            {fmtNutrition(
                                                nutritionSodium,
                                                "mg",
                                            )}
                                        </span>
                                        <span class="print-nut-label">
                                            Sodium
                                        </span>
                                    </div>
                                )}
                            </div>
                        </div>
                    )
                }

                <!-- Notes -->
                {
                    tips.length > 0 && (
                        <div class="print-notes">
                            <h2 class="print-section-title">Notes</h2>
                            <ul class="print-notes-list">
                                {tips.map((tip) => (
                                    <li>💡 {tip}</li>
                                ))}
                            </ul>
                        </div>
                    )
                }

                <!-- Footer -->
                <div class="print-footer">
                    <p>Source: {Astro.url.href}</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ── Overlay base ── */
    .print-overlay {
        --space-1-25: 0.3125rem;
        --space-1-5: 0.375rem;
        --space-2-5: 0.625rem;
        --space-3-5: 0.875rem;
        position: fixed;
        inset: var(--space-0);
        z-index: var(--z-devtools);
        background: var(--neutral-50);
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }
    .print-overlay[hidden] {
        display: none !important;
    }

    /* ── Toolbar ── */
    .print-toolbar {
        position: sticky;
        top: var(--space-0);
        z-index: 10001;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-3) var(--space-6);
        background: var(--text);
        color: var(--bg);
        flex-shrink: 0;
    }
    .print-toolbar-title {
        font-weight: var(--font-bold);
        font-size: var(--text-base);
        letter-spacing: 0.02em;
    }
    .print-toolbar-actions {
        display: flex;
        gap: var(--space-2-5);
    }
    .print-action-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1-5);
        padding: var(--space-2) var(--space-4);
        border: none;
        border-radius: var(--radius-xs);
        font-size: var(--text-sm);
        font-weight: var(--font-semibold);
        cursor: pointer;
        transition: background var(--transition-fast);
    }
    .print-now {
        background: var(--accent-sage);
        color: var(--bg);
    }
    .print-now:hover {
        background: var(--brand-secondary);
    }
    .print-close {
        background: var(--text-secondary);
        color: var(--bg);
    }
    .print-close:hover {
        background: var(--text-secondary);
    }
    .print-print {
        background: var(--info);
        color: var(--bg);
    }
    .print-print:hover {
        background: var(--info);
    }
    .print-action-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }
    .spin-icon {
        animation: spin-anim 1s linear infinite;
    }
    @keyframes spin-anim {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }

    /* ── Page content ── */
    .print-content {
        flex: 1;
        display: flex;
        justify-content: center;
        padding: var(--space-8) var(--space-4) var(--space-12);
    }
    .print-page {
        width: 100%;
        max-width: 800px;
        background: var(--bg);
        box-shadow: var(--shadow-md);
        border-radius: var(--radius-sm);
        overflow: hidden;
    }

    /* ── Hero image ── */
    .print-hero {
        width: 100%;
        max-height: 380px;
        overflow: hidden;
    }
    .print-hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* ── Body ── */
    .print-body {
        padding: var(--space-8) var(--space-10) var(--space-10);
    }

    /* ── Header ── */
    .print-header {
        margin-bottom: var(--space-6);
        border-bottom: 2px solid var(--text);
        padding-bottom: var(--space-5);
    }
    .print-title {
        font-size: var(--text-2xl);
        font-weight: var(--font-extrabold);
        line-height: var(--leading-tight);
        margin: var(--space-0) var(--space-0) var(--space-1-5);
        color: var(--text);
    }
    .print-author {
        font-size: var(--text-sm);
        color: var(--text-tertiary);
        margin: var(--space-0) var(--space-0) var(--space-2);
    }
    .print-description {
        font-size: var(--text-sm);
        color: var(--text-secondary);
        line-height: var(--leading-normal);
        margin: var(--space-0);
    }

    /* ── Stats row ── */
    .print-stats {
        display: flex;
        gap: var(--space-0);
        margin-bottom: var(--space-7);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        overflow: hidden;
    }
    .print-stat {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: var(--space-3) var(--space-2);
        border-right: 1px solid var(--border);
    }
    .print-stat:last-child {
        border-right: none;
    }
    .print-stat-label {
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-tertiary);
        font-weight: var(--font-semibold);
    }
    .print-stat-value {
        font-size: var(--text-sm);
        font-weight: var(--font-bold);
        color: var(--text);
        margin-top: 2px;
    }

    /* ── Recipe content layout (adaptive) ── */
    .print-recipe-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-7);
        margin-bottom: var(--space-7);
    }
    .print-recipe-content.layout-two-col {
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        gap: var(--space-8);
    }

    /* ── Section titles ── */
    .print-section-title {
        font-size: var(--text-lg);
        font-weight: var(--font-extrabold);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text);
        margin: var(--space-0) var(--space-0) var(--space-4);
        padding-bottom: var(--space-2);
        border-bottom: 2px solid var(--accent-sage);
    }
    .print-group-title {
        font-size: var(--text-sm);
        font-weight: var(--font-bold);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-tertiary);
        margin: var(--space-4) var(--space-0) var(--space-2);
    }
    .print-group-title:first-child {
        margin-top: var(--space-0);
    }

    /* ── Ingredients list ── */
    .print-ingredient-list {
        list-style: none;
        padding: var(--space-0);
        margin: var(--space-0);
    }
    .print-ingredient-item {
        padding: var(--space-1-25) var(--space-0);
        border-bottom: 1px solid var(--bg-hover);
        font-size: var(--text-sm);
        line-height: var(--leading-normal);
        display: flex;
        gap: var(--space-1-5);
    }
    .print-ingredient-item:last-child {
        border-bottom: none;
    }
    .print-ing-amount {
        font-weight: var(--font-bold);
        color: var(--text);
        white-space: nowrap;
        min-width: 55px;
    }
    .print-ing-name {
        color: var(--text-secondary);
    }
    .print-ing-name em {
        color: var(--text-tertiary);
    }
    .print-optional {
        font-size: var(--text-xs);
        color: var(--text-tertiary);
        font-style: italic;
    }

    /* ── Instructions ── */
    .print-steps-list {
        list-style: none;
        padding: var(--space-0);
        margin: var(--space-0);
        counter-reset: none;
    }
    .print-step {
        display: flex;
        gap: var(--space-3);
        padding: var(--space-2-5) var(--space-0);
        border-bottom: 1px solid var(--bg-hover);
    }
    .print-step:last-child {
        border-bottom: none;
    }
    .print-step-num {
        flex-shrink: 0;
        width: var(--space-6);
        height: var(--space-6);
        background: var(--text);
        color: var(--bg);
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--text-xs);
        font-weight: var(--font-bold);
        margin-top: 2px;
    }
    .print-step-body {
        flex: 1;
        font-size: var(--text-sm);
        line-height: var(--leading-relaxed);
        color: var(--text-secondary);
    }
    .print-step-body strong {
        display: block;
        color: var(--text);
        margin-bottom: 2px;
    }
    .print-step-body p {
        margin: var(--space-0);
    }
    .print-step-tip {
        margin-top: var(--space-1-5) !important;
        font-size: var(--text-xs);
        color: var(--text-tertiary);
        font-style: italic;
    }

    /* ── Nutrition grid ── */
    .print-nutrition {
        margin-bottom: var(--space-6);
    }
    .print-nutrition-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: var(--space-0);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        overflow: hidden;
    }
    .print-nut-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: var(--space-3-5) var(--space-2);
        border-right: 1px solid var(--border);
    }
    .print-nut-item:last-child {
        border-right: none;
    }
    .print-nut-val {
        font-size: var(--text-base);
        font-weight: var(--font-extrabold);
        color: var(--text);
    }
    .print-nut-label {
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-tertiary);
        margin-top: 2px;
    }

    /* ── Notes ── */
    .print-notes {
        margin-bottom: var(--space-6);
    }
    .print-notes-list {
        list-style: none;
        padding: var(--space-0);
        margin: var(--space-0);
    }
    .print-notes-list li {
        padding: var(--space-1-5) var(--space-0);
        font-size: var(--text-sm);
        color: var(--text-secondary);
        border-bottom: 1px solid var(--bg-hover);
    }
    .print-notes-list li:last-child {
        border-bottom: none;
    }

    /* ── Footer ── */
    .print-footer {
        border-top: 1px solid var(--border);
        padding-top: var(--space-3);
        font-size: var(--text-xs);
        color: var(--text-tertiary);
    }
    .print-footer p {
        margin: var(--space-0);
    }

    /* ── Mobile ── */
    @media (max-width: 640px) {
        .print-body {
            padding: var(--space-5) var(--space-4) var(--space-6);
        }
        .print-recipe-content.layout-two-col {
            grid-template-columns: 1fr;
            gap: var(--space-6);
        }
        .print-nutrition-grid {
            grid-template-columns: repeat(3, 1fr);
        }
        .print-nut-item:nth-child(3) {
            border-right: none;
        }
        .print-title {
            font-size: var(--text-xl);
        }
    }

    /* ══════════════════════════════════════
     PRINT MEDIA — Only print the content
     ══════════════════════════════════════ */
    @media print {
        /* Hide toolbar */
        .print-toolbar {
            display: none !important;
        }
        /* Reset overlay to flow */
        .print-overlay {
            position: static;
            background: var(--bg);
            overflow: visible;
        }
        .print-content {
            padding: 0;
        }
        .print-page {
            box-shadow: none;
            border-radius: 0;
            max-width: 100%;
        }
        .print-hero {
            max-height: 300px;
        }
        /* Avoid page breaks inside */
        .print-step {
            break-inside: avoid;
        }
        .print-ingredient-group {
            break-inside: avoid;
        }
        .print-nutrition {
            break-inside: avoid;
        }
    }

    /* Global rules: when body has .printing-recipe, hide everything else */
    :global(body.printing-recipe > *:not(#print-overlay)) {
        display: none !important;
    }
    :global(body.printing-recipe) {
        overflow: visible !important;
    }
    :global(body.printing-recipe #print-overlay) {
        position: static !important;
        display: block !important;
    }
</style>

<script>
    interface Html2PdfFactory {
        (): {
            set: (options: unknown) => {
                from: (element: HTMLElement) => {
                    save: () => Promise<void>;
                };
            };
        };
    }

    interface Html2PdfWindow extends Window {
        html2pdf?: Html2PdfFactory;
    }

    function initPrintOverlay() {
        const overlay = document.getElementById("print-overlay");
        const printBtn = document.getElementById(
            "print-now-btn",
        ) as HTMLButtonElement | null;
        const printPrintBtn = document.getElementById("print-print-btn");
        const closeBtn = document.getElementById("print-close-btn");
        if (!overlay || !printBtn || !printPrintBtn || !closeBtn) return;
        // Non-null cast for use inside nested functions (TS can't track early-return guards into closures)
        const safeOverlay = overlay as HTMLElement;

        // Track original position to restore after closing
        let printOriginalParent: Node | null = null;
        let printOriginalNext: Node | null = null;

        // Open overlay
        function openOverlay() {
            // Move overlay to body to escape container-type containing block
            if (safeOverlay.parentNode !== document.body) {
                printOriginalParent = safeOverlay.parentNode;
                printOriginalNext = safeOverlay.nextSibling;
                document.body.appendChild(safeOverlay);
            }
            safeOverlay.hidden = false;
            document.body.style.overflow = "hidden";
            // Adaptive layout: measure content height after render
            requestAnimationFrame(() => adaptLayout());
        }
        // Close overlay
        function closeOverlay() {
            safeOverlay.hidden = true;
            document.body.style.overflow = "";
            // Restore overlay to its original position in the DOM
            if (printOriginalParent) {
                if (printOriginalNext) {
                    printOriginalParent.insertBefore(safeOverlay, printOriginalNext);
                } else {
                    printOriginalParent.appendChild(safeOverlay);
                }
                printOriginalParent = null;
                printOriginalNext = null;
            }
        }

        // Adaptive layout based on page count
        // A4 at 96dpi ≈ 1123px height
        const A4_PAGE_HEIGHT = 1123;

        function adaptLayout() {
            const contentEl = document.getElementById("print-recipe-content");
            const pageEl = safeOverlay.querySelector(
                ".print-page",
            ) as HTMLElement;
            if (!contentEl || !pageEl) return;

            // Step 1: Measure single-column height
            contentEl.classList.remove("layout-two-col");

            requestAnimationFrame(() => {
                const singleColHeight = pageEl.scrollHeight;
                const singleColPages = Math.ceil(
                    singleColHeight / A4_PAGE_HEIGHT,
                );

                // If it fits in 1 page already, no need for 2 columns
                if (singleColPages <= 1) return;

                // Step 2: Measure two-column height
                contentEl.classList.add("layout-two-col");

                requestAnimationFrame(() => {
                    const twoColHeight = pageEl.scrollHeight;
                    const twoColPages = Math.ceil(
                        twoColHeight / A4_PAGE_HEIGHT,
                    );

                    // Keep 2-col only if it uses fewer pages
                    // Otherwise revert to single-col (cleaner look)
                    if (twoColPages >= singleColPages) {
                        contentEl.classList.remove("layout-two-col");
                    }
                });
            });
        }

        // Listen for custom event from print buttons
        document.addEventListener("openPrintOverlay", openOverlay);

        // Close button
        closeBtn.addEventListener("click", closeOverlay);

        // Print button — move overlay to body, print, then restore
        printPrintBtn.addEventListener("click", () => {
            const originalParent = safeOverlay.parentNode;
            const originalNext = safeOverlay.nextSibling;

            document.body.appendChild(safeOverlay);
            document.body.classList.add("printing-recipe");

            window.print();

            const restore = () => {
                document.body.classList.remove("printing-recipe");
                if (originalParent) {
                    if (originalNext) {
                        originalParent.insertBefore(safeOverlay, originalNext);
                    } else {
                        originalParent.appendChild(safeOverlay);
                    }
                }
            };
            window.addEventListener("afterprint", restore, { once: true });
        });

        // Escape key
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !safeOverlay.hidden) {
                closeOverlay();
            }
        });

        // Lazy-load html2pdf.js
        let html2pdfLoaded = false;
        function loadHtml2Pdf(): Promise<void> {
            if (html2pdfLoaded) return Promise.resolve();
            return new Promise((resolve, reject) => {
                const script = document.createElement("script");
                script.src =
                    "https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.2/html2pdf.bundle.min.js";
                script.onload = () => {
                    html2pdfLoaded = true;
                    resolve();
                };
                script.onerror = reject;
                document.head.appendChild(script);
            });
        }

        // Download PDF — Generate PDF and download (no OS dialog)
        printBtn.addEventListener("click", async () => {
            const originalText = printBtn.innerHTML;
            printBtn.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin-icon"><circle cx="12" cy="12" r="10" stroke-dasharray="31.4 31.4" /></svg> Generating…`;
            printBtn.disabled = true;

            try {
                await loadHtml2Pdf();

                const pageEl = safeOverlay.querySelector(
                    ".print-page",
                ) as HTMLElement;
                if (!pageEl) return;

                // Get recipe title for filename
                const titleEl = pageEl.querySelector(".print-title");
                const filename = titleEl
                    ? titleEl
                          .textContent!.trim()
                          .replace(/[^a-zA-Z0-9 ]/g, "")
                          .replace(/\s+/g, "-")
                          .toLowerCase()
                    : "recipe";

                // Convert all images to inline base64 to avoid CORS blank spaces
                const images = pageEl.querySelectorAll("img");
                await Promise.all(
                    Array.from(images).map(
                        (img) =>
                            new Promise<void>((resolve) => {
                                if (!img.src || img.src.startsWith("data:")) {
                                    resolve();
                                    return;
                                }
                                const canvas = document.createElement("canvas");
                                const ctx = canvas.getContext("2d");
                                const tempImg = new Image();
                                tempImg.crossOrigin = "anonymous";
                                tempImg.onload = () => {
                                    canvas.width = tempImg.naturalWidth;
                                    canvas.height = tempImg.naturalHeight;
                                    ctx?.drawImage(tempImg, 0, 0);
                                    try {
                                        img.src = canvas.toDataURL(
                                            "image/jpeg",
                                            0.9,
                                        );
                                    } catch {
                                        // If tainted, just skip
                                    }
                                    resolve();
                                };
                                tempImg.onerror = () => resolve();
                                tempImg.src = img.src;
                            }),
                    ),
                );

                // Temporarily remove fixed/overflow constraints so html2canvas can capture
                safeOverlay.scrollTop = 0;
                const savedStyles = {
                    position: safeOverlay.style.position,
                    overflow: safeOverlay.style.overflow,
                    height: safeOverlay.style.height,
                    zIndex: safeOverlay.style.zIndex,
                };
                safeOverlay.style.position = "static";
                safeOverlay.style.overflow = "visible";
                safeOverlay.style.height = "auto";

                const opt = {
                    margin: [6, 6, 10, 6],
                    filename: `${filename}.pdf`,
                    image: { type: "jpeg", quality: 0.95 },
                    html2canvas: {
                        scale: 2,
                        useCORS: true,
                        allowTaint: true,
                        letterRendering: true,
                        scrollY: 0,
                        windowHeight: pageEl.scrollHeight,
                    },
                    jsPDF: {
                        unit: "mm",
                        format: "a4",
                        orientation: "portrait",
                    },
                    pagebreak: { mode: ["css"] },
                };

                const html2pdf = (window as Html2PdfWindow).html2pdf;
                if (!html2pdf) throw new Error("html2pdf is not loaded");
                await html2pdf().set(opt).from(pageEl).save();

                // Restore overlay styles
                safeOverlay.style.position = savedStyles.position;
                safeOverlay.style.overflow = savedStyles.overflow;
                safeOverlay.style.height = savedStyles.height;
                safeOverlay.style.zIndex = savedStyles.zIndex;
            } catch (err) {
                console.error("PDF generation failed:", err);
                alert("Failed to generate PDF. Please try again.");
            } finally {
                printBtn.innerHTML = originalText;
                printBtn.disabled = false;
            }
        });

        // Click outside the page to close
        overlay.addEventListener("click", (e) => {
            if (
                e.target === overlay ||
                (e.target as HTMLElement).classList.contains("print-content")
            ) {
                closeOverlay();
            }
        });
    }

    // Init on page load and after Astro view transitions
    initPrintOverlay();
    document.addEventListener("astro:after-swap", initPrintOverlay);
</script>
