---
/**
 * StarRating - Premium Star Rating Component for Recipes
 *
 * Supports full, half, and empty stars with Schema.org microdata.
 * Design inspired by high-end food blogs.
 */

interface Props {
  ratingValue?: number | null;
  ratingCount?: number | null;
  showCount?: boolean;
  size?: "sm" | "md" | "lg";
  itemprop?: string;
  className?: string;
}

const {
  ratingValue = 0,
  ratingCount = 0,
  showCount = true,
  size = "md",
  itemprop = "aggregateRating",
  className = "",
} = Astro.props;

const hasRating = ratingValue != null && ratingValue > 0;
const displayValue = ratingValue ? ratingValue.toFixed(1) : "0.0";

// Ensure rating is within 0-5
const safeRating = Math.max(0, Math.min(5, ratingValue || 0));

const fullStars = Math.floor(safeRating);
const hasHalfStar = safeRating % 1 >= 0.4 && safeRating % 1 <= 0.8;
const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);

// Colors based on project's palette (Natural greens)
const starColor = "var(--accent-sage)"; // Accent Sage Green
const emptyColor = "var(--border)"; // Gray 200
---

{
  hasRating && (
    <div
      class:list={["star-rating-container", size, className]}
      itemprop={itemprop}
      itemscope
      itemtype="https://schema.org/AggregateRating"
    >
      <div
        class="stars-row"
        aria-label={`Rating: ${displayValue} out of 5 stars`}
      >
        {/* Full Stars */}
        {Array.from({ length: fullStars }).map((_, i) => (
          <svg class="star full" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
        ))}

        {/* Half Star */}
        {hasHalfStar && (
          <svg class="star half" viewBox="0 0 24 24">
            <defs>
              <linearGradient id="star-half-grad">
                <stop offset="50%" stop-color={starColor} />
                <stop offset="50%" stop-color={emptyColor} />
              </linearGradient>
            </defs>
            <path
              fill="url(#star-half-grad)"
              d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
            />
          </svg>
        )}

        {/* Empty Stars */}
        {Array.from({ length: emptyStars }).map((_, i) => (
          <svg class="star empty" viewBox="0 0 24 24" fill={emptyColor}>
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
        ))}
      </div>

      {showCount && (
        <div class="rating-info">
          <span class="rating-number" itemprop="ratingValue">
            {displayValue}
          </span>
          {ratingCount && ratingCount > 0 && (
            <span class="rating-count">
              (<span itemprop="ratingCount">{ratingCount}</span>{" "}
              {ratingCount === 1 ? "Review" : "Reviews"})
            </span>
          )}
        </div>
      )}

      {/* Hidden SEO Metadata */}
      <meta itemprop="bestRating" content="5" />
      <meta itemprop="worstRating" content="1" />
    </div>
  )
}

<style>
  .star-rating-container {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: inherit;
  }

  /* Sizes */
  .sm {
    --star-size: var(--text-sm);
    font-size: var(--text-xs);
  }
  .md {
    --star-size: var(--text-lg);
    font-size: var(--text-sm);
  }
  .lg {
    --star-size: var(--space-6);
    font-size: var(--text-base);
  }

  .stars-row {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .star {
    width: var(--star-size);
    height: var(--star-size);
    flex-shrink: 0;
  }

  .star.full {
    color: var(--accent-sage); /* Accent Color */
  }

  .rating-info {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--text-secondary); /* text-gray-600 */
    font-weight: var(--font-medium);
  }

  .rating-number {
    color: var(--text); /* text-gray-900 */
    font-weight: var(--font-bold);
  }

  .rating-count {
    color: var(--text-tertiary); /* text-gray-500 */
    font-size: 0.9em;
  }

  /* Animations */
  .star-rating-container:hover .star {
    transform: scale(1.1);
    transition: transform var(--transition-spring);
  }

  .star-rating-container .star:nth-child(2) {
    transition-delay: 0.05s;
  }
  .star-rating-container .star:nth-child(3) {
    transition-delay: 0.1s;
  }
  .star-rating-container .star:nth-child(4) {
    transition-delay: 0.15s;
  }
  .star-rating-container .star:nth-child(5) {
    transition-delay: 0.2s;
  }
</style>
