---
/**
 * TableOfContents – Clean blog-style TOC (Refactored)
 */
import type { TocSettings } from "@modules/settings/types/settings.types";
import { parseToc, applyNumbering, groupTocByH2 } from "@shared/utils/toc-processing";
import type { TocItem as TocItemType } from "@shared/utils/toc-processing";
import TocHeader from "./toc/TocHeader.astro";
import TocItem from "./toc/TocItem.astro";

interface Props {
    toc: string | TocItemType[] | null | undefined;
    class?: string;
    settings?: TocSettings;
}

const { toc: tocInput, class: className = "", settings } = Astro.props;

// Early exit if disabled
if (settings?.enabled === false) return null;

// Settings with sensible defaults
const numbering = settings?.numbering ?? true;
const collapsible = settings?.collapsible ?? true;
const defaultOpen = settings?.default_open ?? true;
const showJumpButton = settings?.show_jump_button ?? true;
const accentColor = settings?.accent_color || "var(--toc-active-text)";
const maxDepth = Math.min(4, Math.max(2, settings?.max_depth ?? 4));

// Process TOC data
const rawToc = parseToc(tocInput, maxDepth);
if (rawToc.length === 0) return null;

const numberedToc = applyNumbering(rawToc, numbering);
const groupedToc = groupTocByH2(numberedToc);
---

<div
    class:list={["blog-toc", className]}
    data-toc
    data-default-open={String(defaultOpen)}
    style={`--toc-accent: ${accentColor};`}
>
    <TocHeader 
        showJumpButton={showJumpButton} 
        collapsible={collapsible} 
        accentColor={accentColor} 
    />

    <div class="toc-body">
        <nav class="toc-nav" aria-label="Table of contents">
            <ul class="toc-list">
                {groupedToc.map((group) => (
                    <TocItem item={group} isGroup={true} />
                ))}
            </ul>
        </nav>
    </div>
</div>

<style>
    .blog-toc {
        background: var(--bg-elevated);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        margin: var(--space-8) var(--space-0) var(--space-10);
        box-shadow: var(--shadow-sm);
        font-family: var(--font-body);
        position: relative;
        overflow: visible;
    }

    .toc-body {
        overflow: hidden;
        max-height: 16rem; /* Initial fallback, script will override */
    }

    .blog-toc:global(.toc-ready) .toc-body {
        transition: max-height var(--transition-base);
    }

    .toc-nav {
        padding: var(--space-0) var(--space-6) var(--space-4);
    }

    .toc-list {
        list-style: none;
        padding: var(--space-0);
        margin: var(--space-0);
        column-count: 2;
        column-gap: var(--space-8);
    }

    @media print {
        .blog-toc {
            border: 1px solid var(--border);
            background: var(--bg);
            box-shadow: none;
        }
        .toc-body {
            max-height: none !important;
        }
    }

    @media (max-width: 768px) {
        .toc-list {
            column-count: 1;
        }
        .blog-toc {
            margin: var(--space-5) var(--space-0);
        }
        .toc-nav {
            padding: var(--space-0) var(--space-3) var(--space-4);
        }
    }
</style>

<script>
    import { initToc } from "../../scripts/toc-controller";
    
    // Initialize TOC on page load and after swaps (Astro transitions)
    initToc();
    document.addEventListener("astro:after-swap", initToc);
</script>
