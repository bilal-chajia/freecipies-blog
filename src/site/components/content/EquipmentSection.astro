---
/**
 * EquipmentSection — Premium equipment display for recipes.
 * Uses recipe_json.equipment[] as the source for manual and catalog equipment.
 */
import { resolveVariantUrl } from "@shared/types/images";

interface RecipeEquipmentSnapshot {
  slug?: string;
  name?: string;
  brand?: string | null;
  description?: string | null;
  category?: string | null;
  image?: {
    // `source` discriminates an owned R2 media snapshot from an external
    // affiliate product image (e.g. Amazon). See IMAGE_JSON_CONTRACT.md.
    source?: "media" | "external";
    alt?: string;
    // external affiliate image
    url?: string;
    width?: number;
    height?: number;
    // media snapshot
    media_id?: number;
    variants?: {
      xs?: { r2_key?: string; url?: string; width?: number; height?: number };
      sm?: { r2_key?: string; url?: string; width?: number; height?: number };
    };
  } | null;
  affiliate_url?: string | null;
  affiliate_provider?: string | null;
  affiliate_note?: string | null;
}

interface RecipeEquipmentItem {
  id?: string;
  equipment_id?: number | null;
  label?: string;
  required?: boolean;
  notes?: string | null;
  source_type: "catalog" | "manual";
  snapshot?: RecipeEquipmentSnapshot | null;
}

interface Props {
  equipment: RecipeEquipmentItem[];
}

const { equipment = [] } = Astro.props;
if (equipment.length === 0) return;

// Category icon mapping
const categoryIcons: Record<string, string> = {
  appliances: "M13 2v2M6 8h12l-1 10H7L6 8z M10 12v4 M14 12v4",
  cookware:
    "M3 13h18v2a4 4 0 01-4 4H7a4 4 0 01-4-4v-2zM5 13V8a2 2 0 012-2h10a2 2 0 012 2v5M21 13h1",
  bakeware:
    "M4 15s1-1 4-1 4 2 8 1 4-1 4-1v4H4v-4zM4 7h16a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V8a1 1 0 011-1z",
  tools:
    "M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z",
  other: "M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5",
};
---

<section class="equipment-section" aria-label="Equipment needed">
  <div class="section-heading-group">
    <span class="section-heading-icon">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
        ></path>
      </svg>
    </span>
    <h2 class="section-heading">Equipment You'll Need</h2>
    <span class="equipment-count"
      >{equipment.length} {equipment.length === 1 ? "item" : "items"}</span
    >
  </div>

  <div class="equipment-grid">
    {
      equipment.map((item) => {
        const snapshot = item.snapshot;
        const img = snapshot?.image;
        const isExternalImage = img?.source === "external";
        const imageVariant = img?.variants?.sm || img?.variants?.xs;
        const image_url = isExternalImage
          ? (img?.url ?? null)
          : resolveVariantUrl(imageVariant);
        const imageWidth = (isExternalImage ? img?.width : imageVariant?.width) || 720;
        const imageHeight = (isExternalImage ? img?.height : imageVariant?.height) || 480;
        const name = snapshot?.name || item.label || "Equipment";
        const required = item.required !== false;
        const category = snapshot?.category || "other";
        const iconPath =
          categoryIcons[category] || categoryIcons.other;
        return (
          <div
            class:list={[
              "equipment-card",
              { "has-image": !!image_url, "is-optional": !required },
            ]}
          >
            {/* Product Image */}
            {image_url ? (
              <div class="card-image">
                <img
                  src={image_url}
                  alt={snapshot?.image?.alt || name}
                  width={imageWidth}
                  height={imageHeight}
                  loading="lazy"
                  decoding="async"
                />
                {snapshot?.category && (
                  <span class="category-badge" data-category={snapshot.category}>
                    {snapshot.category}
                  </span>
                )}
              </div>
            ) : (
              <div class="card-icon-placeholder">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={iconPath} />
                </svg>
                {snapshot?.category && (
                  <span class="category-badge" data-category={snapshot.category}>
                    {snapshot.category}
                  </span>
                )}
              </div>
            )}

            {/* Card Content */}
            <div class="card-body">
              <div class="card-title-row">
                <p class="item-name">{name}</p>
                {!required && <span class="optional-pill">optional</span>}
              </div>

              {snapshot?.brand && <span class="brand-name">by {snapshot.brand}</span>}

              {snapshot?.description && (
                <p class="item-description">{snapshot.description}</p>
              )}
              {item.notes && (
                <p class="item-description">{item.notes}</p>
              )}

              {/* Affiliate CTA */}
              {snapshot?.affiliate_url && (
                <div class="card-footer">
                  <a
                    href={snapshot.affiliate_url}
                    target="_blank"
                    rel="noopener noreferrer sponsored"
                    class="affiliate-cta"
                  >
                    {snapshot.affiliate_provider
                      ? `View on ${snapshot.affiliate_provider}`
                      : "View product"}
                    <svg
                      class="cta-arrow"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  </a>
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>

  {/* Affiliate Disclaimer */}
  {
    equipment.some((e) => e.snapshot?.affiliate_url) && (
      <p class="affiliate-disclaimer">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <>
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4M12 8h.01" />
          </>
        </svg>
        Some links may be affiliate links. We may earn a small commission at no
        extra cost to you.
      </p>
    )
  }
</section>

<style>
  /* ===== Container ===== */
  .equipment-section {
    --space-0-5: 0.125rem;
    --space-1-5: 0.375rem;
    --space-2-5: 0.625rem;
    --space-3-5: 0.875rem;
    margin: var(--space-10) var(--space-0);
    padding: var(--space-0);
  }

  /* ===== Header ===== */
  .section-heading-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    padding: var(--space-0) var(--space-0) var(--space-3);
    background: transparent;
    border-left: var(--space-0);
    border-bottom: 1px solid var(--border);
    border-radius: var(--space-0);
    position: relative;
  }

  @container (min-width: 0px) {
  } /* fallback if no container query */

  .section-heading-group .section-heading {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    color: var(--text);
    margin: var(--space-0);
    position: relative;
    letter-spacing: 0;
  }

  .section-heading-group .section-heading::after {
    display: none;
  }

  .section-heading-icon {
    width: var(--space-9);
    height: var(--space-9);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    background: var(--bg-inset);
    border-radius: var(--radius-sm);
    color: var(--brand-primary);
    flex-shrink: 0;
  }

  .section-heading-icon svg {
    width: var(--space-5);
    height: var(--space-5);
  }

  .equipment-count {
    min-height: var(--space-8);
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    margin-left: auto;
  }

  /* ===== Grid ===== */
  .equipment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
    gap: clamp(var(--space-2), 1.5vw, var(--space-3));
  }

  /* ===== Card ===== */
  .equipment-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  .equipment-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .equipment-card.is-optional {
    opacity: 0.85;
  }

  /* ===== Image / Icon Placeholder ===== */
  .card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 3/2;
    overflow: hidden;
    background: var(--bg-subtle, var(--neutral-25));
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }
  .equipment-card:hover .card-image img {
    transform: scale(1.04);
  }

  .card-icon-placeholder {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 2/1;
    background: linear-gradient(
      135deg,
      var(--neutral-50) 0%,
      var(--neutral-100) 100%
    );
  }
  .card-icon-placeholder svg {
    width: var(--space-7);
    height: var(--space-7);
    color: var(--text-tertiary);
    opacity: 0.5;
  }

  /* ===== Category Badge ===== */
  .category-badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: var(--space-0-5) var(--space-2);
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--text-inverse) 90%, transparent);
    color: var(--text-secondary);
    backdrop-filter: blur(4px);
  }
  .category-badge[data-category="appliances"] {
    color: var(--info-text);
  }
  .category-badge[data-category="cookware"] {
    color: var(--error-text);
  }
  .category-badge[data-category="bakeware"] {
    color: var(--warning-text);
  }
  .category-badge[data-category="tools"] {
    color: var(--success-text);
  }

  /* ===== Card Body ===== */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: clamp(var(--space-1-5), 1vw, var(--space-2)) clamp(var(--space-2), 1.5vw, var(--space-2-5)) clamp(var(--space-2), 1vw, var(--space-2-5));
    flex: 1;
  }

  .card-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .item-name {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    margin: var(--space-0);
    color: var(--text);
    line-height: var(--leading-tight);
  }
  .optional-pill {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1rem var(--space-1-5);
    border-radius: var(--radius-xs);
    background: var(--bg-inset);
    color: var(--text-tertiary);
    flex-shrink: 0;
  }

  .brand-name {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    font-weight: var(--font-medium);
  }

  .item-description {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
    margin: var(--space-1) var(--space-0) var(--space-0);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== Footer CTA ===== */
  .card-footer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2.5);
  }
  .affiliate-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--accent-sage-text);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-xs);
    border: 1px solid var(--accent-sage-text);
    transition: background-color var(--transition-fast), color var(--transition-fast), transform var(--transition-fast);
    white-space: nowrap;
  }
  .affiliate-cta:hover {
    background: var(--accent-sage-text);
    color: var(--accent-sage-contrast);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--accent-sage-shadow);
  }
  .cta-arrow {
    width: var(--space-3);
    height: var(--space-3);
    flex-shrink: 0;
  }

  /* ===== Disclaimer ===== */
  .affiliate-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
  }
  .affiliate-disclaimer svg {
    width: var(--space-3);
    height: var(--space-3);
    flex-shrink: 0;
    margin-top: var(--space-px);
  }

  /* ===== Dark Mode ===== */
  :global(.dark) .section-heading-group {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--brand-secondary) 10%, transparent) 0%,
      color-mix(in srgb, var(--brand-secondary) 5%, transparent) 100%
    );
  }
  :global(.dark) .section-heading {
    color: var(--text) !important;
  }
  :global(.dark) .equipment-count {
    background: var(--bg-elevated);
    color: var(--text-tertiary);
  }
  :global(.dark) .equipment-card {
    background: var(--bg-elevated);
    border-color: var(--border);
  }
  :global(.dark) .equipment-card:hover {
    box-shadow: var(--shadow-hover);
  }
  :global(.dark) .card-icon-placeholder {
    background: linear-gradient(135deg, var(--bg-inset) 0%, var(--bg-alt) 100%);
  }
  :global(.dark) .item-name {
    color: var(--text);
  }
  :global(.dark) .brand-name,
  :global(.dark) .item-description {
    color: var(--text-tertiary);
  }
  :global(.dark) .optional-pill {
    background: var(--bg-inset);
    color: var(--text-tertiary);
  }
  :global(.dark) .category-badge {
    background: color-mix(in srgb, var(--bg-inset) 90%, transparent);
  }
  :global(.dark) .affiliate-disclaimer {
    color: var(--text-tertiary);
  }
</style>
