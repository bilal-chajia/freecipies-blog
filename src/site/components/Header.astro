---
import MegaMenu from "./MegaMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";
import type { MenuItem } from "@modules/menus/types/menus.types";

const currentPath = Astro.url.pathname;
const logoMain = "/logos/logo-mobile.svg";
const logoDark = null;

interface Props {
  headerMenu?: MenuItem[];
}

const defaultHeaderMenu: MenuItem[] = [
  { id: "nav-1", label: "Categories", type: "link", target: { type: "internal_route", href: "/categories" }, is_enabled: true, visibility: "all", highlight: false },
  { id: "nav-2", label: "Recipes", type: "link", target: { type: "internal_route", href: "/recipes" }, is_enabled: true, visibility: "all", highlight: false },
  { id: "nav-3", label: "Bookmarks", type: "link", target: { type: "internal_route", href: "/my-bookmarks" }, is_enabled: true, visibility: "all", highlight: false },
  { id: "nav-4", label: "Authors", type: "link", target: { type: "internal_route", href: "/authors" }, is_enabled: true, visibility: "all", highlight: false },
  { id: "nav-5", label: "About", type: "link", target: { type: "internal_route", href: "/about" }, is_enabled: true, visibility: "all", highlight: false },
  { id: "nav-6", label: "Contact", type: "link", target: { type: "internal_route", href: "/contact" }, is_enabled: true, visibility: "all", highlight: false },
];

const { headerMenu = defaultHeaderMenu } = Astro.props as Props;
---

<header class="site-header">
  <a href="#main-content" class="skip-link">Skip to content</a>
  <div class="header-container">
    <div class="header-content">
      <!-- Logo -->
      <a href="/" class="logo">
        {
          logoMain ? (
            <>
              <img
                src={logoMain}
                alt="SaaS Blog"
                class="logo-img logo-light"
                width="200"
                height="60"
              />
              {logoDark ? (
                <img
                  src={logoDark}
                  alt="SaaS Blog"
                  class="logo-img logo-dark"
                  width="200"
                  height="60"
                />
              ) : (
                <img
                  src={logoMain}
                  alt="SaaS Blog"
                  class="logo-img logo-dark"
                  width="200"
                  height="60"
                />
              )}
            </>
          ) : (
            <span class="logo-text">SaaS Blog</span>
          )
        }
      </a>

      <!-- Desktop Navigation - Dynamic Mega Menu -->
      <MegaMenu items={headerMenu} currentPath={currentPath} />

      <!-- Search & Mobile Menu -->
      <div class="header-actions">
        <button
          class="search-btn"
          aria-label="Search"
          title="Quick and easy search"
          aria-controls="search-modal"
          aria-expanded="false"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </button>
        <ThemeToggle />
        <button
          class="mobile-menu-btn"
          aria-label="Show menu"
          aria-controls="mobile-nav"
          aria-expanded="false"
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <nav class="mobile-nav" id="mobile-nav">
    <a
      href="/categories"
      class="mobile-nav-link"
      aria-current={currentPath === "/categories" ? "page" : undefined}
      >Categories</a
    >
    <a
      href="/recipes"
      class="mobile-nav-link"
      aria-current={currentPath === "/recipes" ? "page" : undefined}>Explore</a
    >
    <a
      href="/my-bookmarks"
      class="mobile-nav-link"
      aria-current={currentPath === "/my-bookmarks" ? "page" : undefined}
      >Bookmarks</a
    >
    <a
      href="/authors"
      class="mobile-nav-link"
      aria-current={currentPath === "/authors" ? "page" : undefined}>Authors</a
    >
    <a
      href="/about"
      class="mobile-nav-link"
      aria-current={currentPath === "/about" ? "page" : undefined}>About</a
    >
    <a
      href="/contact"
      class="mobile-nav-link"
      aria-current={currentPath === "/contact" ? "page" : undefined}>Contact</a
    >
  </nav>
</header>

<!-- Search Modal -->
<div
  class="search-modal"
  id="search-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-title"
  aria-hidden="true"
>
  <div class="search-modal-content">
    <div class="search-modal-toolbar">
      <div class="search-header">
        <h2 id="search-title">Search recipes</h2>
        <button class="close-search" type="button" aria-label="Close search">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <form action="/recipes" method="GET" class="search-form">
        <svg
          class="search-input-icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          type="search"
          name="search"
          placeholder="Search recipes..."
          autocomplete="off"
          class="search-input"
          aria-label="Search recipes"
          aria-describedby="search-status"
        />
        <button type="submit" class="search-submit">View all</button>
      </form>
      <p id="search-status" class="visually-hidden" aria-live="polite"></p>
      <div class="search-results-summary" aria-hidden="true"></div>
    </div>
    <div id="search-results" class="search-modal-results"></div>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky, 100);
    will-change: transform;
    contain: layout style paint;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--border) 72%, transparent);
    backdrop-filter: blur(16px);
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: var(--space-2);
    background: var(--neutral-900);
    color: var(--text-inverse);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .skip-link:focus {
    left: var(--space-3);
    z-index: calc(var(--z-sticky, 100) + 1);
  }

  .header-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }

  .logo {
    text-decoration: none;
    margin-left: var(--space-2);
  }

  .logo-text {
    font-size: var(--text-2xl);
    font-weight: var(--font-extrabold);
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .logo-img {
    height: 52px;
    width: auto;
    object-fit: contain;
  }

  .logo-light {
    display: block;
  }

  .logo-dark {
    display: none;
  }

  html.dark .logo-light {
    display: none;
  }

  html.dark .logo-dark {
    display: block;
  }

  .desktop-nav {
    display: none;
    gap: var(--space-8);
    align-items: center;
  }

  .nav-link {
    color: var(--text);
    text-decoration: none;
    font-weight: var(--font-medium);
    font-size: var(--text-sm);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    background: var(--brand-primary-light);
    color: var(--brand-primary-hover);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .search-btn,
  .mobile-menu-btn {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-tertiary);
    cursor: pointer;
    width: var(--space-10);
    height: var(--space-10);
    padding: 0;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), color var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .search-btn:hover,
  .mobile-menu-btn:hover {
    background: var(--brand-primary-light);
    border-color: color-mix(in srgb, var(--brand-primary) 28%, var(--border));
    color: var(--text);
  }

  .mobile-menu-btn {
    display: flex;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border-top: 0;
    max-height: 0;
    opacity: 0;
    transform: translateY(-8px);
    overflow: hidden;
    transition:
      max-height var(--transition-slow),
      opacity var(--transition-base),
      transform var(--transition-slow);
  }

  .mobile-nav.active {
    max-height: 400px;
    opacity: 1;
    transform: translateY(0);
    border-top: 1px solid var(--border);
  }

  .mobile-nav-link {
    padding: var(--space-4) var(--space-6);
    color: var(--text);
    text-decoration: none;
    font-weight: var(--font-medium);
    border-bottom: 1px solid var(--border-subtle);
    transition:
      background var(--transition-fast),
      padding-left var(--transition-fast);
    min-height: 48px;
    display: flex;
    align-items: center;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:active {
    background: var(--bg-alt);
    padding-left: calc(var(--space-6) + var(--space-1));
  }

  .search-modal {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    background: var(--bg);
    display: none;
    z-index: var(--z-modal);
  }

  .search-modal.active {
    display: block;
  }

  .search-modal-content {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .search-modal-toolbar {
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    border-bottom: 1px solid var(--border);
    padding: var(--space-4);
  }

  .search-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--container-max);
    margin: 0 auto var(--space-4);
  }

  .search-header h2 {
    font-size: var(--text-2xl);
    line-height: 1.15;
    margin: 0;
    color: var(--text);
  }

  .close-search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-tertiary);
    cursor: pointer;
    padding: 0;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .close-search:hover,
  .close-search:focus-visible {
    background: var(--bg-hover);
    color: var(--text);
  }

  .search-form {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .search-input-icon {
    position: absolute;
    left: var(--space-5);
    color: var(--text-tertiary);
    pointer-events: none;
  }

  .search-input {
    min-width: 0;
    height: 58px;
    padding: 0 var(--space-5) 0 calc(var(--space-10) + var(--space-3));
    border: 1px solid var(--border);
    border-radius: var(--radius-full) 0 0 var(--radius-full);
    font-family: inherit;
    font-size: var(--text-lg);
    background: var(--bg);
    color: var(--text);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .search-input:focus-visible {
    outline: 2px solid transparent;
    outline-offset: 2px;
    border-color: var(--brand-secondary);
    box-shadow: var(--shadow-focus);
  }

  .search-submit {
    height: 58px;
    padding: 0 var(--space-6);
    background: var(--brand-primary);
    color: var(--text-inverse);
    border: 1px solid var(--brand-primary);
    border-radius: 0 var(--radius-full) var(--radius-full) 0;
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .search-submit:hover {
    background: var(--brand-primary-hover);
  }

  .search-results-summary {
    min-height: 24px;
    max-width: var(--container-max);
    margin: var(--space-3) auto 0;
    color: var(--text-tertiary);
    font-size: var(--text-sm);
  }

  .search-modal-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    align-content: start;
    gap: var(--space-5);
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-10);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  :global(html.search-open) {
    overflow: hidden;
  }

  :global(.search-result-card) {
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  :global(.search-result-card:hover),
  :global(.search-result-card:focus-visible) {
    border-color: color-mix(in srgb, var(--brand-primary) 36%, var(--border));
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    outline: none;
  }

  :global(.search-result-media) {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-alt);
  }

  :global(.search-result-media img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.search-result-placeholder) {
    width: 100%;
    height: 100%;
    background:
      linear-gradient(135deg, transparent 48%, var(--border-subtle) 49%, var(--border-subtle) 51%, transparent 52%),
      var(--bg-alt);
  }

  :global(.search-result-copy) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  :global(.search-result-category) {
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
  }

  :global(.search-result-title) {
    margin: 0;
    color: var(--text);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  :global(.search-state) {
    grid-column: 1 / -1;
    display: grid;
    place-items: center;
    min-height: 35vh;
    margin: 0;
    color: var(--text-tertiary);
    font-size: var(--text-base);
    text-align: center;
  }

  :global(.search-result-skeleton) {
    min-height: 270px;
    border-radius: var(--radius-lg);
    background:
      linear-gradient(
        100deg,
        transparent 20%,
        color-mix(in srgb, var(--bg-elevated) 55%, transparent) 45%,
        transparent 70%
      ),
      var(--bg-alt);
    background-size: 220% 100%;
    animation: search-loading 1.3s ease-in-out infinite;
  }

  @keyframes search-loading {
    to {
      background-position-x: -220%;
    }
  }

  @media (min-width: 768px) {
    .header-container {
      padding: 0 var(--space-6);
    }

    .logo {
      margin-left: var(--space-px);
    }

    .logo-img {
      height: 60px;
    }

    .desktop-nav {
      display: flex;
    }

    .mobile-menu-btn {
      display: none;
    }

    .mobile-nav {
      display: none;
    }

    .search-modal-toolbar {
      padding: var(--space-6);
    }

    .search-modal-results {
      padding: var(--space-8) var(--space-6) var(--space-12);
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .desktop-nav {
      gap: var(--space-2);
    }

    .nav-link {
      padding: calc((var(--space-1) + var(--space-2)) / 2) var(--space-2);
      font-size: var(--text-sm);
    }
  }

  @media (min-width: 1024px) and (max-width: 1200px) {
    .desktop-nav {
      gap: var(--space-4);
    }

    .nav-link {
      padding: calc((var(--space-1) + var(--space-2)) / 2) calc((var(--space-2) + var(--space-3)) / 2);
      font-size: var(--text-sm);
    }
  }
  @media (max-width: 768px) {
    .site-header {
      backdrop-filter: blur(8px);
    }

    .search-header h2 {
      font-size: var(--text-xl);
    }

    .search-input,
    .search-submit {
      height: 52px;
    }

    .search-input {
      font-size: var(--text-base);
    }

    .search-submit {
      padding: 0 var(--space-4);
    }

    .search-modal-results {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding-top: var(--space-4);
    }

    :global(.search-result-card) {
      grid-template-columns: 112px minmax(0, 1fr);
      grid-template-rows: 112px;
    }

    :global(.search-result-media) {
      aspect-ratio: auto;
      height: 112px;
    }

    :global(.search-result-copy) {
      justify-content: center;
      padding: var(--space-3);
    }

    :global(.search-result-title) {
      font-size: var(--text-base);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.search-result-card),
    :global(.search-result-skeleton) {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import {
    buildLiveRecipeSearchUrl,
    canApplyLiveRecipeSearchResponse,
    normalizeLiveRecipeSearch,
    type LiveRecipeSearchItem,
    type LiveRecipeSearchResponse,
  } from "@site/utils/live-recipe-search";

  // Mobile menu toggle
  const mobileMenuBtn = document.querySelector(".mobile-menu-btn");
  const mobileNav = document.querySelector("#mobile-nav");

  const toggleMobileNav = (forceState?: boolean) => {
    const isOpen =
      typeof forceState === "boolean"
        ? forceState
        : !mobileNav?.classList.contains("active");
    mobileNav?.classList.toggle("active", isOpen);
    mobileMenuBtn?.setAttribute("aria-expanded", String(isOpen));
  };

  mobileMenuBtn?.addEventListener("click", () => {
    toggleMobileNav();
  });

  // Search modal
  const searchBtn = document.querySelector(".search-btn");
  const searchModal = document.querySelector("#search-modal");
  const closeSearch = document.querySelector(".close-search");
  const searchInput = document.querySelector<HTMLInputElement>(".search-input");
  const searchResults = document.querySelector<HTMLElement>("#search-results");
  const searchStatus = document.querySelector<HTMLElement>("#search-status");
  const searchSummary = document.querySelector<HTMLElement>(".search-results-summary");
  let searchTimer: ReturnType<typeof setTimeout> | undefined;
  let searchController: AbortController | undefined;

  const setSearchStatus = (message: string) => {
    if (searchStatus) searchStatus.textContent = message;
  };

  const clearSearchResults = () => {
    searchResults?.replaceChildren();
    if (searchSummary) {
      searchSummary.textContent = "";
      searchSummary.setAttribute("aria-hidden", "true");
    }
  };

  const renderSearchState = (message: string) => {
    if (!searchResults) return;
    const state = document.createElement("p");
    state.className = "search-state";
    state.textContent = message;
    searchResults.replaceChildren(state);
  };

  const renderSearchLoading = () => {
    if (!searchResults) return;
    const fragment = document.createDocumentFragment();
    for (let index = 0; index < 8; index += 1) {
      const skeleton = document.createElement("div");
      skeleton.className = "search-result-skeleton";
      skeleton.setAttribute("aria-hidden", "true");
      fragment.append(skeleton);
    }
    searchResults.replaceChildren(fragment);
  };

  const createSearchResultCard = (item: LiveRecipeSearchItem) => {
    const card = document.createElement("a");
    card.className = "search-result-card";
    card.href = `/recipes/${encodeURIComponent(item.slug)}`;

    const media = document.createElement("div");
    media.className = "search-result-media";
    if (item.thumbnail?.url) {
      const image = document.createElement("img");
      image.src = item.thumbnail.url;
      image.alt = item.thumbnail.alt || item.headline;
      image.width = item.thumbnail.width;
      image.height = item.thumbnail.height;
      image.loading = "lazy";
      media.append(image);
    } else {
      const placeholder = document.createElement("div");
      placeholder.className = "search-result-placeholder";
      placeholder.setAttribute("aria-hidden", "true");
      media.append(placeholder);
    }

    const copy = document.createElement("div");
    copy.className = "search-result-copy";
    const categoryLabel = item.category?.label?.trim();
    if (categoryLabel) {
      const category = document.createElement("span");
      category.className = "search-result-category";
      category.textContent = categoryLabel;
      copy.append(category);
    }

    const title = document.createElement("h3");
    title.className = "search-result-title";
    title.textContent = item.headline;
    copy.append(title);
    card.append(media, copy);
    return card;
  };

  const renderSearchResults = (
    items: LiveRecipeSearchItem[],
    total: number,
    query: string,
  ) => {
    if (!searchResults || !searchSummary) return;
    if (items.length === 0) {
      renderSearchState(`No recipes found for "${query}".`);
      searchSummary.textContent = "";
      searchSummary.setAttribute("aria-hidden", "true");
      setSearchStatus(`No recipes found for ${query}.`);
      return;
    }

    const fragment = document.createDocumentFragment();
    items.forEach((item) => fragment.append(createSearchResultCard(item)));
    searchResults.replaceChildren(fragment);
    searchSummary.textContent = `${total} ${total === 1 ? "result" : "results"} for "${query}"`;
    searchSummary.setAttribute("aria-hidden", "false");
    setSearchStatus(`${total} ${total === 1 ? "result" : "results"} found.`);
  };

  const runLiveSearch = async (query: string) => {
    const requestUrl = buildLiveRecipeSearchUrl(query);
    if (!requestUrl) {
      clearSearchResults();
      setSearchStatus("");
      return;
    }

    searchController?.abort();
    searchController = new AbortController();
    const responseQuery = normalizeLiveRecipeSearch(query);
    renderSearchLoading();
    setSearchStatus(`Searching for ${responseQuery}.`);

    try {
      const response = await fetch(requestUrl, {
        signal: searchController.signal,
        headers: { Accept: "application/json" },
      });
      if (!response.ok) {
        throw new Error(`Search failed with status ${response.status}`);
      }

      const payload = await response.json() as LiveRecipeSearchResponse;
      if (!payload.success) {
        throw new Error("Search response was unsuccessful");
      }
      if (!canApplyLiveRecipeSearchResponse(responseQuery, searchInput?.value ?? "")) {
        return;
      }

      const items = payload.data?.items ?? [];
      const total = payload.data?.pagination?.total ?? items.length;
      renderSearchResults(items, total, responseQuery);
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
      if (!canApplyLiveRecipeSearchResponse(responseQuery, searchInput?.value ?? "")) {
        return;
      }
      renderSearchState("Search is temporarily unavailable. Please try again.");
      setSearchStatus("Search is temporarily unavailable.");
    }
  };

  searchInput?.addEventListener("input", () => {
    if (searchTimer) clearTimeout(searchTimer);
    searchController?.abort();
    const query = normalizeLiveRecipeSearch(searchInput.value);
    if (!query) {
      clearSearchResults();
      setSearchStatus("");
      return;
    }
    searchTimer = setTimeout(() => {
      void runLiveSearch(query);
    }, 200);
  });

  const openSearch = () => {
    searchModal?.classList.add("active");
    searchModal?.setAttribute("aria-hidden", "false");
    searchBtn?.setAttribute("aria-expanded", "true");
    document.documentElement.classList.add("search-open");
    searchInput?.focus();
  };

  const closeSearchModal = () => {
    if (searchTimer) clearTimeout(searchTimer);
    searchController?.abort();
    searchTimer = undefined;
    searchController = undefined;
    if (searchInput) searchInput.value = "";
    clearSearchResults();
    setSearchStatus("");
    searchModal?.classList.remove("active");
    searchModal?.setAttribute("aria-hidden", "true");
    searchBtn?.setAttribute("aria-expanded", "false");
    document.documentElement.classList.remove("search-open");
    searchBtn?.focus();
  };

  searchBtn?.addEventListener("click", () => {
    openSearch();
  });

  closeSearch?.addEventListener("click", () => {
    closeSearchModal();
  });

  searchResults?.addEventListener("click", (e) => {
    if (e.target === searchResults) {
      closeSearchModal();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && searchModal?.classList.contains("active")) {
      closeSearchModal();
      toggleMobileNav(false);
      return;
    }

    if (e.key === "Tab" && searchModal?.classList.contains("active")) {
      const focusable = Array.from(
        searchModal.querySelectorAll<HTMLElement>(
          'button:not([disabled]), input:not([disabled]), a[href]',
        ),
      );
      const first = focusable[0];
      const last = focusable.at(-1);
      if (!first || !last) return;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
