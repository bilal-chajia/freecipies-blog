---
/**
 * RecipePreviewCard - Simple recipe card for listing/grids
 * Shows: hero image, title, prep/cook time, category badge
 */

import type { Article } from "@modules/articles/schema/articles.schema";
import type { RecipeJson } from "@modules/articles/types/recipes.types";
import { extractImage, getImageSrcSet } from "@shared/utils";
import RatingSystem from "./content/RatingSystem";
import { parseCachedRecipe, parseCachedRating } from "@modules/articles/utils/cached-fields";


interface Props {
  article: Article;
  recipe_json: RecipeJson | null;
}

const { article, recipe_json } = Astro.props;

const heroImage = extractImage(article.images_json, "hero", 400);
const heroSlotSrcSet = getImageSrcSet(article.images_json, "hero");
const sizes = "(max-width: 768px) 100vw, 33vw";

const cachedRecipe = parseCachedRecipe(article.cached_recipe_json);
const cachedRating = parseCachedRating(article.cached_rating_json);

const prepTime = cachedRecipe?.prep_time_minutes ?? 0;
const cookTime = cachedRecipe?.cook_time_minutes ?? 0;
const totalTime = cachedRecipe?.total_time_minutes ?? (prepTime + cookTime);

function formatTime(minutes: number): string {
  if (!minutes) return "";
  if (minutes < 60) return `${minutes} min`;
  const hrs = Math.floor(minutes / 60);
  const mins = minutes % 60;
  return mins > 0 ? `${hrs}h ${mins}m` : `${hrs}h`;
}

// Parse category from cached data
const category = article.cached_category_json
  ? JSON.parse(article.cached_category_json)
  : null;
const categoryLabel = category?.label || "Recipe";
const categoryColor = category?.color || "#ff6b35";

// Parse author
const author = article.cached_author_json
  ? JSON.parse(article.cached_author_json)
  : null;
---

<article class="recipe-preview-card">
  <a href={`/recipes/${article.slug}`} class="card-link">
          <!-- Hero Image -->
    <div class="card-image">
      {
        heroImage.image_url ? (
          <img
            src={heroImage.image_url}
            alt={heroImage.imageAlt || article.headline}
            width={heroImage.imageWidth || 400}
            height={heroImage.imageHeight || 300}
            srcset={heroSlotSrcSet || undefined}
            sizes={heroSlotSrcSet ? sizes : undefined}
            loading="lazy"
            style={heroImage.imageStyle || undefined}
          />
        ) : (
          <div class="image-placeholder">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <polyline points="21 15 16 10 5 21" />
            </svg>
          </div>
        )
      }

      <!-- Category Badge -->
      {
        categoryLabel && (
          <span class="badge category-badge" style={`background: ${categoryColor};`}>
            {categoryLabel}
          </span>
        )
      }
    </div>

    <!-- Content -->
    <div class="card-content">
      <h3 class="card-title">{article.headline}</h3>

      <!-- Rating -->
      <RatingSystem
        client:load
        article_id={article.id}
        initialValue={cachedRating?.rating_value ?? 0}
        initialCount={cachedRating?.rating_count ?? 0}
        size="sm"
      />

      <!-- Meta Info -->
      <div class="card-meta">
        {
          totalTime > 0 && (
            <span class="meta-item">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              {formatTime(totalTime)}
            </span>
          )
        }
        {
          cachedRecipe?.servings && (
            <span class="meta-item">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
              {cachedRecipe.servings} servings
            </span>
          )
        }
      </div>

      <!-- Author (if available) -->
      {
        author?.name && (
          <div class="card-author">
            {author.avatar && (
              <img
                src={author.avatar}
                alt={author.name}
                class="author-avatar"
                width="20"
                height="20"
                loading="lazy"
              />
            )}
            <span>by {author.name}</span>
          </div>
        )
      }
    </div>
  </a>
</article>

<style>
  .recipe-preview-card {
    background: var(--bg-elevated);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid var(--border-subtle);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .recipe-preview-card:hover {
    transform: translateY(-6px);
    box-shadow:
      var(--shadow-hover);
    border-color: var(--brand-secondary-hover);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .card-image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--warning-bg);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .recipe-preview-card:hover .card-image img {
    transform: scale(1.05);
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-secondary);
    opacity: 0.4;
  }

  .category-badge {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    box-shadow: var(--shadow-sm);
  }

  .card-content {
    padding: var(--space-5);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .recipe-preview-card:hover .card-title {
    color: var(--brand-secondary);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: auto;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    font-weight: 500;
  }

  .card-author {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8125rem;
    color: var(--text-tertiary);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .author-avatar {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .card-content {
      padding: var(--space-4);
    }

    .card-title {
      font-size: 1rem;
    }

    .meta-item {
      font-size: 0.75rem;
    }
  }
</style>
