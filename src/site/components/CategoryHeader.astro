---
import type { HydratedCategory } from "@modules/categories";
import type { HydratedArticle } from "@modules/articles";
import { extractImage, getImageSrcSet } from "@shared/utils";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  category: HydratedCategory;
  featuredArticle?: HydratedArticle | null;
  headerStyle?: "hero" | "minimal" | "none";
  breadcrumbItems?: { label: string; href?: string }[];
}

const {
  category,
  featuredArticle = null,
  headerStyle = "hero",
  breadcrumbItems = [],
} = Astro.props;

const showHeader = headerStyle !== "none";
const isHeroHeader = headerStyle === "hero";
const isMinimalHeader = headerStyle === "minimal";
const showBreadcrumb = breadcrumbItems.length > 0;
const hasFeatured = Boolean(featuredArticle && isHeroHeader);
const showHeroCta = category.show_hero_cta !== false;
const heroCtaText =
  typeof category.hero_cta_text === "string" && category.hero_cta_text.trim()
    ? category.hero_cta_text.trim()
    : "Join My Mailing List";
const heroCtaLink =
  typeof category.hero_cta_link === "string" && category.hero_cta_link.trim()
    ? category.hero_cta_link.trim()
    : "#newsletter";
const getFeaturedImage = (article: HydratedArticle) => {
  const hero = extractImage(article.images_json, "hero", 1200);
  const thumbnail = extractImage(article.images_json, "thumbnail", 1200);
  const slotName = hero.image_url ? "hero" : "thumbnail";
  const selected = hero.image_url ? hero : thumbnail;
  const srcSet = getImageSrcSet(article.images_json, slotName);
  return { selected, srcSet };
};

const featuredImage = featuredArticle
  ? getFeaturedImage(featuredArticle)
  : null;
const featuredSizes = "(max-width: 1024px) 100vw, 40vw";
const featuredAuthorName =
  featuredArticle?.authorName || featuredArticle?.authorSlug || "Unknown";
const featuredAuthorSlot = featuredArticle?.authorImagesJson
  ? extractImage(featuredArticle.authorImagesJson, "avatar", 50)
  : {};
const featuredAuthorAvatar =
  featuredAuthorSlot.image_url || featuredArticle?.authorAvatar;
---

{
  showHeader && (
    <section
      class:list={[
        "category-hero",
        { "is-minimal": isMinimalHeader, "has-featured": hasFeatured },
      ]}
    >
      <div class="hero-grid">
        {hasFeatured && featuredArticle && featuredImage && (
          <a href={`/recipes/${featuredArticle.slug}`} class="featured-card">
            <div class="featured-image">
              {(featuredImage.selected.image_url ||
                featuredArticle.image_url) && (
                <img
                  src={
                    featuredImage.selected.image_url ||
                    featuredArticle.image_url
                  }
                  alt={
                    featuredImage.selected.imageAlt ||
                    featuredArticle.imageAlt ||
                    featuredArticle.label
                  }
                  width={
                    featuredImage.selected.imageWidth ||
                    featuredArticle.imageWidth ||
                    1200
                  }
                  height={
                    featuredImage.selected.imageHeight ||
                    featuredArticle.imageHeight ||
                    900
                  }
                  srcset={featuredImage.srcSet || undefined}
                  sizes={featuredImage.srcSet ? featuredSizes : undefined}
                  loading="eager"
                  class="featured-hero-image"
                  style={featuredImage.selected.imageStyle || undefined}
                />
              )}
              <span class="featured-badge">Featured</span>
            </div>
            <div class="featured-body">
              <span class="featured-eyebrow">Featured Recipe</span>
              <h2 class="featured-title">{featuredArticle.label}</h2>
              {featuredArticle.short_description && (
                <p class="featured-description">
                  {featuredArticle.short_description}
                </p>
              )}
              <div class="featured-meta">
                <div class="featured-meta-left">
                  {featuredAuthorAvatar ? (
                    <img
                      src={featuredAuthorAvatar}
                      alt={featuredAuthorName}
                      width="28"
                      height="28"
                      class="featured-avatar"
                      loading="lazy"
                      style={featuredAuthorSlot.imageStyle || undefined}
                    />
                  ) : (
                    <span class="featured-avatar placeholder">
                      {featuredAuthorName.charAt(0)}
                    </span>
                  )}
                  <span class="featured-author">{featuredAuthorName}</span>
                  <span class="featured-separator">|</span>
                  <span class="featured-date">
                    <FormattedDate
                      date={
                        featuredArticle.published_at ||
                        featuredArticle.created_at ||
                        undefined
                      }
                    />
                  </span>
                </div>
                <button
                  type="button"
                  class="featured-bookmark"
                  data-bookmark-button
                  data-bookmark-slug={featuredArticle.slug}
                  aria-pressed="false"
                  aria-label="Bookmark recipe"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M6 4a2 2 0 012-2h8a2 2 0 012 2v18l-6-4-6 4V4z"
                    />
                  </svg>
                </button>
              </div>
              <span class="featured-link">
                View Recipe
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </span>
            </div>
          </a>
        )}
        <div class="hero-panel">
        {showBreadcrumb && (
          <nav class="hero-breadcrumb" aria-label="Breadcrumb">
            <ol class="hero-breadcrumb-list">
              <li class="hero-breadcrumb-item">
                <a href="/" class="hero-breadcrumb-link" aria-label="Home">
                  <svg
                    class="hero-breadcrumb-home"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                    />
                  </svg>
                </a>
              </li>
              {breadcrumbItems.map((item, index) => (
                <li class="hero-breadcrumb-item">
                  <svg
                    class="hero-breadcrumb-separator"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                  {item.href && index < breadcrumbItems.length - 1 ? (
                    <a href={item.href} class="hero-breadcrumb-link">
                      {item.label}
                    </a>
                  ) : (
                    <span class="hero-breadcrumb-current" aria-current="page">
                      {item.label}
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}
        <h1 class="category-title">{category.headline || category.label}</h1>
        {isHeroHeader && <div class="title-rule" aria-hidden="true" />}
        <p class="category-description">
          {category.short_description || category.headline}
        </p>
        {category.tldr && <p class="category-tldr">{category.tldr}</p>}
        {isHeroHeader && showHeroCta && (
          <a href={heroCtaLink} class="cta-button">
            {heroCtaText}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        )}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Pinch-of-Yum-style hero: featured recipe card on the left half,
     category title/description/CTA on the right. */
  .category-hero {
    background: var(--bg-alt);
    position: relative;
  }

  .category-hero.is-minimal {
    background: var(--bg-elevated);
  }

  .hero-grid {
    max-width: var(--container-max);
    margin: 0 auto;
    width: 100%;
    padding: clamp(1.25rem, 2.5vw, 2rem) clamp(1.25rem, 4vw, 2rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: stretch;
  }

  @media (min-width: 1024px) {
    .category-hero.has-featured .hero-grid {
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    }

    /* Category info reads left, featured card sits right. */
    .category-hero.has-featured .featured-card {
      order: 2;
    }
  }

  .hero-panel {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    text-align: left;
    animation: heroFadeUp 0.7s ease both;
  }

  /* Title block reads first on mobile, featured card follows. */
  @media (max-width: 1023.98px) {
    .category-hero.has-featured .hero-panel {
      order: -1;
    }
  }

  .category-hero.is-minimal .hero-grid {
    padding: 2rem clamp(1rem, 3vw, 2rem) 1rem;
  }

  .category-hero.is-minimal .hero-panel {
    align-items: flex-start;
    text-align: left;
  }

  .hero-breadcrumb {
    margin-bottom: 1.5rem;
  }

  .hero-breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-breadcrumb-link,
  .hero-breadcrumb-current {
    color: var(--text-tertiary);
    text-decoration: none;
    font-weight: 600;
  }

  .hero-breadcrumb-link:hover {
    color: var(--text-brand);
  }

  .hero-breadcrumb-current {
    color: var(--text-secondary);
  }

  .hero-breadcrumb-separator,
  .hero-breadcrumb-home {
    width: 16px;
    height: 16px;
    color: var(--text-tertiary);
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .category-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0;
  }

  .title-rule {
    width: 64px;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--brand-gradient);
    margin: 1.25rem 0 1.5rem;
  }

  .category-hero.is-minimal .category-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin-bottom: 0.75rem;
  }

  .category-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 58ch;
    margin: 0;
  }

  .category-tldr {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-tertiary);
    max-width: 46ch;
    margin: 1rem 0 0;
    padding-left: 1rem;
    border-left: 3px solid var(--border-strong);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--brand-secondary-accessible);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    margin-top: 1.5rem;
  }

  .cta-button svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .cta-button:hover {
    color: var(--brand-secondary-accessible-hover);
  }

  .cta-button:hover svg {
    transform: translateX(4px);
  }

  .cta-button:focus-visible {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 3px;
  }

  /* Pin the CTA to the card's bottom edge on desktop. */
  @media (min-width: 1024px) {
    .category-hero.has-featured .cta-button {
      margin-top: auto;
      padding-top: 1.5rem;
    }
  }

  /* ---- Featured recipe card (right half of the hero, image left / text right) ---- */
  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    text-decoration: none;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-lg);
    animation: heroFadeUp 0.8s ease both;
    animation-delay: 0.1s;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  @media (min-width: 640px) {
    .featured-card {
      grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    }
  }

  .featured-image {
    position: relative;
    aspect-ratio: 16/9;
    background: var(--bg-inset);
  }

  @media (min-width: 640px) {
    .featured-image {
      aspect-ratio: auto;
      min-height: 220px;
      height: 100%;
    }
  }

  .featured-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--brand-secondary-accessible);
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.375rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--brand-secondary-accessible);
  }

  .featured-link svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .featured-card:hover .featured-link svg {
    transform: translateX(4px);
  }

  .featured-hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .featured-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 1;
    background: var(--brand-gradient);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-xs);
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  .featured-title {
    color: var(--text);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .featured-card:hover .featured-title {
    color: var(--text-brand);
  }

  .featured-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
    max-width: 60ch;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-meta {
    margin-top: 0.375rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }

  .featured-meta-left {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-tertiary);
    font-size: 0.85rem;
    flex-wrap: wrap;
  }

  .featured-avatar {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 2px solid var(--border);
  }

  .featured-avatar.placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--bg-inset);
    color: var(--text-secondary);
    border: 2px solid var(--border);
  }

  .featured-author {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .featured-separator {
    color: var(--border-strong);
  }

  .featured-bookmark {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .featured-bookmark:hover {
    color: var(--text-brand);
    border-color: var(--text-brand);
  }

  .featured-bookmark svg {
    width: 18px;
    height: 18px;
  }

  .featured-bookmark[data-bookmarked="true"] {
    background: var(--brand-primary-light);
    color: var(--brand-primary);
    border-color: var(--brand-primary);
  }

  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-panel,
    .featured-card {
      animation: none;
    }
  }
</style>
