---
import type { HydratedCategory } from "@modules/categories";
import { extractImage, getImageSrcSet } from "@shared/utils";

interface Props {
  category: HydratedCategory;
}

const { category } = Astro.props;

const hero = extractImage(category.images_json, "hero", 1200);
const thumbnail = extractImage(category.images_json, "thumbnail", 720);
const slotName = hero.image_url ? "hero" : "thumbnail";
const selected = hero.image_url ? hero : thumbnail;
const srcSet = getImageSrcSet(category.images_json, slotName);
const image = {
  url:
    selected.image_url ||
    category.image_url ||
    "https://images.unsplash.com/photo-1556910103-1c02745a30bf?w=800&q=80",
  alt: selected.imageAlt || category.imageAlt || category.label,
  width: selected.imageWidth || category.imageWidth || 800,
  height: selected.imageHeight || category.imageHeight || 600,
  style: selected.imageStyle,
};
---

<article
  class="category-card"
  style={`--category-color: ${category.color || "var(--brand-accent)"};`}
>
  <a href={`/categories/${category.slug}`} class="card-link">
    <div class="card-image">
      <img
        src={image.url}
        alt={image.alt}
        width={image.width}
        height={image.height}
        srcset={srcSet || undefined}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
        loading="lazy"
        style={image.style || undefined}
      />
      <div class="card-overlay"></div>
    </div>

    {/* Badge - Top Right */}
    {
      category.is_featured && (
        <span class="card-badge">
          <svg viewBox="0 0 20 20" fill="currentColor">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          Popular
        </span>
      )
    }

    {/* Content - Bottom Left */}
    <div class="card-content">
      <h3 class="card-title" style={`color: ${category.color || "var(--text-inverse)"};`}>
        {category.label}
      </h3>
      <p class="card-description">
        {category.short_description}
      </p>
    </div>

    {/* CTA Button - Bottom Right */}
    <span class="card-cta">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </span>
  </a>
</article>

<style>
  .category-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-alt);
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-slow), box-shadow var(--transition-slow);
  }

  .category-card:hover {
    transform: translateY(-8px);
    box-shadow:
      var(--shadow-hover),
      0 0 30px color-mix(in srgb, var(--category-color) 40%, transparent);
  }

  .card-link {
    display: block;
    position: relative;
    aspect-ratio: 4 / 3;
    text-decoration: none;
  }

  .card-image {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .category-card:hover .card-image img {
    transform: scale(1.1);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.5) 40%,
      rgba(0, 0, 0, 0.2) 100%
    );
    transition: opacity var(--transition-slow);
  }

  .category-card:hover .card-overlay {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.9) 0%,
      rgba(0, 0, 0, 0.6) 50%,
      rgba(0, 0, 0, 0.3) 100%
    );
  }

  .card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-4) var(--space-16) var(--space-4) var(--space-5);
    color: var(--text-inverse);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 5rem;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.6) 60%,
      transparent 100%
    );
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  .card-badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: var(--brand-gradient);
    color: var(--text-inverse);
    padding: var(--space-1) var(--space-2.5);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    box-shadow: var(--shadow-sm);
    z-index: 10;
  }

  .card-badge svg {
    width: 10px;
    height: 10px;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    margin: 0 0 var(--space-2) 0;
    text-shadow:
      0 2px 4px rgba(0, 0, 0, 0.8),
      0 4px 12px rgba(0, 0, 0, 0.6),
      0 0 20px rgba(0, 0, 0, 0.4);
    -webkit-text-stroke: 0.5px rgba(0, 0, 0, 0.3);
    line-height: var(--leading-tight);
    transition: transform var(--transition-slow), box-shadow var(--transition-slow);
    position: relative;
  }

  .category-card:hover .card-title {
    transform: translateY(-4px);
    text-shadow:
      0 4px 16px rgba(0, 0, 0, 0.6),
      0 0 30px currentColor;
  }

  .card-description {
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--text-inverse) 85%, transparent);
    margin: 0;
    line-height: var(--leading-normal);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.625rem; /* 2 lines * 1.5 line-height * 0.875rem */
  }

  .card-cta {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-9);
    height: var(--space-9);
    color: var(--text-inverse);
    background: var(--category-color);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    z-index: 10;
  }

  .card-cta svg {
    width: 16px;
    height: 16px;
    transition: transform var(--transition-base);
  }

  .category-card:hover .card-cta {
    filter: brightness(0.9);
    transform: scale(1.1);
  }

  .category-card:hover .card-cta svg {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .card-content {
      padding: var(--space-5);
    }

    .card-title {
      font-size: var(--text-xl);
    }

    .card-description {
      -webkit-line-clamp: 1;
    }
  }
</style>