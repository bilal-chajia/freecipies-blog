---
import type { ImageVariants, ImageSlot } from "@shared/types/images";
import { getBestVariantUrl, getSrcSet } from "@shared/types/images";

type BeforeAfterImage = {
  mediaId: number;
  image_url?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageStyle?: string;
  variants?: ImageVariants;
  label?: string;
};

const { block } = Astro.props as {
  block: {
    type: "before_after";
    layout?: "slider" | "side_by_side";
    before: BeforeAfterImage;
    after: BeforeAfterImage;
  };
};

const layout = block.layout || "slider";
const before = block.before;
const after = block.after;
const beforeUrl = before?.variants
  ? getBestVariantUrl(before as ImageSlot)
  : null;
const afterUrl = after?.variants ? getBestVariantUrl(after as ImageSlot) : null;
const beforeSrcSet = before?.variants ? getSrcSet(before as ImageSlot) : "";
const afterSrcSet = after?.variants ? getSrcSet(after as ImageSlot) : "";
const beforeLabel = before?.label || "Before";
const afterLabel = after?.label || "After";
const pickVariant = (image?: BeforeAfterImage) => {
  if (!image?.variants) return null;
  return (
    image.variants.lg ||
    image.variants.md ||
    image.variants.sm ||
    image.variants.xs ||
    image.variants.original ||
    null
  );
};
const baseVariant = pickVariant(after) || pickVariant(before);
const aspectRatio =
  baseVariant?.width && baseVariant?.height
    ? `${baseVariant.width} / ${baseVariant.height}`
    : "16 / 9";
---

{
  before && after && (
    <section
      class:list={["before-after", `layout-${layout}`]}
      data-before-after
      style={`--ba-aspect: ${aspectRatio};`}
    >
      {layout === "side_by_side" ? (
        <div class="ba-grid">
          <figure>
            {beforeUrl ? (
              <img
                src={beforeUrl}
                alt={before.imageAlt || ""}
                srcset={beforeSrcSet || undefined}
                sizes="(max-width: 768px) 100vw, 50vw"
                width={baseVariant?.width || 720}
                height={baseVariant?.height || 405}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="ba-placeholder" />
            )}
            <figcaption>{beforeLabel}</figcaption>
          </figure>
          <figure>
            {afterUrl ? (
              <img
                src={afterUrl}
                alt={after.imageAlt || ""}
                srcset={afterSrcSet || undefined}
                sizes="(max-width: 768px) 100vw, 50vw"
                width={baseVariant?.width || 720}
                height={baseVariant?.height || 405}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="ba-placeholder" />
            )}
            <figcaption>{afterLabel}</figcaption>
          </figure>
        </div>
      ) : (
        <div class="ba-slider">
          <div class="ba-images">
            {afterUrl ? (
              <img
                class="ba-image"
                src={afterUrl}
                alt={after.imageAlt || ""}
                srcset={afterSrcSet || undefined}
                sizes="(max-width: 768px) 100vw, 720px"
                width={baseVariant?.width || 720}
                height={baseVariant?.height || 405}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="ba-placeholder" />
            )}
            <div class="ba-before">
              {beforeUrl ? (
                <img
                  class="ba-image"
                  src={beforeUrl}
                  alt={before.imageAlt || ""}
                  srcset={beforeSrcSet || undefined}
                  sizes="(max-width: 768px) 100vw, 720px"
                  width={baseVariant?.width || 720}
                  height={baseVariant?.height || 405}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="ba-placeholder" />
              )}
            </div>
            <div class="ba-handle" aria-hidden="true">
              <div class="ba-handle-knob" />
            </div>
          </div>
          <div class="ba-labels">
            <span>{beforeLabel}</span>
            <span>{afterLabel}</span>
          </div>
        </div>
      )}
    </section>
  )
}

<script>
  document.querySelectorAll("[data-before-after]").forEach((elContainer) => {
    const el = elContainer as HTMLElement;
    const images = el.querySelector(".ba-images") as HTMLElement;
    if (!images) return;
    let isDragging = false;

    const setPosition = (clientX: number) => {
      const rect = images.getBoundingClientRect();
      const raw = ((clientX - rect.left) / rect.width) * 100;
      const clamped = Math.min(100, Math.max(0, raw));
      el.style.setProperty("--ba-position", `${clamped}%`);
    };

    const onPointerMove = (event: PointerEvent) => {
      if (event.pointerType === "mouse" || isDragging) {
        setPosition(event.clientX);
      }
    };

    images.addEventListener("pointerdown", (event: PointerEvent) => {
      isDragging = true;
      images.setPointerCapture?.(event.pointerId);
      setPosition(event.clientX);
    });

    images.addEventListener("pointermove", onPointerMove as EventListener);

    images.addEventListener("pointerleave", () => {
      if (!isDragging) return;
      isDragging = false;
    });

    window.addEventListener("pointerup", () => {
      isDragging = false;
    });
  });
</script>

<style>
  .before-after {
    margin: var(--space-6) 0;
    --ba-position: 50%;
  }

  .ba-grid {
    display: grid;
    gap: var(--space-4);
  }

  .ba-grid figure {
    margin: 0;
  }

  .ba-grid img {
    width: 100%;
    display: block;
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  .ba-grid figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
  }

  .ba-slider {
    position: relative;
  }

  .ba-images {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-inset);
    aspect-ratio: var(--ba-aspect, 16 / 9);
    cursor: ew-resize;
    user-select: none;
  }

  .ba-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ba-before {
    position: absolute;
    inset: 0;
    width: 100%;
    overflow: hidden;
    height: 100%;
    clip-path: inset(0 calc(100% - var(--ba-position)) 0 0);
  }

  .ba-handle {
    position: absolute;
    top: 0;
    left: var(--ba-position);
    width: 2px;
    height: 100%;
    background: var(--info);
    transform: translateX(-1px);
    box-shadow: 0 0 0 2px var(--brand-secondary-accessible-shadow);
    pointer-events: none;
  }

  .ba-handle-knob {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--space-9);
    height: var(--space-9);
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    border: 2px solid var(--info);
    transform: translate(-50%, -50%);
    box-shadow: var(--shadow-sm);
  }

  .ba-handle-knob::before,
  .ba-handle-knob::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 0;
    height: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    transform: translateY(-50%);
  }

  .ba-handle-knob::before {
    left: 7px;
    border-right: 7px solid var(--info);
  }

  .ba-handle-knob::after {
    right: 7px;
    border-left: 7px solid var(--info);
  }

  .ba-labels {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    margin-top: var(--space-1);
  }

  .ba-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--bg-inset), var(--bg-hover));
  }

  @media (min-width: 768px) {
    .ba-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
