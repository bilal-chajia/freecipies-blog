---
import type { HydratedArticle } from "@modules/articles";
import ArticleCard from "./ArticleCard.astro";

interface Props {
  articles: HydratedArticle[];
  layoutMode?: "grid" | "list" | "masonry";
  cardStyle?: "full" | "compact" | "minimal";
}

const { articles, layoutMode = "grid", cardStyle = "full" } = Astro.props;

const layoutClass =
  layoutMode === "list"
    ? "recipe-list"
    : layoutMode === "masonry"
      ? "recipe-masonry"
      : "recipe-grid";
---

<div
  class:list={[
    layoutClass,
    `card-style-${cardStyle}`,
    "article-grid-container",
  ]}
>
  {
    articles.map((article, index) => (
      <ArticleCard
        article={article}
        cardStyle={cardStyle}
        layoutMode={layoutMode}
        loading={index === 0 ? "eager" : "lazy"}
      />
    ))
  }
</div>

<style>
  /* Grid Layout (default) */
  .recipe-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2vw, 2rem);
  }

  /* NOTE: We use @media (not @container) because .recipe-grid IS the
     container element (.article-grid-container). CSS container queries
     cannot style the container itself — only descendants. */
  @media (min-width: 640px) {
    .recipe-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .recipe-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* List Layout */
  .recipe-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .recipe-list {
      gap: 2rem;
    }
  }

  /* Masonry Layout */
  .recipe-masonry {
    columns: 1;
    column-gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .recipe-masonry {
      columns: 2;
    }
  }

  @media (min-width: 900px) {
    .recipe-masonry {
      columns: 3;
    }
  }

  .recipe-masonry :global(article) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  /* Grid with featured first item */
  .recipe-grid:has(> :first-child.is-featured) {
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .recipe-grid:has(> :first-child.is-featured) {
      grid-template-columns: 2fr 1fr;
      grid-template-rows: repeat(2, 1fr);
    }

    .recipe-grid:has(> :first-child.is-featured) > :first-child {
      grid-row: 1 / -1;
    }
  }
</style>
