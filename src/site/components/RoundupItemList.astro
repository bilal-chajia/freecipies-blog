---
import type {
  RoundupJson,
} from "@modules/articles/types/roundups.types";
import type { MainRoundupBlock } from '@modules/content-blocks/contract/content-blocks.types';
import {
  extractImage,
  getImageSrcSet,
} from "@shared/utils/hydration";
import { resolveRoundupBadges } from "@modules/articles/utils/roundup-badges";
import AuthorBadge from "./AuthorBadge.astro";

type RoundupItem = NonNullable<RoundupJson["items"]>[number];

interface Props {
  roundup?: RoundupJson | string | null;
  block?: MainRoundupBlock;
  roundup_json?: RoundupJson | string | null;
  startNumber?: number;
}

const {
  roundup: rawRoundupProp,
  block,
  roundup_json: rawRoundupJson,
  startNumber = 1,
} = Astro.props;

// Both entry points (in-body main_roundup marker, standalone roundup) carry the
// same roundup_json shape. Pick whichever prop was supplied and parse once.
const rawRoundup =
  block?.type === "main_roundup" ? rawRoundupJson : rawRoundupProp;
const isRoundupJson = (value: unknown): value is RoundupJson =>
  typeof value === 'object' && value !== null && !Array.isArray(value) &&
  (value as { list_type?: unknown }).list_type === 'ItemList' &&
  Array.isArray((value as { items?: unknown }).items);
const parsedRoundup = typeof rawRoundup === 'string'
  ? (() => {
      try {
        return JSON.parse(rawRoundup) as unknown;
      } catch {
        return null;
      }
    })()
  : rawRoundup;
const roundup: RoundupJson = isRoundupJson(parsedRoundup)
  ? parsedRoundup
  : { list_type: "ItemList", items: [] };

const items: RoundupItem[] = [...(roundup.items || [])].sort(
  (a: RoundupItem, b: RoundupItem) => (a.position || 0) - (b.position || 0),
);
const groupTitle = roundup.group_title || "";
const groupDescription = roundup.group_description || "";
const showStats = roundup.show_stats !== false;
const visibleBadges = roundup.visible_badges;

if (!items || items.length === 0) return null;

const renderedItems = items.map((item, index) => {
  const isInternal = item.source_type !== "external_recipe";
  const position = startNumber + index;
  const href =
    isInternal && item.slug
      ? `/recipes/${item.slug}`
      : item.external_url || "#";
  const title = item.title || "Untitled";
  const subtitle = item.subtitle || item.description || "";
  const note = item.note || "";
  let imgData: {
    image_url?: string;
    imageAlt?: string;
    imageWidth?: number;
    imageHeight?: number;
    imageStyle?: string;
  } = {};
  let srcSet = "";

  if (item.image?.variants) {
    const slots = { thumbnail: item.image };
    imgData = extractImage(JSON.stringify(slots), "thumbnail", 800);
    srcSet = getImageSrcSet(JSON.stringify(slots), "thumbnail");
  }

  const allBadges = showStats ? resolveRoundupBadges(item, visibleBadges) : [];
  const ratingBadge = allBadges.find((b) => b.key === "rating");
  const overlineCategory = item.recipe?.recipe_category;

  return {
    author: item.author,
    // Rating is surfaced as an image overlay, so keep it out of the chip row.
    badges: allBadges.filter((b) => b.key !== "rating"),
    href,
    imgData,
    isInternal,
    note,
    overline: overlineCategory || (isInternal ? "Featured recipe" : "From the web"),
    position,
    ratingText: ratingBadge ? ratingBadge.text : null,
    srcSet,
    subtitle,
    title,
  };
});

---

<div class="roundup-container" id={block?.type === "main_roundup" ? "main-roundup" : undefined}>
  {
    groupTitle && (
      <div class="group-header">
        <h2 class="group-title">{groupTitle}</h2>
        {groupDescription && (
          <p class="group-description">{groupDescription}</p>
        )}
      </div>
    )
  }

  {
    renderedItems.map(({
      author,
      badges,
      href,
      imgData,
      isInternal,
      note,
      overline,
      position,
      ratingText,
      srcSet,
      subtitle,
      title,
    }, index) => (
        <article class="ri-card" id={`item-${position}`} data-flip={index % 2 === 1 ? "true" : undefined}>
          {imgData.image_url ? (
            <div class="ri-media">
              <a href={href} class="ri-media-link">
                <img
                  src={imgData.image_url}
                  alt={imgData.imageAlt || title}
                  width={imgData.imageWidth}
                  height={imgData.imageHeight}
                  srcset={srcSet || undefined}
                  sizes="(max-width: 768px) calc(100vw - 2rem), min(420px, 50vw)"
                  loading="lazy"
                  decoding="async"
                  style={imgData.imageStyle}
                />
              </a>
              <span class="ri-rank">{position}</span>
              {ratingText && (
                <span class="ri-rating">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 4l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4-3.9-3.8 5.4-.8z" /></svg>
                  {ratingText}
                </span>
              )}
            </div>
          ) : (
            <div class="ri-media ri-media--empty">
              <span class="ri-rank">{position}</span>
            </div>
          )}

          <div class="ri-body">
            <div class="ri-overline">{overline}</div>
            <h3 class="ri-title">
              <a href={href}>{title}</a>
            </h3>

            {author?.name && (
              <div class="ri-meta">
                <AuthorBadge name={author.name} slug={author.slug} />
              </div>
            )}

            {badges.length > 0 && (
              <div class="ri-badges">
                {badges.map((badge) => (
                  <span class="ri-chip">
                    <svg class="ri-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={badge.icon} />
                    {badge.text}
                  </span>
                ))}
              </div>
            )}

            {subtitle && <p class="ri-subtitle">{subtitle}</p>}

            {note && (
              <blockquote class="ri-note">
                <span class="ri-note-label">Our take</span>
                <p class="ri-note-text">{note}</p>
              </blockquote>
            )}

            <a href={href} class="ri-cta">
              {isInternal ? "Get the recipe" : "Read more"}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))
  }
</div>

<style>
  .roundup-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-14);
    margin: var(--space-12) 0;
  }

  .group-header {
    border-left: 8px solid var(--brand-secondary);
    padding-left: var(--space-6);
  }

  .group-title {
    font-size: clamp(1.75rem, 6vw, 2.75rem);
    font-weight: var(--font-extrabold);
    line-height: 1.1;
    margin: 0;
    font-family: var(--font-heading);
    letter-spacing: -0.02em;
  }

  .group-description {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-4);
    max-width: 60ch;
  }

  /* ── Editorial zigzag card ─────────────────────────── */
  .ri-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: center;
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--border);
  }

  .ri-card:last-child {
    border-bottom: none;
  }

  .ri-card[data-flip] .ri-media {
    order: 2;
  }

  .ri-media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 4 / 3;
  }

  .ri-media--empty {
    background: var(--bg-alt);
  }

  .ri-media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ri-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .ri-card:hover .ri-media img {
    transform: scale(1.04);
  }

  .ri-rank {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    width: var(--space-10);
    height: var(--space-10);
    background: var(--brand-secondary);
    color: var(--text-inverse);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-extrabold);
    box-shadow: var(--shadow-md);
  }

  .ri-rating {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: var(--bg-glass);
    border: 1px solid var(--border-glass);
    color: var(--brand-primary);
    padding: var(--space-1) var(--space-2.5);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-extrabold);
    box-shadow: var(--shadow-sm);
  }

  .ri-rating svg {
    width: 14px;
    height: 14px;
  }

  .ri-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .ri-overline {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-secondary);
  }

  .ri-title {
    margin: 0;
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    font-weight: var(--font-extrabold);
    line-height: 1.18;
    font-family: var(--font-heading);
  }

  .ri-title a {
    text-decoration: none;
    color: var(--text);
    transition: color var(--transition-fast);
  }

  .ri-title a:hover {
    color: var(--brand-secondary);
  }

  .ri-meta {
    margin: var(--space-0.5) 0;
  }

  .ri-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .ri-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    background: var(--bg-alt);
    border: 1px solid transparent;
    color: var(--text);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    white-space: nowrap;
  }

  .ri-chip-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--brand-secondary);
  }

  .ri-subtitle {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin: 0;
  }

  .ri-note {
    margin: var(--space-1) 0 0;
    border-left: 3px solid var(--brand-secondary);
    padding: var(--space-0.5) 0 var(--space-0.5) var(--space-4);
  }

  .ri-note-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-secondary);
    margin-bottom: var(--space-1);
  }

  .ri-note-text {
    margin: 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text-secondary);
  }

  .ri-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1.5);
    margin-top: var(--space-2);
    background: var(--brand-secondary);
    color: var(--text-inverse);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    font-weight: var(--font-bold);
    text-decoration: none;
    transition: background-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: var(--shadow-md);
  }

  .ri-cta:hover {
    background: var(--text);
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .ri-cta svg {
    transition: transform var(--transition-fast);
  }

  .ri-cta:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .ri-card {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .ri-card[data-flip] .ri-media {
      order: 0;
    }
  }

  /* Dark mode handled automatically by semantic variables */
</style>
