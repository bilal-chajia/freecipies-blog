---
import type {
  RoundupJson,
} from "@modules/articles/types/roundups.types";
import {
  extractImage,
  getImageSrcSet,
} from "@shared/utils/hydration";
import { resolveRoundupBadges } from "@modules/articles/utils/roundup-badges";
import AuthorBadge from "./AuthorBadge.astro";

type RoundupItem = NonNullable<RoundupJson["items"]>[number];

interface Props {
  roundup?: Record<string, unknown>;
  block?: Record<string, unknown>;
  roundup_json?: Record<string, unknown>;
  startNumber?: number;
}

const {
  roundup: rawRoundupProp,
  block,
  roundup_json: rawRoundupJson,
  startNumber = 1,
} = Astro.props;

// Both entry points (in-body main_roundup marker, standalone roundup) carry the
// same roundup_json shape. Pick whichever prop was supplied and parse once.
const rawRoundup =
  block?.type === "main_roundup" ? rawRoundupJson : rawRoundupProp;
const roundup: RoundupJson =
  (typeof rawRoundup === "string"
    ? (() => {
        try {
          return JSON.parse(rawRoundup);
        } catch {
          return null;
        }
      })()
    : rawRoundup) || { list_type: "ItemList", items: [] };

const items: RoundupItem[] = [...(roundup.items || [])].sort(
  (a: RoundupItem, b: RoundupItem) => (a.position || 0) - (b.position || 0),
);
const groupTitle = roundup.group_title || "";
const groupDescription = roundup.group_description || "";
const showStats = roundup.show_stats !== false;
const visibleBadges = roundup.visible_badges;

if (!items || items.length === 0) return null;

const renderedItems = items.map((item, index) => {
  const isInternal = item.source_type !== "external_recipe";
  const position = startNumber + index;
  const href =
    isInternal && item.slug
      ? `/recipes/${item.slug}`
      : item.external_url || "#";
  const title = item.title || "Untitled";
  const subtitle = item.subtitle || item.description || "";
  const note = item.note || "";
  let imgData: Record<string, any> = {};
  let srcSet = "";

  if (item.image?.variants) {
    const slots = { thumbnail: item.image };
    imgData = extractImage(JSON.stringify(slots), "thumbnail", 800) as Record<string, any>;
    srcSet = getImageSrcSet(JSON.stringify(slots), "thumbnail");
  }

  const allBadges = showStats ? resolveRoundupBadges(item, visibleBadges) : [];
  const ratingBadge = allBadges.find((b) => b.key === "rating");
  const overlineCategory = item.recipe?.recipe_category;

  return {
    author: item.author,
    // Rating is surfaced as an image overlay, so keep it out of the chip row.
    badges: allBadges.filter((b) => b.key !== "rating"),
    href,
    imgData,
    isInternal,
    note,
    overline: overlineCategory || (isInternal ? "Featured recipe" : "From the web"),
    position,
    ratingText: ratingBadge ? ratingBadge.text : null,
    srcSet,
    subtitle,
    title,
  };
});

---

<div class="roundup-container" id={block?.type === "main_roundup" ? "main-roundup" : undefined}>
  {
    groupTitle && (
      <div class="group-header">
        <h2 class="group-title">{groupTitle}</h2>
        {groupDescription && (
          <p class="group-description">{groupDescription}</p>
        )}
      </div>
    )
  }

  {
    renderedItems.map(({
      author,
      badges,
      href,
      imgData,
      isInternal,
      note,
      overline,
      position,
      ratingText,
      srcSet,
      subtitle,
      title,
    }, index) => (
        <article class="ri-card" id={`item-${position}`} data-flip={index % 2 === 1 ? "true" : undefined}>
          {imgData.image_url ? (
            <div class="ri-media">
              <a href={href} class="ri-media-link">
                <img
                  src={imgData.image_url}
                  alt={imgData.imageAlt || title}
                  width={imgData.imageWidth}
                  height={imgData.imageHeight}
                  srcset={srcSet || undefined}
                  sizes="(max-width: 768px) calc(100vw - 2rem), min(420px, 50vw)"
                  loading="lazy"
                  decoding="async"
                  style={imgData.imageStyle}
                />
              </a>
              <span class="ri-rank">{position}</span>
              {ratingText && (
                <span class="ri-rating">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 4l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4-3.9-3.8 5.4-.8z" /></svg>
                  {ratingText}
                </span>
              )}
            </div>
          ) : (
            <div class="ri-media ri-media--empty">
              <span class="ri-rank">{position}</span>
            </div>
          )}

          <div class="ri-body">
            <div class="ri-overline">{overline}</div>
            <h3 class="ri-title">
              <a href={href}>{title}</a>
            </h3>

            {author?.name && (
              <div class="ri-meta">
                <AuthorBadge name={author.name} slug={author.slug} />
              </div>
            )}

            {badges.length > 0 && (
              <div class="ri-badges">
                {badges.map((badge) => (
                  <span class="ri-chip">
                    <svg class="ri-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={badge.icon} />
                    {badge.text}
                  </span>
                ))}
              </div>
            )}

            {subtitle && <p class="ri-subtitle">{subtitle}</p>}

            {note && (
              <blockquote class="ri-note">
                <span class="ri-note-label">Our take</span>
                <p class="ri-note-text">{note}</p>
              </blockquote>
            )}

            <a href={href} class="ri-cta">
              {isInternal ? "Get the recipe" : "Read more"}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))
  }
</div>

<style>
  .roundup-container {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin: 3rem 0;
  }

  .group-header {
    border-left: 8px solid var(--brand-secondary);
    padding-left: 1.5rem;
  }

  .group-title {
    font-size: clamp(1.75rem, 6vw, 2.75rem);
    font-weight: 900;
    line-height: 1.1;
    margin: 0;
    font-family: var(--font-heading);
    letter-spacing: -0.02em;
  }

  .group-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 1rem;
    max-width: 60ch;
  }

  /* ── Editorial zigzag card ─────────────────────────── */
  .ri-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .ri-card:last-child {
    border-bottom: none;
  }

  .ri-card[data-flip] .ri-media {
    order: 2;
  }

  .ri-media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 4 / 3;
  }

  .ri-media--empty {
    background: var(--bg-alt);
  }

  .ri-media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ri-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ri-card:hover .ri-media img {
    transform: scale(1.04);
  }

  .ri-rank {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    width: 42px;
    height: 42px;
    background: var(--brand-secondary);
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    box-shadow: var(--shadow-md);
  }

  .ri-rating {
    position: absolute;
    bottom: 0.85rem;
    left: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--brand-secondary);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    font-weight: 800;
    box-shadow: var(--shadow-sm);
  }

  .ri-rating svg {
    width: 14px;
    height: 14px;
  }

  .ri-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .ri-overline {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-secondary);
  }

  .ri-title {
    margin: 0;
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    font-weight: 800;
    line-height: 1.18;
    font-family: var(--font-heading);
  }

  .ri-title a {
    text-decoration: none;
    color: var(--text);
    transition: color 0.2s;
  }

  .ri-title a:hover {
    color: var(--brand-secondary);
  }

  .ri-meta {
    margin: 0.1rem 0;
  }

  .ri-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ri-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--bg-alt);
    border: 1px solid transparent;
    color: var(--text);
    padding: 5px 11px;
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .ri-chip-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--brand-secondary);
  }

  .ri-subtitle {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .ri-note {
    margin: 0.25rem 0 0;
    border-left: 3px solid var(--brand-secondary);
    padding: 0.1rem 0 0.1rem 1rem;
  }

  .ri-note-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-secondary);
    margin-bottom: 0.3rem;
  }

  .ri-note-text {
    margin: 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .ri-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    background: var(--brand-secondary);
    color: #fff;
    padding: 0.75rem 1.6rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s, transform 0.2s, box-shadow 0.2s;
    box-shadow: var(--shadow-md);
  }

  .ri-cta:hover {
    background: var(--text);
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .ri-cta svg {
    transition: transform 0.2s;
  }

  .ri-cta:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .ri-card {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .ri-card[data-flip] .ri-media {
      order: 0;
    }
  }

  /* Dark mode handled automatically by semantic variables */
</style>