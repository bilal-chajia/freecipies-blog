---
import type {
  RoundupJson,
} from "@modules/articles/types/roundups.types";
import {
  extractImage,
  getImageSrcSet,
} from "@shared/utils/hydration";
import AuthorBadge from "./AuthorBadge.astro";

type RoundupItem = NonNullable<RoundupJson["items"]>[number];

interface Props {
  roundup?: Record<string, unknown>;
  block?: Record<string, unknown>;
  roundupJson?: Record<string, unknown>;
  startNumber?: number;
}

const {
  roundup: rawRoundup,
  block,
  roundupJson: rawRoundupJson,
  startNumber = 1,
} = Astro.props;

// Parse roundup if it's a string (Legacy support)
let items: RoundupItem[] = [];
let groupTitle = "";
let groupDescription = "";
let showStats = true;

if (block?.type === "main_roundup") {
  const roundup =
    typeof rawRoundupJson === "string"
      ? JSON.parse(rawRoundupJson)
      : rawRoundupJson || { list_type: "ItemList", items: [] };
  items = (roundup.items || []).sort(
    (a: RoundupItem, b: RoundupItem) => (a.position || 0) - (b.position || 0),
  );
} else {
  const roundup: RoundupJson =
    typeof rawRoundup === "string"
      ? JSON.parse(rawRoundup)
      : rawRoundup || { list_type: "ItemList", items: [] };
  items = (roundup.items || []).sort(
    (a: RoundupItem, b: RoundupItem) => (a.position || 0) - (b.position || 0),
  );
}

if (!items || items.length === 0) return null;

const renderedItems = items.map((item, index) => {
  const isInternal = item.source_type !== "external_recipe";
  const position = startNumber + index;
  const href =
    isInternal && item.slug
      ? `/recipes/${item.slug}`
      : item.external_url || "#";
  const title = item.title || "Untitled";
  const subtitle = item.subtitle || item.description || "";
  const note = item.note || "";
  let imgData: Record<string, any> = {};
  let srcSet = "";

  if (item.image?.variants) {
    const slots = { thumbnail: item.image };
    imgData = extractImage(JSON.stringify(slots), "thumbnail", 800) as Record<string, any>;
    srcSet = getImageSrcSet(JSON.stringify(slots), "thumbnail");
  }

  return {
    item,
    author: item.author,
    href,
    imgData,
    isInternal,
    note,
    position,
    srcSet,
    subtitle,
    title,
  };
});

---

<div class="roundup-container" id={block?.type === "main_roundup" ? "main-roundup" : undefined}>
  {
    groupTitle && (
      <div class="group-header">
        <h2 class="group-title">{groupTitle}</h2>
        {groupDescription && (
          <p class="group-description">{groupDescription}</p>
        )}
      </div>
    )
  }

  {
    renderedItems.map(({
      author,
      href,
      imgData,
      isInternal,
      note,
      position,
      srcSet,
      subtitle,
      title,
    }) => (
        <div class="roundup-item-card" id={`item-${position}`}>
          <div class="item-header">
            <div class="position-badge">{position}</div>
            <h3 class="item-title">
              <a href={href}>{title}</a>
            </h3>
          </div>

          {imgData.imageUrl && (
            <div class="item-media">
              <a href={href} class="media-link">
                <img
                  src={imgData.imageUrl}
                  alt={imgData.imageAlt || title}
                  width={imgData.imageWidth}
                  height={imgData.imageHeight}
                  srcset={srcSet || undefined}
                  sizes="(max-width: 768px) calc(100vw - 2rem), min(800px, 100vw - 4rem)"
                  loading="lazy"
                  decoding="async"
                  style={imgData.imageStyle}
                />
              </a>
            </div>
          )}

          {author?.name && (
            <AuthorBadge
              name={author.name}
              slug={author.slug}
            />
          )}

          <div class="item-content">
            {subtitle && <p class="item-subtitle">{subtitle}</p>}

            {note && (
              <div class="item-note">
                <div class="note-label">Our Take:</div>
                <p class="note-text">{note}</p>
              </div>
            )}

            <div class="item-actions">
              <a href={href} class="btn-primary">
                {isInternal ? "Get the Recipe" : "Read More"}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))
  }
</div>

<style>
  .roundup-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin: 3rem 0;
  }

  .group-header {
    margin-bottom: -1rem;
    border-left: 8px solid var(--text);
    padding-left: 1.5rem;
  }

  .group-title {
    font-size: clamp(1.75rem, 6vw, 2.75rem);
    font-weight: 900;
    line-height: 1.1;
    margin: 0;
    font-family: var(--font-heading);
    letter-spacing: -0.02em;
  }

  .group-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 1rem;
    max-width: 60ch;
  }

  .roundup-item-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .roundup-item-card:last-child {
    border-bottom: none;
  }

  .item-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .position-badge {
    width: 48px;
    height: 48px;
    background: var(--brand-secondary);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 800;
    flex-shrink: 0;
    box-shadow: var(--shadow-md);
  }

  .item-title {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    font-family: var(--font-heading);
  }

  .item-title a {
    text-decoration: none;
    color: var(--text);
    transition: color 0.2s;
  }

  .item-title a:hover {
    color: var(--brand-secondary);
  }

  .item-media {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .media-link {
    display: block;
    aspect-ratio: 16/9;
  }

  .item-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .roundup-item-card:hover .item-media img {
    transform: scale(1.03);
  }

  .item-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .item-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .item-note {
    background: var(--bg-alt);
    border-left: 4px solid var(--brand-secondary);
    padding: 1.5rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .note-label {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--brand-secondary);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .note-text {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
    font-style: italic;
  }

  .item-actions {
    margin-top: 0.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--text);
    color: var(--text-inverse);
    padding: 0.875rem 2rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: var(--shadow-md);
  }

  .btn-primary:hover {
    background: var(--brand-secondary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .btn-primary svg {
    transition: transform 0.2s;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  /* Dark mode handled automatically by semantic variables */
</style>
