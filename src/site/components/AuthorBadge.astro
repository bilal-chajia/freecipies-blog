---
interface Props {
  name: string;
  slug?: string;
  avatar?: string;
  role?: string;
}

const { name, slug, avatar, role } = Astro.props;
const authorUrl = `/authors/${slug ?? ""}`;

// Get initials for fallback
const initials = name
  .split(" ")
  .map((n) => n[0])
  .join("")
  .toUpperCase()
  .slice(0, 2);
---

<div class="author-badge">
  <a href={authorUrl} class="avatar-link">
    {
      avatar ? (
        <img src={avatar} alt={name} class="avatar-img" width="28" height="28" loading="lazy" />
      ) : (
        <div class="avatar-placeholder">{initials}</div>
      )
    }
  </a>
  <div class="author-details">
    <span class="by-prefix">By</span>
    <a href={authorUrl} class="author-link">{name}</a>
    {role && <span class="author-role">· {role}</span>}
  </div>
</div>

<style>
  .author-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    font-family: var(--font-sans);
  }

  .avatar-link {
    flex-shrink: 0;
    display: block;
    width: 28px;
    height: 28px;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .avatar-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-details {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    color: #6b7280;
  }

  .by-prefix {
    color: #9ca3af;
  }

  .author-link {
    color: #111827;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }

  .author-link:hover {
    color: #ff6b35;
    text-decoration: underline;
  }

  .author-role {
    color: #9ca3af;
    font-size: 0.8125rem;
  }

  :global(.dark) .author-link {
    color: #f3f4f6;
  }
  :global(.dark) .by-prefix,
  :global(.dark) .author-role {
    color: #6b7280;
  }
</style>
