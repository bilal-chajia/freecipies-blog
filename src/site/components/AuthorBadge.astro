---
interface Props {
  name: string;
  slug?: string;
  avatar?: string;
  role?: string;
}

const { name, slug, avatar, role } = Astro.props;
const authorUrl = `/authors/${slug ?? ""}`;

// Get initials for fallback
const initials = name
  .split(" ")
  .map((n) => n[0])
  .join("")
  .toUpperCase()
  .slice(0, 2);
---

<div class="author-badge">
  <a href={authorUrl} class="avatar-link">
    {
      avatar ? (
        <img src={avatar} alt={name} class="avatar-img" width="28" height="28" loading="lazy" />
      ) : (
        <div class="avatar-placeholder">{initials}</div>
      )
    }
  </a>
  <div class="author-details">
    <span class="by-prefix">By</span>
    <a href={authorUrl} class="author-link">{name}</a>
    {role && <span class="author-role">· {role}</span>}
  </div>
</div>

<style>
  .author-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
    font-family: var(--font-sans);
  }

  .avatar-link {
    flex-shrink: 0;
    display: block;
    width: var(--space-7);
    height: var(--space-7);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .avatar-placeholder {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    background: var(--brand-gradient);
    color: var(--text-inverse);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-details {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .by-prefix {
    color: var(--text-tertiary);
  }

  .author-link {
    color: var(--text);
    font-weight: var(--font-semibold);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .author-link:hover {
    color: var(--brand-accent);
    text-decoration: underline;
  }

  .author-role {
    color: var(--text-tertiary);
    font-size: var(--text-xs);
  }
</style>
