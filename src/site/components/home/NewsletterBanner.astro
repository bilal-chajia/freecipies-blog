---
import type { HomepageNewsletterSection } from '@modules/settings/types/settings.types';

interface Props {
  section: HomepageNewsletterSection;
}

const { section } = Astro.props;
---

<section class="newsletter-band" data-fade-up>
  <div class="newsletter-band__inner">
    <div class="newsletter-band__copy">
      <h2>{section.title}</h2>
      <p>{section.subtitle}</p>
    </div>
    <form class="newsletter-band__form">
      <label class="sr-only" for="homepage-newsletter-email">Email address</label>
      <input
        id="homepage-newsletter-email"
        type="email"
        name="email"
        placeholder={section.placeholder_text}
        autocomplete="email"
        required
      />
      <button type="submit">{section.button_text}</button>
    </form>
  </div>
</section>

<style>
  .newsletter-band {
    padding: clamp(var(--space-10), 7vw, var(--space-16)) var(--space-5);
    background:
      linear-gradient(135deg, rgba(0, 0, 0, 0.2), transparent 55%),
      var(--text);
    color: var(--text-inverse);
  }

  .newsletter-band__inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(20rem, 0.85fr);
    gap: clamp(var(--space-6), 5vw, var(--space-12));
    align-items: center;
  }

  .newsletter-band h2 {
    max-width: 13ch;
    margin: 0;
    color: var(--text-inverse);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.4rem + 2vw, 3.5rem);
    line-height: var(--leading-tight);
    letter-spacing: 0;
  }

  .newsletter-band p {
    max-width: 42rem;
    margin: var(--space-3) 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .newsletter-band__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-3);
    padding: var(--space-2);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
  }

  .newsletter-band__form input {
    min-width: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: var(--text-base);
    padding: var(--space-4) var(--space-5);
  }

  .newsletter-band__form input:focus-visible,
  .newsletter-band__form button:focus-visible {
    outline: var(--focus-ring-width) solid var(--brand-accent);
    outline-offset: var(--focus-ring-offset);
  }

  .newsletter-band__form button {
    border: 0;
    border-radius: var(--radius-full);
    background: var(--brand-accent);
    color: var(--neutral-950);
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    padding: 0 var(--space-6);
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .newsletter-band__form button:hover {
    background: var(--brand-accent-hover);
    transform: translateY(-1px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 780px) {
    .newsletter-band {
      padding-inline: var(--space-4);
    }

    .newsletter-band__inner,
    .newsletter-band__form {
      grid-template-columns: 1fr;
    }

    .newsletter-band__form {
      border-radius: var(--radius-xl);
    }

    .newsletter-band__form button {
      min-height: 3.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .newsletter-band__form button {
      transition: none;
    }
  }
</style>
