---
import { resolveVariantUrl } from '@shared/types/images';
import type { HomepageSeasonalSpotlightSection } from '@modules/settings/types/settings.types';

interface Props {
  section: HomepageSeasonalSpotlightSection;
}

const { section } = Astro.props;
const image = section.image!;
const smUrl = resolveVariantUrl(image.variants.sm);
const mdUrl = resolveVariantUrl(image.variants.md);
const lgUrl = resolveVariantUrl(image.variants.lg);
const src = mdUrl ?? lgUrl ?? smUrl;
const srcSet = [
  smUrl ? `${smUrl} ${image.variants.sm.width}w` : '',
  mdUrl ? `${mdUrl} ${image.variants.md.width}w` : '',
  lgUrl ? `${lgUrl} ${image.variants.lg.width}w` : '',
].filter(Boolean).join(', ');
const imageStyle = image.focal_point
  ? `object-position: ${image.focal_point.x}% ${image.focal_point.y}%;`
  : undefined;
const isExternalCta = (() => {
  try {
    return new URL(section.cta.href).protocol === 'https:';
  } catch {
    return false;
  }
})();
---

{src && (
  <section class="seasonal-spotlight" data-fade-up>
    <div class="seasonal-spotlight__inner">
      <div class="seasonal-spotlight__media">
        <img
          src={src}
          alt={image.alt}
          width={image.variants.md.width}
          height={image.variants.md.height}
          srcset={srcSet || undefined}
          sizes={srcSet ? '(max-width: 760px) calc(100vw - 2rem), (max-width: 1100px) 45vw, 540px' : undefined}
          loading="lazy"
          style={imageStyle}
        />
      </div>
      <div class="seasonal-spotlight__copy">
        <h2>{section.title}</h2>
        <p>{section.body}</p>
        <a
          class="seasonal-spotlight__cta"
          href={section.cta.href}
          target={isExternalCta ? '_blank' : undefined}
          rel={isExternalCta ? 'noopener noreferrer' : undefined}
        >
          {section.cta.label}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .seasonal-spotlight {
    padding: clamp(var(--space-10), 7vw, var(--space-16)) var(--space-5);
    background: var(--bg-alt);
  }

  .seasonal-spotlight__inner {
    display: grid;
    max-width: var(--container-max);
    margin: 0 auto;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
    gap: clamp(var(--space-6), 5vw, var(--space-12));
    align-items: center;
  }

  .seasonal-spotlight__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-inset);
  }

  .seasonal-spotlight__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .seasonal-spotlight__copy {
    max-width: 36rem;
  }

  .seasonal-spotlight h2 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem);
    line-height: var(--leading-tight);
    letter-spacing: 0;
  }

  .seasonal-spotlight p {
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .seasonal-spotlight__cta {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    border-bottom: 1px solid currentColor;
    color: var(--text-brand);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-decoration: none;
  }

  .seasonal-spotlight__cta span {
    font-size: var(--text-lg);
    transition: transform var(--transition-fast);
  }

  .seasonal-spotlight__cta:hover span {
    transform: translateX(var(--space-1));
  }

  .seasonal-spotlight__cta:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  @media (max-width: 760px) {
    .seasonal-spotlight {
      padding-inline: var(--space-4);
    }

    .seasonal-spotlight__inner {
      grid-template-columns: 1fr;
    }

    .seasonal-spotlight__copy {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seasonal-spotlight__cta span {
      transition: none;
    }
  }
</style>
