---
import type { HomeSectionVM } from '@site/utils/home-data';
import StoriesBar from '@components/StoriesBar.astro';
import HeroSection from './HeroSection.astro';
import QuickFilters from './QuickFilters.astro';
import FeaturedRecipes from './FeaturedRecipes.astro';
import CategoryBrowse from './CategoryBrowse.astro';
import Collections from './Collections.astro';
import SeasonalSpotlight from './SeasonalSpotlight.astro';
import LatestRecipes from './LatestRecipes.astro';
import AboutAuthor from './AboutAuthor.astro';
import NewsletterBanner from './NewsletterBanner.astro';
import HomeFaq from './HomeFaq.astro';

interface Props {
  sections: HomeSectionVM[];
  siteTagline: string;
}
const { sections, siteTagline } = Astro.props as Props;
const faqVm = sections.find((vm) => vm.kind === 'faq');
const orderedSections = sections.filter((vm) => vm.kind !== 'faq');

const hasCarousel = orderedSections.some((vm) => {
  if (vm.kind === 'hero') return vm.section.mode === 'slider' && vm.recipes.length > 1;
  if (vm.kind === 'featured_recipes') return vm.recipes.length > 1;
  if (vm.kind === 'collections') return vm.roundups.length > 1;
  return false;
});
---
{
  orderedSections.map((vm) => {
    switch (vm.kind) {
      case 'stories':
        return <StoriesBar stories={vm.stories} />;
      case 'hero':
        return <HeroSection section={vm.section} recipes={vm.recipes} tagline={siteTagline} />;
      case 'quick_filters':
        return <QuickFilters section={vm.section} filters={vm.filters} />;
      case 'featured_recipes':
        return <FeaturedRecipes section={vm.section} recipes={vm.recipes} />;
      case 'category_browse':
        return <CategoryBrowse section={vm.section} categories={vm.categories} />;
      case 'collections':
        return <Collections section={vm.section} roundups={vm.roundups} />;
      case 'seasonal_spotlight':
        return <SeasonalSpotlight section={vm.section} />;
      case 'latest':
        return <LatestRecipes section={vm.section} recipes={vm.recipes} />;
      case 'about_author':
        return <AboutAuthor section={vm.section} author={vm.author} />;
      case 'newsletter':
        return <NewsletterBanner section={vm.section} />;
    }
  })
}

{faqVm && <HomeFaq section={faqVm.section} items={faqVm.items} />}

{hasCarousel && (
  <script>
    import '@site/scripts/home-carousels';
  </script>
)}
