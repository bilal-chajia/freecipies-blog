---
import { extractImage, getImageSrcSet } from '@shared/utils';
import { parseCachedRecipe } from '@modules/articles/utils/cached-fields';
import type { HomepageFeaturedRecipesSection } from '@modules/settings/types/settings.types';
import type { HydratedArticle } from '@modules/articles/types';

interface Props {
  section: HomepageFeaturedRecipesSection;
  recipes: HydratedArticle[];
}

const { section, recipes } = Astro.props;

const getRecipeImage = (recipe: HydratedArticle, targetWidth: number, prefer: 'hero' | 'thumbnail' = 'hero') => {
  const hero = extractImage(recipe.images_json, 'hero', targetWidth);
  const thumbnail = extractImage(recipe.images_json, 'thumbnail', targetWidth);
  const slotName = prefer === 'hero'
    ? (hero.image_url ? 'hero' : 'thumbnail')
    : (thumbnail.image_url ? 'thumbnail' : 'hero');
  const selected = slotName === 'hero' ? hero : thumbnail;
  const srcSet = getImageSrcSet(recipe.images_json, slotName);
  return { selected, srcSet };
};

const getRecipeUrl = (recipe: HydratedArticle) => recipe.route || `/recipes/${recipe.slug}`;
---

{recipes.length > 0 && (
  <section class="section popular-recipes-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">
          <span class="title-dot"></span>
          {section.title}
        </h2>
      </div>
      <div class="popular-grid">
        {recipes.map((recipe: HydratedArticle) => {
          const { selected, srcSet } = getRecipeImage(recipe, 400, 'hero');
          const sizes = '(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 25vw';
          const cachedRecipe = parseCachedRecipe(recipe.cached_recipe_json);
          const cookTime = cachedRecipe?.cook_time_minutes ?? null;
          return (
            <article class="foxiz-card">
              <a href={getRecipeUrl(recipe)} class="foxiz-card-image">
                {(selected.image_url || recipe.image_url) && (
                  <img
                    src={selected.image_url || recipe.image_url}
                    alt={selected.imageAlt || recipe.imageAlt || recipe.headline}
                    width={selected.imageWidth || recipe.imageWidth || 400}
                    height={selected.imageHeight || recipe.imageHeight || 300}
                    srcset={srcSet || undefined}
                    sizes={srcSet ? sizes : undefined}
                    loading="lazy"
                    style={selected.imageStyle || undefined}
                  />
                )}
                <span
                  class="badge foxiz-badge"
                  style={`--badge-color: ${recipe.category?.color || 'var(--brand-primary)'};`}
                >
                  {recipe.category?.label}
                </span>
              </a>
              <div class="foxiz-card-body">
                <h3 class="foxiz-card-title">
                  <a href={getRecipeUrl(recipe)}>{recipe.headline}</a>
                </h3>
                <div class="foxiz-tags">
                  {recipe.category?.label && (
                    <a href={`/categories/${recipe.category?.slug}`} class="foxiz-tag">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 4h6l2 3h8v10H4z"/>
                      </svg>
                      {recipe.category?.label}
                    </a>
                  )}
                  {cookTime && (
                    <span class="foxiz-tag">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 6v6l4 2"/>
                      </svg>
                      {`${cookTime} min`}
                    </span>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  .section {
    padding: clamp(var(--space-12), 7vw, 5.5rem) 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 1.25rem + 1.2vw, 2.35rem);
    font-weight: var(--font-bold);
    color: var(--text);
    margin: 0;
    letter-spacing: 0;
  }

  .title-dot {
    display: inline-block;
    width: var(--space-2);
    height: var(--space-2);
    background: var(--brand-primary);
    border-radius: var(--radius-full);
    margin-right: var(--space-2);
    vertical-align: middle;
  }

  /* === Foxiz-style Popular Recipes Cards === */
  .popular-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
    gap: clamp(var(--space-4), 3vw, var(--space-6));
  }

  .foxiz-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .foxiz-card:hover {
    transform: translateY(calc(-1 * var(--space-1)));
    box-shadow: var(--shadow-hover);
  }

  .foxiz-card-image {
    position: relative;
    display: block;
    border-radius: 0;
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .foxiz-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .foxiz-card:hover .foxiz-card-image img {
    transform: scale(1.05);
  }

  .foxiz-badge {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    background: linear-gradient(
        rgba(0, 0, 0, 0.35),
        rgba(0, 0, 0, 0.35)
      ),
      var(--badge-color, var(--brand-primary));
  }

  .foxiz-card-body {
    padding: var(--space-4);
  }

  .foxiz-card-title {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-2.5);
    color: var(--text);
  }

  .foxiz-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .foxiz-card-title a:hover {
    color: var(--primary);
  }

  .foxiz-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }

  .foxiz-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .foxiz-tag svg {
    width: var(--text-xs);
    height: var(--text-xs);
  }

  a.foxiz-tag:hover {
    color: var(--primary);
  }

  /* === Popular Recipes Section === */
  .popular-recipes-section {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
  }
</style>
