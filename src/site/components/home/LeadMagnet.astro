---
import { resolveVariantUrl } from '@shared/types/images';
import type { HomepageLeadMagnetSection } from '@modules/settings/types/settings.types';

interface Props {
  section: HomepageLeadMagnetSection;
}

const { section } = Astro.props as Props;
const image = section.image!;
const smUrl = resolveVariantUrl(image.variants.sm);
const mdUrl = resolveVariantUrl(image.variants.md);
const lgUrl = resolveVariantUrl(image.variants.lg);
const src = mdUrl ?? lgUrl ?? smUrl;
const srcSet = [
  smUrl ? `${smUrl} ${image.variants.sm.width}w` : '',
  mdUrl ? `${mdUrl} ${image.variants.md.width}w` : '',
  lgUrl ? `${lgUrl} ${image.variants.lg.width}w` : '',
].filter(Boolean).join(', ');
const imageStyle = image.focal_point
  ? `object-position: ${image.focal_point.x}% ${image.focal_point.y}%;`
  : undefined;
const isExternalCta = section.cta.href.startsWith('https://');
---

{src && (
  <section class="lead-magnet" data-fade-up aria-labelledby={`lead-magnet-${section.id}`}>
    <div class="lead-magnet__inner">
      <div class="lead-magnet__media">
        <img
          src={src}
          alt={image.alt}
          width={image.variants.md.width}
          height={image.variants.md.height}
          srcset={srcSet || undefined}
          sizes={srcSet ? '(max-width: 760px) calc(100vw - 2rem), (max-width: 1100px) 45vw, 540px' : undefined}
          loading="lazy"
          style={imageStyle}
        />
      </div>
      <div class="lead-magnet__copy">
        <p class="lead-magnet__eyebrow">{section.eyebrow}</p>
        <h2 id={`lead-magnet-${section.id}`}>{section.title}</h2>
        <p class="lead-magnet__body">{section.body}</p>
        <a
          class="lead-magnet__cta"
          href={section.cta.href}
          target={isExternalCta ? '_blank' : undefined}
          rel={isExternalCta ? 'noopener noreferrer' : undefined}
        >
          {section.cta.label}
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .lead-magnet {
    padding: clamp(var(--space-10), 7vw, var(--space-16)) var(--space-5);
    background: var(--bg-alt);
  }

  .lead-magnet__inner {
    display: grid;
    max-width: var(--container-max);
    margin: 0 auto;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
    gap: clamp(var(--space-6), 5vw, var(--space-12));
    align-items: center;
  }

  .lead-magnet__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-inset);
  }

  .lead-magnet__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lead-magnet__copy {
    max-width: 36rem;
  }

  .lead-magnet__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--text-brand);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    line-height: var(--leading-normal);
    text-transform: uppercase;
  }

  .lead-magnet h2 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 1.25rem + 1.8vw, var(--text-4xl));
    line-height: var(--leading-tight);
    letter-spacing: 0;
  }

  .lead-magnet__body {
    margin: var(--space-4) 0 0;
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .lead-magnet__cta {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: var(--space-6);
    border-bottom: 1px solid currentColor;
    color: var(--text-brand);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-decoration: none;
  }

  .lead-magnet__cta:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }

  @media (max-width: 760px) {
    .lead-magnet {
      padding-inline: var(--space-4);
    }

    .lead-magnet__inner {
      grid-template-columns: 1fr;
    }

    .lead-magnet__copy {
      max-width: none;
    }
  }
</style>
