---
import { resolveVariantUrl } from '@shared/types/images';
import type { HomepageSocialProofSection } from '@modules/settings/types/settings.types';

interface Props {
  section: HomepageSocialProofSection;
}

const { section } = Astro.props as Props;
---

<section class="social-proof" data-fade-up aria-labelledby={`social-proof-${section.id}`}>
  <div class="social-proof__inner">
    <header class="social-proof__header">
      {section.eyebrow && <p class="social-proof__eyebrow">{section.eyebrow}</p>}
      <h2 id={`social-proof-${section.id}`}>{section.title}</h2>
    </header>

    {section.stats.length > 0 && (
      <dl class="social-proof__stats">
        {section.stats.map((stat) => (
          <div class="social-proof__stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {section.testimonials.length > 0 && (
      <div class="social-proof__testimonials">
        {section.testimonials.map((testimonial) => (
          <figure class="social-proof__testimonial">
            <blockquote>{testimonial.quote}</blockquote>
            <figcaption>
              <span>{testimonial.name}</span>
              {testimonial.role && <small>{testimonial.role}</small>}
            </figcaption>
          </figure>
        ))}
      </div>
    )}

    {section.logos.length > 0 && (
      <ul class="social-proof__logos" aria-label="Featured publications">
        {section.logos.map((logo) => {
          const image = logo.image!;
          const smUrl = resolveVariantUrl(image.variants.sm);
          const mdUrl = resolveVariantUrl(image.variants.md);
          const lgUrl = resolveVariantUrl(image.variants.lg);
          const src = mdUrl ?? lgUrl ?? smUrl;
          const srcSet = [
            smUrl ? `${smUrl} ${image.variants.sm.width}w` : '',
            mdUrl ? `${mdUrl} ${image.variants.md.width}w` : '',
            lgUrl ? `${lgUrl} ${image.variants.lg.width}w` : '',
          ].filter(Boolean).join(', ');

          return src && (
            <li>
              <img
                src={src}
                alt={image.alt}
                width={image.variants.md.width}
                height={image.variants.md.height}
                srcset={srcSet || undefined}
                sizes={srcSet ? '(max-width: 640px) 40vw, 180px' : undefined}
                loading="lazy"
              />
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>

<style>
  .social-proof {
    padding: clamp(var(--space-10), 7vw, var(--space-16)) var(--space-5);
    background: var(--bg);
  }

  .social-proof__inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .social-proof__header {
    max-width: 42rem;
  }

  .social-proof__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--text-brand);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    line-height: var(--leading-normal);
    text-transform: uppercase;
  }

  .social-proof h2 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-heading);
    font-size: clamp(var(--text-2xl), 1.25rem + 1.8vw, var(--text-4xl));
    line-height: var(--leading-tight);
    letter-spacing: 0;
  }

  .social-proof__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
  }

  .social-proof__stat {
    min-height: 5.5rem;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--border-strong);
  }

  .social-proof__stat dt {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .social-proof__stat dd {
    margin: var(--space-1) 0 0;
    color: var(--text);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
  }

  .social-proof__testimonials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .social-proof__testimonial {
    min-width: 0;
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .social-proof__testimonial blockquote {
    margin: 0;
    color: var(--text);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .social-proof__testimonial figcaption {
    display: grid;
    gap: var(--space-1);
    margin-top: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .social-proof__testimonial figcaption span {
    color: var(--text);
    font-weight: var(--font-bold);
  }

  .social-proof__testimonial small {
    font-size: inherit;
  }

  .social-proof__logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-5);
    align-items: center;
    margin: var(--space-10) 0 0;
    padding: var(--space-6) 0 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .social-proof__logos li {
    display: grid;
    min-height: 4.5rem;
    place-items: center;
  }

  .social-proof__logos img {
    display: block;
    width: min(100%, 11.25rem);
    max-height: 4rem;
    filter: grayscale(1);
    object-fit: contain;
  }

  @media (max-width: 640px) {
    .social-proof {
      padding-inline: var(--space-4);
    }
  }
</style>
