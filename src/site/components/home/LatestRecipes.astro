---
import { extractImage, getImageSrcSet } from '@shared/utils';
import { parseCachedRecipe } from '@modules/articles/utils/cached-fields';
import type { HomepageLatestSection } from '@modules/settings/types/settings.types';
import type { HydratedArticle } from '@modules/articles/types';

interface Props {
  section: HomepageLatestSection;
  recipes: HydratedArticle[];
}

const { section, recipes } = Astro.props;

const getRecipeImage = (recipe: HydratedArticle, targetWidth: number) => {
  const hero = extractImage(recipe.images_json, 'hero', targetWidth);
  const thumbnail = extractImage(recipe.images_json, 'thumbnail', targetWidth);
  const slotName = thumbnail.image_url ? 'thumbnail' : 'hero';
  const selected = thumbnail.image_url ? thumbnail : hero;
  const srcSet = getImageSrcSet(recipe.images_json, slotName);
  return { selected, srcSet };
};

const getRecipeUrl = (recipe: HydratedArticle) => recipe.route || `/recipes/${recipe.slug}`;
const getPrepTime = (recipe: HydratedArticle) =>
  parseCachedRecipe(recipe.cached_recipe_json)?.prep_time_minutes ?? null;
---

{recipes.length > 0 && (
  <section class="latest-grid" data-fade-up>
    <div class="latest-grid__inner">
      <div class="latest-grid__header">
        <h2>{section.title}</h2>
        <a href="/recipes">View all</a>
      </div>

      <div class="latest-grid__items">
        {recipes.map((recipe: HydratedArticle, index: number) => {
          const { selected, srcSet } = getRecipeImage(recipe, 420);
          const prepTime = getPrepTime(recipe);
          return (
            <article class="latest-card" style={`--stagger: ${index};`}>
              <a href={getRecipeUrl(recipe)} class="latest-card__media" aria-label={recipe.headline}>
                {(selected.image_url || recipe.image_url) && (
                  <img
                    src={selected.image_url || recipe.image_url}
                    alt={selected.imageAlt || recipe.imageAlt || recipe.headline}
                    width={selected.imageWidth || recipe.imageWidth || 420}
                    height={selected.imageHeight || recipe.imageHeight || 315}
                    srcset={srcSet || undefined}
                    sizes={srcSet ? '(max-width: 700px) 44vw, (max-width: 1100px) 30vw, 220px' : undefined}
                    loading="lazy"
                    style={selected.imageStyle || undefined}
                  />
                )}
              </a>
              <div class="latest-card__body">
                <div class="latest-card__meta">
                  {recipe.category?.label && <span>{recipe.category.label}</span>}
                  {prepTime && <span>{prepTime} min prep</span>}
                </div>
                <h3><a href={getRecipeUrl(recipe)}>{recipe.headline}</a></h3>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .latest-grid {
    padding: clamp(var(--space-10), 7vw, var(--space-16)) var(--space-5);
    background: var(--bg-alt);
  }

  .latest-grid__inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .latest-grid__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .latest-grid h2 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 1.35rem + 1.5vw, 2.75rem);
    line-height: var(--leading-tight);
    letter-spacing: 0;
  }

  .latest-grid__header a {
    color: var(--brand-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-decoration: none;
  }

  .latest-grid__header a:hover {
    color: var(--brand-primary-hover);
  }

  .latest-grid__items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: clamp(var(--space-4), 2vw, var(--space-5));
  }

  .latest-card {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .latest-card:hover {
    transform: translateY(calc(-1 * var(--space-1)));
    box-shadow: var(--shadow-md);
  }

  .latest-card__media {
    display: block;
    min-height: 8.25rem;
    overflow: hidden;
    background: var(--bg-inset);
  }

  .latest-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .latest-card:hover .latest-card__media img {
    transform: scale(1.06);
  }

  .latest-card__body {
    display: grid;
    align-content: center;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-4);
  }

  .latest-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
  }

  .latest-card h3 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .latest-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .latest-card h3 a:hover {
    color: var(--brand-primary);
  }

  @media (max-width: 640px) {
    .latest-grid {
      padding-inline: var(--space-4);
    }

    .latest-grid__header {
      align-items: start;
      flex-direction: column;
    }

    .latest-grid__items {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .latest-card,
    .latest-card__media img {
      transition: none;
    }
  }
</style>
