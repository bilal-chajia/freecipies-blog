---
import { extractImage, getImageSrcSet } from '@shared/utils';
import { parseCachedRecipe } from '@modules/articles/utils/cached-fields';
import type { HomepageHeroSection } from '@modules/settings/types/settings.types';
import type { HydratedArticle } from '@modules/articles/types';

interface Props {
  section: HomepageHeroSection;
  recipes: HydratedArticle[];
}

const { section, recipes } = Astro.props;
const heroRecipes = recipes;
const isSlider = section.mode === 'slider' && heroRecipes.length > 1;
const supportRecipes = isSlider ? heroRecipes : recipes.slice(1, 3);

const getRecipeImage = (recipe: HydratedArticle, targetWidth: number, prefer: 'hero' | 'thumbnail' = 'hero') => {
  const hero = extractImage(recipe.images_json, 'hero', targetWidth);
  const thumbnail = extractImage(recipe.images_json, 'thumbnail', targetWidth);
  const slotName = prefer === 'hero'
    ? (hero.image_url ? 'hero' : 'thumbnail')
    : (thumbnail.image_url ? 'thumbnail' : 'hero');
  const selected = slotName === 'hero' ? hero : thumbnail;
  const srcSet = getImageSrcSet(recipe.images_json, slotName);
  return { selected, srcSet };
};

const getRecipeUrl = (recipe: HydratedArticle) => recipe.route || `/recipes/${recipe.slug}`;
const getCookTime = (recipe: HydratedArticle) =>
  parseCachedRecipe(recipe.cached_recipe_json)?.cook_time_minutes ?? null;
---

{heroRecipes.length > 0 && (
  <section class:list={['home-hero', { 'home-hero--grid': !isSlider }]} data-fade-up>
    <div class="home-hero__inner">
      <div
        class="home-hero__showcase"
        data-home-carousel={isSlider ? 'loop' : undefined}
        data-autoplay={isSlider ? 'true' : undefined}
      >
        <div class="home-hero__viewport" data-home-carousel-viewport={isSlider ? '' : undefined}>
          <div class="home-hero__track">
            {heroRecipes.map((recipe: HydratedArticle, index: number) => {
              const { selected, srcSet } = getRecipeImage(recipe, 1200, 'hero');
              const cookTime = getCookTime(recipe);
              const sizes = '(max-width: 900px) 100vw, 68vw';
              return (
                <article class="home-hero__slide">
                  <a href={getRecipeUrl(recipe)} class="home-hero__card" aria-label={recipe.headline}>
                    <div class="home-hero__media">
                      {(selected.image_url || recipe.image_url) && (
                        <img
                          src={selected.image_url || recipe.image_url}
                          alt={selected.imageAlt || recipe.imageAlt || recipe.headline}
                          width={selected.imageWidth || recipe.imageWidth || 1200}
                          height={selected.imageHeight || recipe.imageHeight || 675}
                          srcset={srcSet || undefined}
                          sizes={srcSet ? sizes : undefined}
                          loading={index === 0 ? 'eager' : 'lazy'}
                          fetchpriority={index === 0 ? 'high' : 'auto'}
                          style={selected.imageStyle || undefined}
                        />
                      )}
                    </div>
                    <div class="home-hero__content">
                      <div class="home-hero__meta">
                        {recipe.category?.label && (
                          <span
                            class="home-pill"
                            style={`--pill-color: ${recipe.category.color || 'var(--brand-primary)'};`}
                          >
                            {recipe.category.label}
                          </span>
                        )}
                        {cookTime && <span>{cookTime} min</span>}
                      </div>
                      <h2>{recipe.headline}</h2>
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </div>

        {isSlider && (
          <div class="home-hero__controls" aria-label="Featured recipe carousel controls">
            <button type="button" data-home-carousel-prev aria-label="Previous featured recipe">
              <span aria-hidden="true">←</span>
            </button>
            <div class="home-hero__dots" role="tablist" aria-label="Featured recipes">
              {heroRecipes.map((recipe: HydratedArticle, index: number) => (
                <button
                  type="button"
                  data-home-carousel-dot
                  class:list={[{ 'is-selected': index === 0 }]}
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-label={`Show ${recipe.headline}`}
                />
              ))}
            </div>
            <button type="button" data-home-carousel-next aria-label="Next featured recipe">
              <span aria-hidden="true">→</span>
            </button>
          </div>
        )}
      </div>

      {supportRecipes.length > 0 && (
        <aside class="home-hero__side" aria-label="More featured recipes">
          {supportRecipes.map((recipe: HydratedArticle, index: number) => {
            const { selected, srcSet } = getRecipeImage(recipe, 520, 'thumbnail');
            const cookTime = getCookTime(recipe);
            return (
              <a
                href={getRecipeUrl(recipe)}
                class="home-hero__mini"
                style={`--stagger: ${index + 1};`}
                data-home-hero-support-card={isSlider ? '' : undefined}
                data-home-hero-recipe-index={isSlider ? String(index) : undefined}
                hidden={isSlider && index !== 1 && index !== 2}
              >
                <div class="home-hero__mini-media">
                  {(selected.image_url || recipe.image_url) && (
                    <img
                      src={selected.image_url || recipe.image_url}
                      alt={selected.imageAlt || recipe.imageAlt || recipe.headline}
                      width={selected.imageWidth || recipe.imageWidth || 520}
                      height={selected.imageHeight || recipe.imageHeight || 390}
                      srcset={srcSet || undefined}
                      sizes={srcSet ? '(max-width: 900px) 45vw, 24vw' : undefined}
                      loading="lazy"
                      style={selected.imageStyle || undefined}
                    />
                  )}
                </div>
                <div>
                  {recipe.category?.label && <span>{recipe.category.label}</span>}
                  <h3>{recipe.headline}</h3>
                  {cookTime && <p>{cookTime} min</p>}
                </div>
              </a>
            );
          })}
        </aside>
      )}
    </div>
  </section>
)}

<style>
  .home-hero {
    padding: clamp(var(--space-6), 5vw, var(--space-12)) var(--space-5) clamp(var(--space-10), 7vw, var(--space-16));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--brand-primary-light) 42%, transparent), transparent 46%),
      var(--bg);
  }

  .home-hero__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(360px, 1fr);
    gap: clamp(var(--space-4), 2.5vw, var(--space-7));
    align-items: stretch;
  }

  .home-hero__showcase {
    min-width: 0;
    position: relative;
  }

  .home-hero__viewport {
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid color-mix(in srgb, var(--border) 84%, transparent);
    box-shadow: var(--shadow-lg);
    background: var(--bg-elevated);
  }

  .home-hero__showcase[data-home-carousel] .home-hero__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .home-hero__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
  }

  .home-hero__showcase.is-carousel-enhanced .home-hero__viewport {
    overflow: hidden;
    scroll-snap-type: none;
  }

  .home-hero__viewport::-webkit-scrollbar {
    display: none;
  }

  .home-hero__slide {
    min-width: 0;
    scroll-snap-align: start;
  }

  .home-hero__card {
    position: relative;
    display: grid;
    min-height: clamp(34rem, 48vw, 42.5rem);
    overflow: hidden;
    background: color-mix(in srgb, var(--brand-primary) 55%, black);
    color: var(--text-inverse);
    text-decoration: none;
    isolation: isolate;
  }

  .home-hero__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0.28) 58%, rgba(0, 0, 0, 0.05)),
      linear-gradient(0deg, rgba(0, 0, 0, 0.55), transparent 56%);
  }

  .home-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .home-hero__media img,
  .home-hero__mini-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .home-hero__card:hover .home-hero__media img,
  .home-hero__mini:hover .home-hero__mini-media img {
    transform: scale(1.035);
  }

  .home-hero__content {
    position: relative;
    z-index: 2;
    align-self: end;
    max-width: 44rem;
    padding: clamp(var(--space-6), 5vw, var(--space-12));
  }

  .home-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    color: rgba(255, 255, 255, 0.86);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .home-pill {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--pill-color, var(--brand-primary)) 82%, black);
    color: var(--text-inverse);
  }

  .home-hero h2 {
    max-width: 13ch;
    margin: 0;
    color: var(--text-inverse);
    font-family: var(--font-serif);
    font-size: clamp(2.15rem, 1.55rem + 1.8vw, 2.9rem);
    font-weight: var(--font-bold);
    line-height: 0.98;
    letter-spacing: 0;
  }

  .home-hero__controls {
    position: absolute;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-full);
    background: rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(14px);
  }

  .home-hero__controls button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.14);
    color: var(--text-inverse);
    cursor: pointer;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .home-hero__controls button:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.24);
    transform: translateY(-1px);
  }

  .home-hero__controls button:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .home-hero__dots {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .home-hero__dots button {
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    background: rgba(255, 255, 255, 0.5);
  }

  .home-hero__dots button.is-selected {
    width: 1.35rem;
    background: var(--text-inverse);
  }

  .home-hero__side {
    display: grid;
    gap: var(--space-4);
  }

  .home-hero__mini {
    display: grid;
    grid-template-columns: minmax(10rem, 48%) minmax(0, 1fr);
    min-height: 13rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--bg-elevated);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .home-hero__mini[hidden] {
    display: none;
  }

  .home-hero__mini:hover {
    transform: translateY(calc(-1 * var(--space-1)));
    box-shadow: var(--shadow-md);
  }

  .home-hero__mini-media {
    min-height: 100%;
    overflow: hidden;
  }

  .home-hero__mini > div:last-child {
    display: grid;
    align-content: center;
    gap: var(--space-2);
    padding: clamp(var(--space-4), 2vw, var(--space-6));
  }

  .home-hero__mini span,
  .home-hero__mini p {
    margin: 0;
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
  }

  .home-hero__mini h3 {
    margin: 0;
    color: var(--text);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .home-hero--grid .home-hero__track {
    grid-auto-flow: initial;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    overflow: visible;
  }

  .home-hero--grid .home-hero__card {
    min-height: 22rem;
    border-radius: var(--radius-xl);
  }

  .home-hero--grid .home-hero__slide:first-child {
    grid-column: span 2;
  }

  @media (min-width: 901px) {
    .home-hero:not(.home-hero--grid) .home-hero__inner {
      height: 66.667svh;
    }

    .home-hero:not(.home-hero--grid) .home-hero__content {
      width: calc(100% - 12rem);
      max-width: none;
    }

    .home-hero:not(.home-hero--grid) h2 {
      max-width: none;
    }

    .home-hero:not(.home-hero--grid) .home-hero__showcase,
    .home-hero:not(.home-hero--grid) .home-hero__viewport,
    .home-hero:not(.home-hero--grid) .home-hero__track,
    .home-hero:not(.home-hero--grid) .home-hero__slide,
    .home-hero:not(.home-hero--grid) .home-hero__card {
      height: 100%;
    }

    .home-hero:not(.home-hero--grid) .home-hero__card,
    .home-hero:not(.home-hero--grid) .home-hero__mini {
      min-height: 0;
    }

    .home-hero:not(.home-hero--grid) .home-hero__side {
      min-height: 0;
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .home-hero__inner {
      grid-template-columns: 1fr;
    }

    .home-hero__card {
      min-height: clamp(28rem, 88vw, 34rem);
    }

    .home-hero__side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-hero__mini {
      grid-template-columns: 1fr;
    }

    .home-hero__mini-media {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 640px) {
    .home-hero {
      padding-inline: var(--space-4);
    }

    .home-hero__card {
      min-height: 30rem;
    }

    .home-hero__card::after {
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0.22) 70%, rgba(0, 0, 0, 0.06)),
        linear-gradient(90deg, rgba(0, 0, 0, 0.42), transparent);
    }

    .home-hero h2 {
      max-width: 12ch;
      font-size: clamp(2rem, 9vw, 2.3rem);
    }

    .home-hero__showcase[data-home-carousel] .home-hero__content {
      padding-bottom: calc(var(--space-16) + var(--space-6));
    }

    .home-hero__controls {
      right: var(--space-4);
      bottom: var(--space-4);
    }

    .home-hero__side,
    .home-hero--grid .home-hero__track {
      grid-template-columns: 1fr;
    }

    .home-hero--grid .home-hero__slide:first-child {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__media img,
    .home-hero__mini-media img,
    .home-hero__mini,
    .home-hero__controls button {
      transition: none;
    }
  }
</style>
