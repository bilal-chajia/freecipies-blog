---
import { extractImage } from '@shared/utils';
import type { HomepageAboutAuthorSection } from '@modules/settings/types/settings.types';
import type { Author } from '@modules/authors/schema/authors.schema';

interface Props {
  section: HomepageAboutAuthorSection;
  author: Author | null;
}

const { author } = Astro.props;

const authorImage = author ? extractImage(author.images_json, 'avatar', 720) : null;
const authorImageUrl = authorImage?.image_url || '';
const authorName = author?.name || 'Our Chef';
const authorFirstName = authorName.split(' ')[0] || authorName;
const authorBio = author?.short_description || '';
const authorSlug = author?.slug || '';
---

{author && (
  <section class="author-band" data-fade-up>
    <div class="author-band__inner">
      <div class="author-band__image">
        {authorImageUrl ? (
          <img
            src={authorImageUrl}
            alt={authorName}
            width={authorImage?.imageWidth || 720}
            height={authorImage?.imageHeight || 720}
            loading="lazy"
            style={authorImage?.imageStyle || undefined}
          />
        ) : (
          <span>{authorName.charAt(0)}</span>
        )}
      </div>
      <div class="author-band__content">
        <span class="author-band__eyebrow">Meet {authorFirstName}</span>
        <h2>About the Author</h2>
        {authorBio && <p>{authorBio}</p>}
        {authorSlug && <a href={`/authors/${authorSlug}`}>About {authorFirstName}</a>}
      </div>
    </div>
  </section>
)}

<style>
  .author-band {
    padding: clamp(var(--space-10), 7vw, var(--space-16)) var(--space-5);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--brand-primary-light) 80%, transparent), transparent 62%),
      var(--bg);
  }

  .author-band__inner {
    max-width: 64rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(16rem, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-6), 5vw, var(--space-12));
    align-items: center;
  }

  .author-band__image {
    display: grid;
    place-items: center;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--brand-gradient);
    color: var(--text-inverse);
    font-size: var(--text-5xl);
    font-weight: var(--font-bold);
    box-shadow: var(--shadow-lg);
  }

  .author-band__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .author-band__image:hover img {
    transform: scale(1.035);
  }

  .author-band__content {
    display: grid;
    gap: var(--space-4);
  }

  .author-band__eyebrow {
    color: var(--brand-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-transform: uppercase;
  }

  .author-band h2 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.4rem + 2vw, 3.5rem);
    line-height: var(--leading-tight);
    letter-spacing: 0;
  }

  .author-band p {
    max-width: 42rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .author-band a {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border-radius: var(--radius-full);
    background: var(--text);
    color: var(--text-inverse);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    text-decoration: none;
    transition: background var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .author-band a:hover {
    background: var(--brand-primary);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 760px) {
    .author-band {
      padding-inline: var(--space-4);
    }

    .author-band__inner {
      grid-template-columns: 1fr;
    }

    .author-band__image {
      max-width: 24rem;
      width: 100%;
      margin: 0 auto;
      aspect-ratio: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .author-band__image img,
    .author-band a {
      transition: none;
    }
  }
</style>
