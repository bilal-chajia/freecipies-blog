---
import { extractImage } from '@shared/utils';
import type { HomepageAboutAuthorSection } from '@modules/settings/types/settings.types';
import type { Author } from '@modules/authors/schema/authors.schema';

interface Props {
  section: HomepageAboutAuthorSection;
  author: Author | null;
}

const { author } = Astro.props;

const authorImage = author ? extractImage(author.images_json, 'avatar', 600) : null;
const authorImageUrl = authorImage?.image_url || '';
const authorName = author?.name || 'Our Chef';
const authorBio = author?.short_description || '';
const authorSlug = author?.slug || '';
---

{author && (
  <section class="section about-author-section">
    <div class="container">
      <div class="about-author-wrapper">
        <div class="about-author-image">
          {authorImageUrl ? (
            <img
              src={authorImageUrl}
              alt={authorName}
              width={authorImage?.imageWidth || 600}
              height={authorImage?.imageHeight || 600}
              loading="lazy"
              style={authorImage?.imageStyle || undefined}
            />
          ) : (
            <div class="about-author-placeholder">
              <span>{authorName.charAt(0)}</span>
            </div>
          )}
        </div>
        <div class="about-author-content">
          <span class="about-author-eyebrow">meet {authorName.split(' ')[0]?.toLowerCase()}</span>
          <h2 class="about-author-title">About the Author</h2>
          <p class="about-author-bio">{authorBio}</p>
          <a href={`/authors/${authorSlug}`} class="about-author-link">
            About {authorName.split(' ')[0]} →
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  .section {
    padding: clamp(var(--space-12), 7vw, 5.5rem) 0;
  }

  /* === About the Author Section === */
  .about-author-section {
    background: linear-gradient(180deg, var(--brand-primary-light) 0%, var(--bg) 100%);
    padding: var(--space-16) 0;
  }

  .about-author-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(var(--space-8), 5vw, var(--space-14));
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
  }

  .about-author-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4/5;
    box-shadow: var(--shadow-xl);
  }

  .about-author-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .about-author-image:hover img {
    transform: scale(1.03);
  }

  .about-author-placeholder {
    width: 100%;
    height: 100%;
    background: var(--brand-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-inverse);
    font-size: var(--text-5xl);
    font-weight: var(--font-bold);
  }

  .about-author-content {
    padding: var(--space-5) 0;
  }

  .about-author-eyebrow {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--primary);
    margin-bottom: var(--space-2);
    letter-spacing: 0.5px;
  }

  .about-author-title {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl));
    font-weight: var(--font-extrabold);
    color: var(--text);
    letter-spacing: 0;
    margin: 0 0 var(--space-5);
    line-height: var(--leading-tight);
  }

  .about-author-bio {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text);
    margin: 0 0 var(--space-7);
    font-style: italic;
    max-width: 420px;
  }

  .about-author-link {
    display: inline-block;
    background: var(--text);
    color: var(--text-inverse);
    padding: var(--space-3.5) var(--space-8);
    text-decoration: none;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: var(--transition);
  }

  .about-author-link:hover {
    background: var(--primary);
    transform: translateY(calc(-0.5 * var(--space-1)));
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 768px) {
    .about-author-wrapper {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-author-image {
      max-width: 400px;
      margin: 0 auto;
      aspect-ratio: 1;
    }

    .about-author-bio {
      max-width: 100%;
      margin-inline: auto;
    }

    .about-author-content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
</style>
