---
import { extractImage, getImageSrcSet } from '@shared/utils';
import type { HomepageCollectionsSection } from '@modules/settings/types/settings.types';
import type { HydratedArticle } from '@modules/articles/types';

interface Props {
  section: HomepageCollectionsSection;
  roundups: HydratedArticle[];
}

const { section, roundups } = Astro.props;

const getRecipeImage = (recipe: HydratedArticle, targetWidth: number, prefer: 'hero' | 'thumbnail' = 'hero') => {
  const hero = extractImage(recipe.images_json, 'hero', targetWidth);
  const thumbnail = extractImage(recipe.images_json, 'thumbnail', targetWidth);
  const slotName = prefer === 'hero'
    ? (hero.image_url ? 'hero' : 'thumbnail')
    : (thumbnail.image_url ? 'thumbnail' : 'hero');
  const selected = slotName === 'hero' ? hero : thumbnail;
  const srcSet = getImageSrcSet(recipe.images_json, slotName);
  return { selected, srcSet };
};

const getRoundupUrl = (roundup: HydratedArticle) => roundup.route || `/roundups/${roundup.slug}`;
---

{roundups.length > 0 && (
  <section class="section collections-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">
          <span class="title-dot"></span>
          {section.title}
        </h2>
      </div>
      <div class="collections-grid">
        {roundups.map((roundup: HydratedArticle) => {
          const { selected, srcSet } = getRecipeImage(roundup, 400, 'hero');
          const sizes = '(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 25vw';
          return (
            <article class="foxiz-card">
              <a href={getRoundupUrl(roundup)} class="foxiz-card-image">
                {(selected.image_url || roundup.image_url) && (
                  <img
                    src={selected.image_url || roundup.image_url}
                    alt={selected.imageAlt || roundup.imageAlt || roundup.headline}
                    width={selected.imageWidth || roundup.imageWidth || 400}
                    height={selected.imageHeight || roundup.imageHeight || 300}
                    srcset={srcSet || undefined}
                    sizes={srcSet ? sizes : undefined}
                    loading="lazy"
                    style={selected.imageStyle || undefined}
                  />
                )}
                <span
                  class="badge foxiz-badge"
                  style={`--badge-color: ${roundup.category?.color || 'var(--brand-primary)'};`}
                >
                  {roundup.category?.label}
                </span>
              </a>
              <div class="foxiz-card-body">
                <h3 class="foxiz-card-title">
                  <a href={getRoundupUrl(roundup)}>{roundup.headline}</a>
                </h3>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  .section {
    padding: clamp(var(--space-12), 7vw, 5.5rem) 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 1.25rem + 1.2vw, 2.35rem);
    font-weight: var(--font-bold);
    color: var(--text);
    margin: 0;
    letter-spacing: 0;
  }

  .title-dot {
    display: inline-block;
    width: var(--space-2);
    height: var(--space-2);
    background: var(--brand-primary);
    border-radius: var(--radius-full);
    margin-right: var(--space-2);
    vertical-align: middle;
  }

  .collections-section {
    background: var(--bg);
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
    gap: clamp(var(--space-4), 3vw, var(--space-6));
  }

  /* === Foxiz-style Cards === */
  .foxiz-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .foxiz-card:hover {
    transform: translateY(calc(-1 * var(--space-1)));
    box-shadow: var(--shadow-hover);
  }

  .foxiz-card-image {
    position: relative;
    display: block;
    border-radius: 0;
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .foxiz-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .foxiz-card:hover .foxiz-card-image img {
    transform: scale(1.05);
  }

  .foxiz-badge {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    background: linear-gradient(
        rgba(0, 0, 0, 0.35),
        rgba(0, 0, 0, 0.35)
      ),
      var(--badge-color, var(--brand-primary));
  }

  .foxiz-card-body {
    padding: var(--space-4);
  }

  .foxiz-card-title {
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    line-height: var(--leading-snug);
    margin: 0;
    color: var(--text);
  }

  .foxiz-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .foxiz-card-title a:hover {
    color: var(--primary);
  }
</style>
