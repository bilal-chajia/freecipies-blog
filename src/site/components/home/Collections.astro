---
import { extractImage, getImageSrcSet } from '@shared/utils';
import type { HomepageCollectionsSection } from '@modules/settings/types/settings.types';
import type { HydratedArticle } from '@modules/articles/types';

interface Props {
  section: HomepageCollectionsSection;
  roundups: HydratedArticle[];
}

const { section, roundups } = Astro.props;
const hasCarousel = roundups.length > 1;

const getRoundupImage = (roundup: HydratedArticle, targetWidth: number) => {
  const hero = extractImage(roundup.images_json, 'hero', targetWidth);
  const thumbnail = extractImage(roundup.images_json, 'thumbnail', targetWidth);
  const slotName = hero.image_url ? 'hero' : 'thumbnail';
  const selected = hero.image_url ? hero : thumbnail;
  const srcSet = getImageSrcSet(roundup.images_json, slotName);
  return { selected, srcSet };
};

const getRoundupUrl = (roundup: HydratedArticle) => roundup.route || `/roundups/${roundup.slug}`;
---

{roundups.length > 0 && (
  <section class="home-collections" data-fade-up>
    <div class="home-collections__inner">
      <div class="home-collections__header">
        <div>
          <h2>{section.title}</h2>
          {section.subtitle && <p>{section.subtitle}</p>}
        </div>
        {hasCarousel && (
          <div class="home-collections__controls" aria-label={`${section.title} carousel controls`}>
            <button type="button" data-home-carousel-prev aria-label={`Previous ${section.title}`}>←</button>
            <button type="button" data-home-carousel-next aria-label={`Next ${section.title}`}>→</button>
          </div>
        )}
      </div>

      <div class="home-collections__carousel" data-home-carousel={hasCarousel ? 'slide' : undefined}>
        <div class="home-collections__viewport" data-home-carousel-viewport={hasCarousel ? '' : undefined}>
          <div class="home-collections__track">
            {roundups.map((roundup: HydratedArticle, index: number) => {
              const { selected, srcSet } = getRoundupImage(roundup, 760);
              return (
                <article class="collection-card" style={`--stagger: ${index};`}>
                  <a href={getRoundupUrl(roundup)} class="collection-card__link">
                    <div class="collection-card__media">
                      {(selected.image_url || roundup.image_url) && (
                        <img
                          src={selected.image_url || roundup.image_url}
                          alt={selected.imageAlt || roundup.imageAlt || roundup.headline}
                          width={selected.imageWidth || roundup.imageWidth || 760}
                          height={selected.imageHeight || roundup.imageHeight || 520}
                          srcset={srcSet || undefined}
                          sizes={srcSet ? '(max-width: 700px) 88vw, (max-width: 1100px) 48vw, 38vw' : undefined}
                          loading="lazy"
                          style={selected.imageStyle || undefined}
                        />
                      )}
                    </div>
                    <div class="collection-card__content">
                      {roundup.category?.label && <span>{roundup.category.label}</span>}
                      <h3>{roundup.headline}</h3>
                      {roundup.short_description && <p>{roundup.short_description}</p>}
                    </div>
                  </a>
                </article>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .home-collections {
    padding: clamp(var(--space-10), 7vw, var(--space-16)) var(--space-5);
    background:
      linear-gradient(180deg, transparent, color-mix(in srgb, var(--brand-secondary-light) 28%, transparent)),
      var(--bg);
  }

  .home-collections__inner {
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .home-collections__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .home-collections h2 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 1.35rem + 1.5vw, 2.75rem);
    line-height: var(--leading-tight);
    letter-spacing: 0;
  }

  .home-collections__header p {
    max-width: 38rem;
    margin: var(--space-2) 0 0;
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .home-collections__controls {
    display: flex;
    gap: var(--space-2);
  }

  .home-collections__controls button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--bg-elevated);
    color: var(--text);
    cursor: pointer;
    transition: background var(--transition-fast), transform var(--transition-fast), opacity var(--transition-fast);
  }

  .home-collections__controls button:hover:not(:disabled) {
    background: var(--brand-secondary);
    color: var(--text-inverse);
    transform: translateY(-1px);
  }

  .home-collections__controls button:disabled {
    opacity: 0.42;
    cursor: default;
  }

  .home-collections__viewport {
    overflow: hidden;
  }

  .home-collections__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(22rem, 39%);
    gap: clamp(var(--space-4), 2vw, var(--space-6));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .home-collections__track::-webkit-scrollbar {
    display: none;
  }

  .collection-card {
    min-width: 0;
    scroll-snap-align: start;
  }

  .collection-card__link {
    position: relative;
    display: grid;
    min-height: 25rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border) 84%, transparent);
    border-radius: var(--radius-xl);
    color: var(--text-inverse);
    text-decoration: none;
    box-shadow: var(--shadow-md);
    isolation: isolate;
  }

  .collection-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.74), rgba(0, 0, 0, 0.12) 68%);
  }

  .collection-card__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .collection-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .collection-card__link:hover .collection-card__media img {
    transform: scale(1.045);
  }

  .collection-card__content {
    align-self: end;
    padding: var(--space-6);
  }

  .collection-card__content span {
    display: inline-flex;
    margin-bottom: var(--space-3);
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
  }

  .collection-card h3 {
    margin: 0;
    max-width: 14ch;
    color: var(--text-inverse);
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 1.1rem + 1vw, 2.25rem);
    line-height: var(--leading-tight);
  }

  .collection-card p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    max-width: 28rem;
    margin: var(--space-3) 0 0;
    color: rgba(255, 255, 255, 0.84);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 900px) {
    .home-collections__track {
      grid-auto-columns: minmax(18rem, 62%);
    }
  }

  @media (max-width: 640px) {
    .home-collections {
      padding-inline: var(--space-4);
    }

    .home-collections__header {
      align-items: start;
      flex-direction: column;
    }

    .home-collections__track {
      grid-auto-columns: 88%;
    }

    .collection-card__link {
      min-height: 23rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-collections__controls button,
    .collection-card__media img {
      transition: none;
    }
  }
</style>
