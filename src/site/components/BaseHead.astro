---
import type { ImageMetadata } from "astro";
import { SITE_TITLE } from "../../consts";

// Default fallback image URL (used when no image is provided)
const FALLBACK_IMAGE_URL =
  "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=1200&h=630&fit=crop";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  noindex?: boolean;
}

const siteUrl = Astro.site?.toString() || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const { title, description, image, noindex } = Astro.props;
const imageSrc = image
  ? typeof image === "string"
    ? image
    : image.src
  : FALLBACK_IMAGE_URL;
const image_url = new URL(imageSrc, siteUrl);

// Preconnect to the image origin (R2 public bucket / CDN) when it differs from
// the site origin — resolves DNS/TLS early to speed up the LCP hero image.
const siteOrigin = new URL(siteUrl).origin;
const imageOrigin =
  image_url.origin !== siteOrigin ? image_url.origin : undefined;

// Static asset configuration (assumes existence based on project standard)
const hasFaviconSvg = true;
const hasFavicon32 = true;
const hasFavicon16 = true;
const hasAppleTouch = true;
const hasManifest = true;
const hasRootFavicon = false; // We prefer logos/* structure
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Theme Color - System Integration -->
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)" />

<!-- Favicons - use uploaded if available, otherwise fallback -->
{
  hasFaviconSvg ? (
    <link rel="icon" type="image/svg+xml" href="/logos/favicon.svg" />
  ) : hasRootFavicon ? (
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  ) : null
}

{
  hasFavicon32 && (
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/logos/favicon-32x32.png"
    />
  )
}
{
  hasFavicon16 && (
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/logos/favicon-16x16.png"
    />
  )
}
{
  hasAppleTouch && (
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/logos/apple-touch-icon.png"
    />
  )
}
{hasManifest && <link rel="manifest" href="/logos/site.webmanifest" />}

<link rel="sitemap" href={new URL("sitemap-index.xml", siteUrl)} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", siteUrl)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Image CDN preconnect - resolves DNS/TLS early to speed up the LCP image -->
{imageOrigin && <link rel="preconnect" href={imageOrigin} crossorigin />}

<!-- Self-hosted fonts — preload critical above-the-fold woff2 (latin subset).
     @font-face declarations live in styles/fonts.css; files in /public/fonts.
     crossorigin is required on font preloads even same-origin (CORS fetch). -->
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/source-sans-3-latin-wght-normal.woff2"
  crossorigin
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/playfair-display-latin-wght-normal.woff2"
  crossorigin
/>
<!-- Enable smooth scroll only AFTER the page has settled (avoids hash-anchor vibration) -->
<script>
  window.addEventListener("load", function () {
    // Small delay to ensure the browser has finished any initial hash scroll
    setTimeout(function () {
      document.documentElement.style.scrollBehavior = "smooth";
    }, 100);
  });
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image_url} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image_url} />
