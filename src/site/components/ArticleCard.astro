---
import type { HydratedArticle } from "@modules/articles";
import { extractImage, getImageSrcSet } from "@shared/utils";
import RatingSystem from "./content/RatingSystem";
import { parseCachedRecipe, parseCachedRating } from "@modules/articles/utils/cached-fields";
import FormattedDate from "./FormattedDate.astro";


interface Props {
  article: HydratedArticle;
  loading?: "lazy" | "eager";
  cardStyle?: "full" | "compact" | "minimal";
  layoutMode?: "grid" | "list" | "masonry";
}

const { article, loading = "lazy", cardStyle = "full", layoutMode = "grid" } = Astro.props;
const isCompact = cardStyle === "compact";
const isMinimal = cardStyle === "minimal";
const isList = layoutMode === "list";

const thumbnail = extractImage(article.images_json, "thumbnail", 720);
const hero = extractImage(article.images_json, "hero", 720);
const slotName = thumbnail.image_url ? "thumbnail" : "hero";
const selected = thumbnail.image_url ? thumbnail : hero;
const srcSet = getImageSrcSet(article.images_json, slotName);
const sizes = "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 360px";
const listSizes = "(max-width: 768px) 100vw, 320px";
const image = {
  url:
    selected.image_url ||
    article.image_url ||
    "https://images.unsplash.com/photo-1495521821757-a1efb6729352?w=800&q=80",
  alt: selected.imageAlt || article.imageAlt || article.headline,
  width: selected.imageWidth || article.imageWidth || 800,
  height: selected.imageHeight || article.imageHeight || 600,
  style: selected.imageStyle,
};

const cachedRecipe = parseCachedRecipe(article.cached_recipe_json);
const cachedRating = parseCachedRating(article.cached_rating_json);

const ratingValue = cachedRating?.rating_value ?? cachedRating?.ratingValue ?? null;
const ratingCount = cachedRating?.rating_count ?? cachedRating?.ratingCount ?? 0;
const hasRating = ratingValue !== null && ratingCount > 0;

const prep = cachedRecipe?.prep_time_minutes ?? cachedRecipe?.prepTimeMinutes ?? null;
const recipe = cachedRecipe ? { prep } : null;
const authorLabel = article.authorName || article.authorSlug || "Unknown";
const showBookmark = article.type === "recipe";
---

{isList ? (
  <article class="recipe-list-card">
    <a href={article.route} class="list-image">
      <img
        src={image.url}
        alt={image.alt || article.headline}
        width={image.width || 800}
        height={image.height || 600}
        srcset={srcSet || undefined}
        sizes={srcSet ? listSizes : undefined}
        loading={loading}
        decoding="async"
        style={image.style || undefined}
        class="list-image-img"
      />
      {showBookmark && (
        <button
          type="button"
          class="bookmark-chip"
          data-bookmark-button
          data-bookmark-slug={article.slug}
          aria-pressed="false"
          aria-label="Bookmark recipe"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4a2 2 0 012-2h8a2 2 0 012 2v18l-6-4-6 4V4z" />
          </svg>
        </button>
      )}
    </a>
    <div class="list-content">
      <h3 class="list-title">{article.headline}</h3>
      <div class="list-divider"></div>
      <p class="list-excerpt">{article.short_description}</p>
      <div class="list-meta">
        <div class="list-meta-left">
          <span class="meta-item">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5z"
              />
            </svg>
            <span>{authorLabel}</span>
          </span>
          <span class="meta-item">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V3a1 1 0 0 1 1-1zm12 8H5v8h14z"
              />
            </svg>
            <FormattedDate date={article.published_at || article.created_at || undefined} />
          </span>
        </div>
        <div class="list-rating">
          <RatingSystem
            client:visible
            article_id={article.id}
            initialValue={ratingValue || 0}
            initialCount={ratingCount || 0}
            size="sm"
          />
        </div>
      </div>
    </div>
  </article>
) : (
  <article
    class="group bg-[var(--bg-elevated)] rounded-2xl overflow-hidden shadow-[0_2px_15px_rgba(0,0,0,0.04)] ring-1 ring-[var(--border-subtle)] transition-all duration-300 transform hover:-translate-y-1 flex flex-col h-full"
  >
    <a href={article.route} class="block relative aspect-[4/3] overflow-hidden">
      <!-- Image -->
      <img
        src={image.url}
        alt={image.alt || article.headline}
        width={image.width || 800}
        height={image.height || 600}
        srcset={srcSet || undefined}
        sizes={srcSet ? sizes : undefined}
        loading={loading}
        decoding="async"
        style={image.style || undefined}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
      />
      
      <!-- Favorite Badge -->
      {
        article.is_favorite && (
          <div class="absolute top-3 left-3 bg-[var(--brand-primary)] text-white px-3 py-1.5 rounded-full text-[10px] uppercase font-bold tracking-[0.05em] flex items-center gap-1.5 z-10 shadow-sm">
            <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
            </svg>
            <span>Featured</span>
          </div>
        )
      }
      
      <!-- Bookmark -->
      {showBookmark && (
        <button
          type="button"
          class="absolute top-3 right-3 flex items-center justify-center w-11 h-11 rounded-full bg-[var(--bg-elevated)]/95 text-[var(--text-secondary)] shadow-sm hover:scale-110 hover:text-[#ff3b5c] transition-all z-10"
          data-bookmark-button
          data-bookmark-slug={article.slug}
          aria-pressed="false"
          aria-label="Bookmark recipe"
        >
          <svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
        </button>
      )}
    </a>

    <!-- Info -->
    <div class:list={["flex-grow flex flex-col", isMinimal || isCompact ? "p-4" : "p-5"]}>
      <!-- Category & Time Row -->
      <div class:list={["flex items-center gap-2", isMinimal || isCompact ? "mb-2.5" : "mb-3"]}>
        <span
          class="text-[10px] font-bold uppercase tracking-[0.05em] px-2 py-1 rounded bg-opacity-10"
          style={`color: ${article.categoryColor || "#4f46e5"}; background-color: ${article.categoryColor ? article.categoryColor + "1A" : "#4f46e51A"};`}
        >
          {article.categoryLabel || article.categorySlug?.replace(/-/g, " ") || "Uncategorized"}
        </span>
        
        {recipe && recipe.prep && (
          <>
            <span class="text-[var(--border-strong)] text-[10px]">•</span>
            <span class="text-[12px] text-[var(--text-tertiary)]">{`${recipe.prep} min`}</span>
          </>
        )}
      </div>

      <!-- Title -->
      <a href={article.route} class="block group/title focus:outline-none focus:ring-2 focus:ring-[var(--brand-primary)] rounded-sm mb-2">
        <h3
          class:list={[
            "font-serif font-medium text-[var(--text)] line-clamp-3 leading-[1.3] group-hover/title:text-[var(--brand-primary)] transition-colors tracking-tight",
            isMinimal || isCompact ? "text-lg" : "text-xl",
          ]}
        >
          {article.headline}
        </h3>
      </a>

      <!-- Rating (Grid View) -->
      <div class="mb-4">
        <RatingSystem
          client:visible
          article_id={article.id}
          initialValue={ratingValue || 0}
          initialCount={ratingCount || 0}
          size="sm"
        />
      </div>


      <!-- Meta Info Footer -->
      <div
        class:list={[
          "flex items-center justify-between text-[var(--text-tertiary)] pt-3.5 mt-auto border-t border-[var(--border)]",
          isCompact ? "text-[11px]" : "text-[12px] font-medium",
        ]}
      >
        <!-- Date -->
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>{new Date(article.published_at || article.created_at || new Date().toISOString()).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
        </div>
        
        <!-- Read Time -->
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{article.reading_time_minutes ? `${article.reading_time_minutes} min read` : '4 min read'}</span>
        </div>
      </div>
    </div>
  </article>
)}

<style>
  /* ===== LIST CARD LAYOUT ===== */
  .recipe-list-card {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  /* Horizontal layout at wider widths.
     NOTE: We use @media here (not @container on self) because CSS
     container queries cannot style the container element itself —
     only descendants. The card is always full-width of its parent,
     so a media query is equivalent. */
  @media (min-width: 640px) {
    .recipe-list-card {
      grid-template-columns: 220px 1fr;
    }

    .list-content {
      border-left: 1px solid var(--border);
      border-top: 0;
    }

    .recipe-list-card:has(.list-rating) .list-image {
      min-height: 240px;
    }
  }

  @media (min-width: 768px) {
    .list-title {
      font-size: 1.15rem;
    }

    .list-content {
      padding: 1.5rem 2rem;
    }
  }

  /* :has() selector - Card with bookmark styling */
  .recipe-list-card:has(.bookmark-chip) .list-image {
    --bookmark-offset: 3rem;
  }

  /* :has() selector - Card with rating gets accent border */
  .recipe-list-card:has(.list-rating) {
    border-left: 3px solid var(--accent-sage);
  }

  /* :has() selector - Excerpt truncation based on content */
  .list-content:has(.list-rating) .list-excerpt {
    -webkit-line-clamp: 1;
  }

  .list-image {
    display: block;
    position: relative;
    height: 100%;
    min-height: 140px;
    max-height: 200px;
    overflow: hidden;
  }

  article:has(a):hover .list-image-img {
    transform: scale(1.02);
  }

  .list-image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .bookmark-chip {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--bg-overlay);
    color: var(--text-inverse);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25);
    pointer-events: auto;
    border: none;
    z-index: 2;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .recipe-list-card:hover:has(.bookmark-chip) .bookmark-chip {
    transform: scale(1.1);
  }

  .bookmark-chip svg {
    width: 18px;
    height: 18px;
  }

  .bookmark-chip[data-bookmarked="true"] {
    background: var(--bg-elevated);
    color: var(--text);
  }

  .list-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
  }

  .list-title {
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text);
    margin: 0;
  }

  .list-divider {
    width: 42px;
    height: 3px;
    background: var(--accent-sage);
  }

  .list-excerpt {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .list-meta {
    margin-top: 0.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .list-meta-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .meta-item svg {
    width: 16px;
    height: 16px;
    fill: var(--text-tertiary);
  }

  .list-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-sage);
    font-size: 0.85rem;
  }

  .list-stars {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .rating-star {
    width: 14px;
    height: 14px;
    fill: var(--border);
  }

  .rating-star.is-active {
    fill: var(--accent-sage);
  }

  .rating-text {
    color: var(--text-secondary);
  }
</style>
