---
/**
 * ThemeToggle — Bouton de basculement clair/sombre
 * Persiste la préférence via localStorage + cookie (évite le FOUC)
 */
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-label="Basculer entre le mode clair et sombre"
  title="Changer de thème"
>
  <span class="theme-toggle__icon" id="theme-icon">
    <!-- Sun icon (visible en mode clair) -->
    <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" x2="12" y1="1" y2="3"/><line x1="12" x2="12" y1="21" y2="23"/><line x1="4.22" x2="5.64" y1="4.22" y2="5.64"/><line x1="18.36" x2="19.78" y1="18.36" y2="19.78"/><line x1="1" x2="3" y1="12" y2="12"/><line x1="21" x2="23" y1="12" y2="12"/><line x1="4.22" x2="5.64" y1="19.78" y2="18.36"/><line x1="18.36" x2="19.78" y1="5.64" y2="4.22"/></svg>
    <!-- Moon icon (visible en mode sombre) -->
    <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  </span>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-10);
    height: var(--space-10);
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .theme-toggle:hover {
    background: var(--bg-hover);
    border-color: var(--border-strong);
    color: var(--text);
    transform: scale(1.05);
  }

  .theme-toggle:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .theme-toggle__icon {
    position: relative;
    width: var(--space-5);
    height: var(--space-5);
  }

  .theme-toggle__icon svg {
    position: absolute;
    inset: 0;
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  /* Par défaut (mode clair) : soleil visible, lune cachée */
  .icon-sun {
    opacity: 1;
    transform: rotate(0deg);
  }

  .icon-moon {
    opacity: 0;
    transform: rotate(-90deg);
  }

  /* Mode sombre : lune visible, soleil caché */
  html.dark .icon-sun {
    opacity: 0;
    transform: rotate(90deg);
  }

  html.dark .icon-moon {
    opacity: 1;
    transform: rotate(0deg);
  }
</style>

<script is:inline>
  // Script inline exécuté immédiatement pour éviter le FOUC
  (function() {
    const toggle = document.getElementById('theme-toggle');
    const html = document.documentElement;

    if (!toggle) return;

    toggle.addEventListener('click', function() {
      const isDark = html.classList.toggle('dark');
      const theme = isDark ? 'dark' : 'light';
      localStorage.setItem('theme', theme);
      // Cookie pour éviter le FOUC au SSR
      document.cookie = 'theme=' + theme + ';path=/;max-age=31536000;sameSite=lax';
    });
  })();
</script>