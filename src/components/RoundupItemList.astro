---
import { createDb } from "@shared/database/drizzle";
import { articles } from "@modules/articles/schema/articles.schema";
import { inArray } from "drizzle-orm";
import type {
  RoundupJson,
  RoundupItem,
} from "@modules/articles/types/roundups.types";
import {
  extractImage,
  getImageSrcSet,
  hydrateArticles,
} from "@shared/utils/hydration";

interface Props {
  roundup?: any; // Leaving for legacy
  block?: any; // New block format
  db: any;
  startNumber?: number;
}

const { roundup: rawRoundup, block, db, startNumber = 1 } = Astro.props;

// Parse roundup if it's a string (Legacy support)
let items = [];
let groupTitle = "";
let groupDescription = "";
let showStats = true;

if (block) {
  // New block-based logic
  const props = block.props || {};
  items =
    typeof props.itemsJson === "string"
      ? JSON.parse(props.itemsJson)
      : props.items || [];
  groupTitle = props.title || "";
  groupDescription = props.description || "";
  showStats = props.showStats !== false;
} else {
  // Legacy roundupJson support
  const roundup: RoundupJson =
    typeof rawRoundup === "string"
      ? JSON.parse(rawRoundup)
      : rawRoundup || { listType: "ItemList", items: [] };
  items = (roundup.items || []).sort(
    (a, b) => (a.position || 0) - (b.position || 0),
  );
}

if (!items || items.length === 0) return null;

// 1. Get all internal article IDs
const internalIds = items
  .filter((item: any) => item.articleId || item.article_id)
  .map((item: any) => (item.articleId || item.article_id) as number);

// 2. Fetch those articles if any for real-time data
let internalData = new Map<number, any>();
if (internalIds.length > 0) {
  try {
    const drizzle = createDb(db);
    const results = await drizzle
      .select({
        id: articles.id,
        slug: articles.slug,
        headline: articles.headline,
        subtitle: articles.subtitle,
        excerpt: articles.excerpt,
        imagesJson: articles.imagesJson,
        type: articles.type,
        authorId: articles.authorId,
        categoryId: articles.categoryId,
        totalTimeMinutes: articles.totalTimeMinutes,
        difficultyLabel: articles.difficultyLabel,
        cachedRatingJson: articles.cachedRatingJson,
      })
      .from(articles)
      .where(inArray(articles.id, internalIds));

    const hydrated = hydrateArticles(results as any[]);
    hydrated.forEach((a) => internalData.set(a.id, a));
  } catch (e) {
    console.error("RoundupItemList: Failed to fetch internal articles", e);
  }
}
---

<div class="roundup-container">
  {
    groupTitle && (
      <div class="group-header">
        <h2 class="group-title">{groupTitle}</h2>
        {groupDescription && (
          <p class="group-description">{groupDescription}</p>
        )}
      </div>
    )
  }

  {
    items.map((item: any, index: number) => {
      // Determine data source
      const aId = item.articleId || item.article_id;
      const isInternal = !!aId;
      const article = isInternal ? internalData.get(aId) : null;
      const position = startNumber + index;

      // Resolve link
      const href =
        isInternal && article
          ? article.type === "recipe"
            ? `/recipes/${article.slug}`
            : `/articles/${article.slug}`
          : item.external_url || "#";

      // Resolve content (prefer manual item title/subtitle/note, fallback to article)
      const title = item.title || article?.headline || "Untitled";
      const subtitle =
        item.subtitle || article?.subtitle || article?.excerpt || "";
      const note = item.note || "";

      // Resolve image
      // 1. Item-specific cover (if provided)
      // 2. Article thumbnail or cover
      let imgData: any = {};
      let srcSet = "";

      if (item.cover?.variants) {
        // Manual cover from roundup item
        const slots = { thumbnail: item.cover };
        imgData = extractImage(JSON.stringify(slots), "thumbnail", 800);
        srcSet = getImageSrcSet(JSON.stringify(slots), "thumbnail");
      } else if (article) {
        // Fallback to article images
        imgData = extractImage(article.imagesJson, "thumbnail", 800);
        srcSet = getImageSrcSet(article.imagesJson, "thumbnail");
        // If no thumbnail, try cover
        if (!imgData.imageUrl) {
          imgData = extractImage(article.imagesJson, "cover", 800);
          srcSet = getImageSrcSet(article.imagesJson, "cover");
        }
      }

      return (
        <div class="roundup-item-card" id={`item-${position}`}>
          <div class="item-header">
            <div class="position-badge">{position}</div>
            <h3 class="item-title">
              <a href={href}>{title}</a>
            </h3>
          </div>

          {imgData.imageUrl && (
            <div class="item-media">
              <a href={href} class="media-link">
                <img
                  src={imgData.imageUrl}
                  alt={imgData.imageAlt || title}
                  width={imgData.imageWidth}
                  height={imgData.imageHeight}
                  srcset={srcSet || undefined}
                  sizes="(max-width: 768px) calc(100vw - 2rem), min(800px, 100vw - 4rem)"
                  loading="lazy"
                  decoding="async"
                  style={imgData.imageStyle}
                />
              </a>
            </div>
          )}

          <div class="item-content">
            {subtitle && <p class="item-subtitle">{subtitle}</p>}

            {note && (
              <div class="item-note">
                <div class="note-label">Our Take:</div>
                <p class="note-text">{note}</p>
              </div>
            )}

            <div class="item-actions">
              <a href={href} class="btn-primary">
                {isInternal ? "Get the Recipe" : "Read More"}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                  </>
                </svg>
              </a>
            </div>
          </div>
        </div>
      );
    })
  }
</div>

<style>
  .roundup-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin: 3rem 0;
  }

  .group-header {
    margin-bottom: -1rem;
    border-left: 8px solid #111;
    padding-left: 1.5rem;
  }

  .group-title {
    font-size: clamp(1.75rem, 6vw, 2.75rem);
    font-weight: 900;
    line-height: 1.1;
    margin: 0;
    font-family: "Playfair Display", Georgia, serif;
    letter-spacing: -0.02em;
  }

  .group-description {
    font-size: 1.125rem;
    color: #4b5563;
    line-height: 1.6;
    margin-top: 1rem;
    max-width: 60ch;
  }

  .roundup-item-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #eee;
  }

  .roundup-item-card:last-child {
    border-bottom: none;
  }

  .item-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .position-badge {
    width: 48px;
    height: 48px;
    background: #ff6600;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 800;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(255, 102, 0, 0.25);
  }

  .item-title {
    margin: 0;
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    font-family: "Playfair Display", Georgia, serif;
  }

  .item-title a {
    text-decoration: none;
    color: #111;
    transition: color 0.2s;
  }

  .item-title a:hover {
    color: #ff6600;
  }

  .item-media {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .media-link {
    display: block;
    aspect-ratio: 16/9;
  }

  .item-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .roundup-item-card:hover .item-media img {
    transform: scale(1.03);
  }

  .item-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .item-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #4b5563;
    margin: 0;
  }

  .item-note {
    background: #fff8f1;
    border-left: 4px solid #ff6600;
    padding: 1.5rem;
    border-radius: 0 8px 8px 0;
  }

  .note-label {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #ff6600;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .note-text {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #374151;
    font-style: italic;
  }

  .item-actions {
    margin-top: 0.5rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #111;
    color: white;
    padding: 0.875rem 2rem;
    border-radius: 100px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  .btn-primary:hover {
    background: #ff6600;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 102, 0, 0.3);
  }

  .btn-primary svg {
    transition: transform 0.2s;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  /* Dark mode */
  :global(.dark) .item-title a {
    color: #f3f4f6;
  }
  :global(.dark) .item-subtitle {
    color: #9ca3af;
  }
  :global(.dark) .item-note {
    background: rgba(255, 102, 0, 0.05);
  }
  :global(.dark) .note-text {
    color: #d1d5db;
  }
  :global(.dark) .btn-primary {
    background: #ff6600;
  }
  :global(.dark) .btn-primary:hover {
    background: #e65c00;
  }
</style>
