---
import type { HydratedArticle } from "@modules/articles";
import ArticleCard from "./ArticleCard.astro";

interface Props {
  articles: HydratedArticle[];
  layoutMode?: "grid" | "list" | "masonry";
  cardStyle?: "full" | "compact" | "minimal";
}

const { articles, layoutMode = "grid", cardStyle = "full" } = Astro.props;

const layoutClass =
  layoutMode === "list"
    ? "recipe-list"
    : layoutMode === "masonry"
      ? "recipe-masonry"
      : "recipe-grid";
---

<div
  class:list={[
    layoutClass,
    `card-style-${cardStyle}`,
    "article-grid-container",
  ]}
>
  {
    articles.map((article, index) => (
      <ArticleCard
        article={article}
        cardStyle={cardStyle}
        layoutMode={layoutMode}
        loading={index === 0 ? "eager" : "lazy"}
      />
    ))
  }
</div>

<style>
  /* Container Query Setup */
  .article-grid-container {
    container-type: inline-size;
    container-name: article-grid;
  }

  /* Grid Layout (default) */
  .recipe-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* Container query for grid - responsive based on container width */
  @container article-grid (min-width: 640px) {
    .recipe-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @container article-grid (min-width: 1024px) {
    .recipe-grid {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    }
  }

  /* List Layout with container queries */
  .recipe-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @container article-grid (min-width: 768px) {
    .recipe-list {
      gap: 2rem;
    }
  }

  /* Masonry Layout */
  .recipe-masonry {
    columns: 1 280px;
    column-gap: 1.5rem;
  }

  @container article-grid (min-width: 640px) {
    .recipe-masonry {
      columns: 2 280px;
    }
  }

  @container article-grid (min-width: 1024px) {
    .recipe-masonry {
      columns: 3 280px;
    }
  }

  .recipe-masonry :global(article) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  /* :has() selector - Grid with featured first item */
  .recipe-grid:has(> :first-child.is-featured) {
    grid-template-columns: 1fr;
  }

  @container article-grid (min-width: 1024px) {
    .recipe-grid:has(> :first-child.is-featured) {
      grid-template-columns: 2fr 1fr;
      grid-template-rows: repeat(2, 1fr);
    }

    .recipe-grid:has(> :first-child.is-featured) > :first-child {
      grid-row: 1 / -1;
    }
  }

  /* Fallback for browsers without container query support */
  @supports not (container-type: inline-size) {
    @media (min-width: 640px) {
      .recipe-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .recipe-masonry {
        columns: 2 280px;
      }
    }

    @media (min-width: 1024px) {
      .recipe-grid {
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      }
      .recipe-masonry {
        columns: 3 280px;
      }
    }
  }
</style>
