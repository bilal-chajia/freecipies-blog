---
interface Props {
    title?: string;
    subtitle?: string;
}

const {
    title = "Keep Current at All Times",
    subtitle = "Subscribe to our newsletter to get our newest articles instantly!",
} = Astro.props;
---

<div class="newsletter-widget">
    <div class="widget-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" fill="#ff6b35"></circle>
            <path
                d="M8 12l2 2 4-4"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>
    </div>

    <h3 class="widget-title">{title}</h3>
    <p class="widget-subtitle">{subtitle}</p>

    <form class="subscribe-form" action="/api/subscribe" method="POST">
        <input
            type="email"
            name="email"
            placeholder="Your email address"
            required
            class="email-input"
        />
        <button type="submit" class="subscribe-btn"> Subscribe </button>
    </form>
</div>

<style>
    .newsletter-widget {
        position: relative;
        overflow: hidden;
        background: #0f172a;
        border-radius: 16px;
        padding: 2rem 1.5rem;
        text-align: center;
    }

    /* Decorative glow blobs */
    .newsletter-widget::before,
    .newsletter-widget::after {
        content: "";
        position: absolute;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(255, 107, 53, 0.15);
        filter: blur(60px);
        pointer-events: none;
    }

    .newsletter-widget::before {
        top: -30px;
        right: -20px;
    }

    .newsletter-widget::after {
        bottom: -30px;
        left: -20px;
    }

    .widget-icon {
        position: relative;
        z-index: 1;
        margin-bottom: 1rem;
    }

    .widget-icon svg {
        width: 48px;
        height: 48px;
        filter: drop-shadow(0 2px 8px rgba(255, 107, 53, 0.4));
    }

    .widget-title {
        position: relative;
        z-index: 1;
        font-size: 1.25rem;
        font-weight: 700;
        color: #fff;
        margin: 0 0 0.5rem;
        line-height: 1.3;
    }

    .widget-subtitle {
        position: relative;
        z-index: 1;
        font-size: 0.875rem;
        color: #94a3b8;
        margin: 0 0 1.5rem;
        line-height: 1.5;
    }

    .subscribe-form {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .email-input {
        width: 100%;
        padding: 0.875rem 1rem;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        color: #fff;
        font-size: 0.9375rem;
        transition: border-color 0.2s ease;
    }

    .email-input::placeholder {
        color: #64748b;
    }

    .email-input:focus {
        outline: none;
        border-color: #ff6b35;
        box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.15);
    }

    .subscribe-btn {
        width: 100%;
        padding: 0.875rem 1.5rem;
        background: linear-gradient(135deg, #ff3366 0%, #ff6b35 100%);
        border: none;
        border-radius: 12px;
        color: #fff;
        font-size: 0.9375rem;
        font-weight: 700;
        cursor: pointer;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
        box-shadow: 0 2px 12px rgba(255, 51, 102, 0.25);
    }

    .subscribe-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 51, 102, 0.35);
    }

    .subscribe-btn:focus-visible {
        outline: 2px solid white;
        outline-offset: 3px;
    }

    .subscribe-btn:active {
        transform: translateY(0);
    }
</style>

<script>
    document.querySelectorAll(".subscribe-form").forEach((form) => {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formEl = e.target as HTMLFormElement;
            const emailInput = formEl.querySelector(
                ".email-input",
            ) as HTMLInputElement;
            const submitBtn = formEl.querySelector(
                ".subscribe-btn",
            ) as HTMLButtonElement;

            if (!emailInput.value) return;

            const originalText = submitBtn.textContent;
            submitBtn.textContent = "Subscribing...";
            submitBtn.disabled = true;

            try {
                // Simulate subscription (replace with actual API call)
                await new Promise((resolve) => setTimeout(resolve, 1000));

                submitBtn.textContent = "Subscribed! ✓";
                submitBtn.style.background = "#10b981";
                emailInput.value = "";

                setTimeout(() => {
                    submitBtn.textContent = originalText;
                    submitBtn.style.background = "";
                    submitBtn.disabled = false;
                }, 3000);
            } catch (err) {
                submitBtn.textContent = "Error - Try again";
                submitBtn.style.background = "#ef4444";

                setTimeout(() => {
                    submitBtn.textContent = originalText;
                    submitBtn.style.background = "";
                    submitBtn.disabled = false;
                }, 2000);
            }
        });
    });
</script>
