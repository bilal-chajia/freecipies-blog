---
/**
 * InstructionsSection - Clean step-by-step instructions
 */

import type { InstructionSection } from '@modules/articles/types/recipes.types';

interface Props {
  instructions: InstructionSection[];
}

const { instructions } = Astro.props;

function formatTime(minutes: number): string {
  if (!minutes) return '';
  if (minutes < 60) return minutes + 'm';
  const hrs = Math.floor(minutes / 60);
  const mins = minutes % 60;
  return mins > 0 ? hrs + 'h ' + mins + 'm' : hrs + 'h';
}

let globalStep = 0;
---

<div class="instructions-list">
  {instructions.map((section, sectionIdx) => (
    <div class="instruction-section" data-section={sectionIdx}>
      {section.section_title && (
        <h3 class="section-title">{section.section_title}</h3>
      )}
      <ol class="steps-list" start={globalStep + 1}>
        {section.steps.map((step) => {
          const stepNumber = ++globalStep;
          return (
            <li class="step-item" id={`step-${stepNumber}`} data-step={stepNumber}>
              <div class="step-number">{stepNumber}</div>
              <div class="step-content">
                {step.name && <h4 class="step-name">{step.name}</h4>}
                <p class="step-text">{step.text}</p>
                {step.tip && (
                  <div class="step-tip">
                    <span class="tip-icon">💡</span>
                    <span>{step.tip}</span>
                  </div>
                )}
              </div>
              {step.timer && step.timer > 0 && (
                <button type="button" class="step-timer" data-timer={step.timer}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  {formatTime(step.timer)}
                </button>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  ))}
</div>

<style>
  .instructions-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .section-title {
    font-size: 18px;
    font-weight: 700;
    color: #374151;
    margin: 0 0 16px 0;
    padding-bottom: 8px;
    border-bottom: 2px solid #f97316;
    display: inline-block;
  }

  .steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .step-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 20px;
    background: #f9fafb;
    border-radius: 12px;
    scroll-margin-top: 100px;
    transition: all 0.2s;
  }

  .step-item:hover {
    background: #f3f4f6;
    transform: translateX(4px);
  }

  .step-item:target {
    background: #fff7ed;
    box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.2);
  }

  .step-number {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f97316;
    color: white;
    font-weight: 700;
    font-size: 16px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .step-content {
    flex: 1;
    min-width: 0;
  }

  .step-name {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 8px 0;
  }

  .step-text {
    font-size: 15px;
    line-height: 1.6;
    color: #374151;
    margin: 0;
  }

  .step-tip {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    padding: 12px 16px;
    background: #fff;
    border-radius: 8px;
    font-size: 14px;
    color: #92400e;
    border: 1px solid #fed7aa;
  }

  .tip-icon {
    flex-shrink: 0;
  }

  .step-timer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 10px 14px;
    background: #111827;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s;
  }

  .step-timer:hover {
    background: #374151;
    transform: scale(1.05);
  }

  .step-timer svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 640px) {
    .step-item {
      flex-wrap: wrap;
    }

    .step-timer {
      flex-direction: row;
      margin-left: 52px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-timer]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const minutes = parseInt(btn.getAttribute('data-timer') || '0');
        if (minutes > 0) {
          alert('Timer: ' + minutes + ' minutes (Timer feature coming soon!)');
        }
      });
    });
  });
</script>
