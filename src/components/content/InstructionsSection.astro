---
/**
 * InstructionsSection - Recipe instructions display component
 *
 * Renders grouped step-by-step instructions with numbered steps.
 * Supports both legacy string format and new object format.
 */

interface InstructionStep {
    text?: string;
}

interface InstructionGroup {
    group?: string;
    section_title?: string;
    steps?: (string | InstructionStep)[];
}

interface Props {
    instructions: InstructionGroup[] | null | undefined;
}

const { instructions } = Astro.props;

// Early return if no instructions
if (
    !instructions ||
    !Array.isArray(instructions) ||
    instructions.length === 0
) {
    return null;
}
---

<section class="content-section instructions-section">
    <h2>Instructions</h2>
    {
        instructions.map((group) => (
            <div class="instruction-group">
                {(group.section_title || group.group) && (
                    <h3>{group.section_title || group.group}</h3>
                )}
                <ol class="instruction-list">
                    {group.steps &&
                        Array.isArray(group.steps) &&
                        group.steps.map((step, index) => {
                            // Handle both legacy string format and new object format
                            const stepText =
                                typeof step === "string"
                                    ? step
                                    : step.text || "";
                            return (
                                <li>
                                    <span class="step-number">{index + 1}</span>
                                    <p>{stepText}</p>
                                </li>
                            );
                        })}
                </ol>
            </div>
        ))
    }
</section>

<style>
    .instructions-section h2 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1.5rem;
    }

    .instruction-group {
        margin-bottom: 2rem;
    }

    .instruction-group h3 {
        font-size: 1.1rem;
        font-weight: 600;
        color: #555;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #eee;
    }

    .instruction-list {
        list-style: none;
        padding: 0;
        margin: 0;
        counter-reset: none;
    }

    .instruction-list li {
        display: flex;
        gap: 1rem;
        padding: 1rem 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .instruction-list li:last-child {
        border-bottom: none;
    }

    .step-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        background: linear-gradient(135deg, #f97316, #ea580c);
        color: #fff;
        font-weight: 600;
        font-size: 0.875rem;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .instruction-list li p {
        flex: 1;
        margin: 0;
        line-height: 1.7;
        color: #444;
    }
</style>
