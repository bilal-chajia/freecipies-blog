---
/**
 * FAQSection - Premium Recipe Blog FAQ Accordion
 *
 * A modern accordion FAQ section with smooth animations.
 * Styled for recipe blogs: Playfair Display headings, Lora body text.
 */

interface FaqItem {
    q?: string;
    a?: string;
    question?: string;
    answer?: string;
}

interface Props {
    faqs: string | FaqItem[] | null | undefined;
    title?: string;
}

const { faqs: faqsInput, title = "Frequently Asked Questions" } = Astro.props;

const faqs: FaqItem[] = (() => {
    if (!faqsInput) return [];
    if (Array.isArray(faqsInput)) return faqsInput;
    if (typeof faqsInput === "string") {
        try {
            const parsed = JSON.parse(faqsInput);
            return Array.isArray(parsed) ? parsed : [];
        } catch {
            return [];
        }
    }
    return [];
})();

if (faqs.length === 0) {
    return null;
}
---

<section class="faq-section" id="faq-section">
    <div class="faq-header">
        <div class="faq-icon-badge">
            <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
        </div>
        <h2 class="faq-title">{title}</h2>
    </div>

    <div class="faq-list" id="faq-accordion">
        {
            faqs.map((faq, idx) => (
                <div class="faq-item" data-faq-item>
                    <button
                        class="faq-question"
                        type="button"
                        aria-expanded="false"
                    >
                        <span class="faq-q-text">
                            {faq.q || faq.question || ""}
                        </span>
                        <span class="faq-toggle">
                            <svg
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <line x1="12" y1="5" x2="12" y2="19" />
                                <line x1="5" y1="12" x2="19" y2="12" />
                            </svg>
                        </span>
                    </button>
                    <div class="faq-answer-wrapper">
                        <div class="faq-answer">
                            <p>{faq.a || faq.answer || ""}</p>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</section>

<style>
    .faq-section {
        margin: 3rem 0;
    }

    /* ── Header ── */
    .faq-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 1.5rem;
    }

    .faq-icon-badge {
        width: 44px;
        height: 44px;
        min-width: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2d6a4f;
        border-radius: 50%;
        color: #fff;
        box-shadow: 0 4px 12px rgba(45, 106, 79, 0.25);
    }

    .faq-title {
        font-family: "Playfair Display", Georgia, serif;
        font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem);
        font-weight: 700;
        color: #111827;
        margin: 0;
        padding: 0;
        border: none;
    }

    /* ── Accordion list ── */
    .faq-list {
        display: flex;
        flex-direction: column;
    }

    .faq-item {
        border-bottom: 1px solid #e5e7eb;
    }

    .faq-item:first-child {
        border-top: 1px solid #e5e7eb;
    }

    /* ── Question (Button) ── */
    .faq-question {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        width: 100%;
        cursor: pointer;
        padding: 1.15rem 0;
        background: none;
        border: none;
        text-align: left;
        user-select: none;
        transition: color 0.2s ease;
    }

    .faq-q-text {
        font-family: "Lora", Georgia, serif;
        font-size: clamp(0.975rem, 0.925rem + 0.2vw, 1.0625rem);
        font-weight: 600;
        color: #1f2937;
        line-height: 1.5;
        flex: 1;
    }

    .faq-item:hover .faq-q-text {
        color: #2d6a4f;
    }

    /* ── Toggle icon (plus → X via rotation) ── */
    .faq-toggle {
        width: 32px;
        height: 32px;
        min-width: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f3f4f6;
        color: #6b7280;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .faq-item:hover .faq-toggle {
        background: #ecfdf5;
        color: #2d6a4f;
    }

    .faq-item.is-open .faq-toggle {
        background: #2d6a4f;
        color: #fff;
        transform: rotate(45deg);
    }

    /* ── Answer wrapper (animated) ── */
    .faq-answer-wrapper {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition:
            max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.3s ease;
    }

    .faq-item.is-open .faq-answer-wrapper {
        opacity: 1;
    }

    .faq-answer {
        padding: 0 0 1.25rem 0;
    }

    .faq-answer p {
        font-family: "Lora", Georgia, serif;
        font-size: clamp(0.925rem, 0.875rem + 0.2vw, 1rem);
        color: #4b5563;
        line-height: 1.7;
        margin: 0;
    }

    /* ── Mobile ── */
    @media (max-width: 640px) {
        .faq-question {
            padding: 1rem 0;
        }
        .faq-toggle {
            width: 28px;
            height: 28px;
            min-width: 28px;
        }
    }
</style>

<script>
    function initFaqAccordion() {
        const items = document.querySelectorAll("[data-faq-item]");

        items.forEach((item) => {
            const btn = item.querySelector(".faq-question");
            const wrapper = item.querySelector(".faq-answer-wrapper");
            const inner = item.querySelector(".faq-answer");
            if (!btn || !wrapper || !inner) return;

            btn.addEventListener("click", () => {
                const isOpen = item.classList.contains("is-open");

                // Close all other items first
                items.forEach((other) => {
                    if (other !== item && other.classList.contains("is-open")) {
                        closeItem(other);
                    }
                });

                // Toggle current item
                if (isOpen) {
                    closeItem(item);
                } else {
                    openItem(item);
                }
            });
        });

        function openItem(item: Element) {
            const wrapper = item.querySelector(
                ".faq-answer-wrapper",
            ) as HTMLElement;
            const inner = item.querySelector(".faq-answer") as HTMLElement;
            const btn = item.querySelector(".faq-question");
            if (!wrapper || !inner) return;

            item.classList.add("is-open");
            btn?.setAttribute("aria-expanded", "true");

            // Animate open
            const height = inner.offsetHeight;
            wrapper.style.maxHeight = height + "px";
        }

        function closeItem(item: Element) {
            const wrapper = item.querySelector(
                ".faq-answer-wrapper",
            ) as HTMLElement;
            const btn = item.querySelector(".faq-question");
            if (!wrapper) return;

            item.classList.remove("is-open");
            btn?.setAttribute("aria-expanded", "false");
            wrapper.style.maxHeight = "0px";
        }
    }

    // Init on page load and Astro navigation
    initFaqAccordion();
    document.addEventListener("astro:after-swap", initFaqAccordion);
</script>
