---
/**
 * TableOfContents - Recipe Blog Style with Collapsible Accordion
 *
 * Hierarchically numbered TOC that can be expanded/collapsed.
 */

import type { TocSettings } from "@modules/settings/services/settings.service";

interface TocItem {
    id: string;
    text: string;
    level: number;
}

interface Props {
    toc: string | TocItem[] | null | undefined;
    class?: string;
    settings?: TocSettings;
}

const { toc: tocInput, class: className = "", settings } = Astro.props;

// Default settings if not provided
const enabled = settings?.enabled ?? true;
const numbering = settings?.numbering ?? true;
const collapsible = settings?.collapsible ?? true;
const defaultOpen = settings?.defaultOpen ?? true;
const showJumpButton = settings?.showJumpButton ?? true;
const accentColor = settings?.accentColor || "#f97316";

// Early return if disabled
if (!enabled) {
    return null;
}

// Parse tocJson if it's a string
const toc: TocItem[] = (() => {
    let items: TocItem[] = [];
    if (!tocInput) items = [];
    else if (Array.isArray(tocInput)) items = tocInput;
    else if (typeof tocInput === "string") {
        try {
            const parsed = JSON.parse(tocInput);
            items = Array.isArray(parsed) ? parsed : [];
        } catch {
            items = [];
        }
    } else {
        items = [];
    }

    // Filter out levels deep levels (h5, h6) and ensure level is a number
    return items.filter((item) => (Number(item.level) || 2) <= 4);
})();

// Early return if no TOC items
if (toc.length === 0) {
    return null;
}

// Create hierarchical numbered items (1, 1.1, 1.2, 2, 2.1, etc.)
let h2Count = 0;
let h3Count = 0;
let h4Count = 0;

const numberedToc = toc.map((item) => {
    const level = item.level || 2;
    let number = "";

    if (numbering) {
        if (level === 2) {
            h2Count++;
            h3Count = 0; // Reset sub-counters
            h4Count = 0;
            number = `${h2Count}`;
        } else if (level === 3) {
            h3Count++;
            h4Count = 0; // Reset sub-counter
            number = `${h2Count}.${h3Count}`;
        } else if (level === 4) {
            h4Count++;
            number = `${h2Count}.${h3Count}.${h4Count}`;
        }
    }

    return { ...item, number };
});

const Container = collapsible ? "details" : "div";
const containerProps = collapsible ? { open: defaultOpen } : {};
const headerProps = collapsible
    ? {}
    : { style: "cursor: default; pointer-events: none;" };
---

<Container
    class:list={["recipe-toc", className]}
    {...containerProps}
    style={`--toc-accent: ${accentColor};`}
>
    <summary class="toc-header" {...headerProps}>
        <div class="header-left">
            <span class="toc-icon">📋</span>
            <span class="toc-title">In This Recipe</span>
            <span class="toc-count">({toc.length} sections)</span>
        </div>
        {
            collapsible && (
                <span class="chevron">
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                    >
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </span>
            )
        }
    </summary>

    <div class="toc-content">
        <ol class="toc-list">
            {
                numberedToc.map((item) => (
                    <li
                        class:list={[
                            "toc-item",
                            `toc-level-${item.level || 2}`,
                        ]}
                    >
                        <a href={`#${item.id}`} class="toc-link">
                            {item.number && (
                                <span class="toc-number">{item.number}.</span>
                            )}
                            <span class="toc-text">{item.text}</span>
                        </a>
                    </li>
                ))
            }
        </ol>

        {
            showJumpButton && (
                <a href="#recipe-card" class="jump-to-recipe">
                    <span class="jump-icon">🍳</span>
                    <span>Jump to Recipe</span>
                </a>
            )
        }
    </div>
</Container>

<style>
    .recipe-toc {
        background: #fff;
        border: 1px solid #eaeaea;
        border-radius: 8px;
        margin: 1.5rem 0;
        font-family:
            system-ui,
            -apple-system,
            sans-serif;
        overflow: hidden;
    }

    .toc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        cursor: pointer;
        list-style: none;
        user-select: none;
        transition: background 0.2s ease;
    }

    .toc-header::-webkit-details-marker {
        display: none;
    }

    .toc-header:hover {
        background: rgba(251, 146, 60, 0.08);
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .toc-icon {
        font-size: 1.25rem;
    }

    .toc-title {
        font-weight: 700;
        font-size: 1.05rem;
        color: #92400e;
    }

    .toc-count {
        font-size: 0.85rem;
        color: #b45309;
        opacity: 0.8;
    }

    .chevron {
        color: var(--toc-accent, #f97316);
        transition: transform 0.3s ease;
        display: flex;
        align-items: center;
    }

    .recipe-toc[open] .chevron {
        transform: rotate(180deg);
    }

    .toc-content {
        padding: 0 1.25rem 1.25rem;
        animation: slideDown 0.3s ease-out;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .toc-list {
        list-style: none;
        padding: 0;
        margin: 0 0 1rem 0;
    }

    .toc-item {
        margin: 0;
    }

    .toc-level-3 {
        padding-left: 1.25rem;
    }

    .toc-level-4 {
        padding-left: 2.5rem;
    }

    .toc-link {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.6rem 0.5rem;
        color: #78350f;
        text-decoration: none;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        border-radius: 6px;
        border-left: 3px solid transparent;
    }

    .toc-link:hover {
        color: #ea580c;
        background: rgba(251, 146, 60, 0.1);
        border-left-color: var(--toc-accent, #fb923c);
    }

    .toc-number {
        font-weight: 700;
        color: var(--toc-accent, #f97316);
        min-width: 2rem;
        font-size: 0.9rem;
        font-variant-numeric: tabular-nums;
    }

    .toc-level-3 .toc-number {
        min-width: 2.25rem;
    }

    .toc-level-4 .toc-number {
        min-width: 2.75rem;
    }

    .toc-text {
        flex: 1;
    }

    .jump-to-recipe {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: var(--toc-accent, #fb923c);
        color: white;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.75rem 1.25rem;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: none;
    }

    .jump-to-recipe:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(251, 146, 60, 0.4);
    }

    .jump-icon {
        font-size: 1.1rem;
    }

    /* Mobile adjustments */
    @media (max-width: 640px) {
        .recipe-toc {
            margin: 1rem 0;
        }

        .toc-header {
            padding: 0.875rem 1rem;
        }

        .toc-title {
            font-size: 0.95rem;
        }

        .toc-content {
            padding: 0 1rem 1rem;
        }

        .toc-link {
            font-size: 0.9rem;
            padding: 0.5rem 0.4rem;
        }
    }
</style>

<script>
    // Smooth scroll for TOC links
    document.querySelectorAll('.recipe-toc a[href^="#"]').forEach((link) => {
        link.addEventListener("click", (e) => {
            const href = link.getAttribute("href");
            if (!href) return;

            const target = document.querySelector(href);
            if (target) {
                e.preventDefault();
                target.scrollIntoView({ behavior: "smooth", block: "start" });
                history.pushState(null, "", href);
            }
        });
    });
</script>
