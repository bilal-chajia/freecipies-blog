---
/**
 * TableOfContents – Clean blog-style TOC
 *
 * Renders a collapsible outline of headings extracted from article content.
 * Supports h2–h4 nesting with optional hierarchical numbering, smooth-scroll,
 * and active-heading highlighting via IntersectionObserver.
 */

import type { TocSettings } from "@modules/settings/services/settings.service";

interface TocItem {
    id: string;
    text: string;
    level: number;
    num?: string;
    children?: TocItem[];
}

interface Props {
    toc: string | TocItem[] | null | undefined;
    class?: string;
    settings?: TocSettings;
}

const { toc: tocInput, class: className = "", settings } = Astro.props;

// Settings with sensible defaults
const enabled = settings?.enabled ?? true;
const numbering = settings?.numbering ?? true;
const collapsible = settings?.collapsible ?? true;
const defaultOpen = settings?.defaultOpen ?? true;
const showJumpButton = settings?.showJumpButton ?? true;
const accentColor = settings?.accentColor || "#3b82f6";
const maxDepth = settings?.maxDepth ?? 4;

if (!enabled) return null;

// Parse input -----------------------------------------------------------------
const toc: TocItem[] = (() => {
    let items: TocItem[] = [];
    if (!tocInput) return [];
    if (Array.isArray(tocInput)) items = tocInput;
    else if (typeof tocInput === "string") {
        try {
            const parsed = JSON.parse(tocInput);
            items = Array.isArray(parsed) ? parsed : [];
        } catch {
            items = [];
        }
    }
    return items.filter((i) => (Number(i.level) || 2) <= maxDepth);
})();

if (toc.length === 0) return null;

// Hierarchical numbering (1, 1.1, 1.1.1) ------------------------------------
let h2 = 0,
    h3 = 0,
    h4 = 0;
const numberedToc = toc.map((item) => {
    const lvl = item.level || 2;
    let num = "";
    if (numbering) {
        if (lvl === 2) {
            h2++;
            h3 = 0;
            h4 = 0;
            num = `${h2}`;
        } else if (lvl === 3) {
            h3++;
            h4 = 0;
            num = `${h2}.${h3}`;
        } else if (lvl === 4) {
            h4++;
            num = `${h2}.${h3}.${h4}`;
        }
    }
    return { ...item, num };
});

// Group items by H2 to prevent column breaks inside sections
const groupedToc: TocItem[] = [];
let currentGroup: TocItem | null = null;

numberedToc.forEach((item) => {
    if (item.level === 2) {
        currentGroup = { ...item, children: [] };
        groupedToc.push(currentGroup);
    } else if (currentGroup && item.level > 2) {
        currentGroup.children!.push(item);
    } else {
        // Fallback for h3/h4 that appear before any h2
        groupedToc.push({ ...item, children: [] });
    }
});

const Tag = collapsible ? "details" : "div";
const tagProps = collapsible ? { open: defaultOpen } : {};
---

<Tag
    class:list={["blog-toc", className]}
    {...tagProps}
    style={`--toc-accent: ${accentColor};`}
>
    {/* Header / Summary */}
    <summary class="toc-header">
        <div class="toc-title-group">
            <svg
                class="toc-book-icon"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path
                    d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"
                ></path>
                <path d="M8 2v20"></path>
            </svg>
            <span class="toc-label">Contents</span>
        </div>
        <div class="toc-header-actions">
            {
                showJumpButton && (
                    <a href="#recipe" class="toc-jump-btn" data-astro-prefetch>
                        Jump to Recipe
                    </a>
                )
            }
        </div>
    </summary>

    {/* Links */}
    <div class="toc-nav-wrapper">
        <div class="toc-nav-inner">
            <nav class="toc-nav" aria-label="Table of contents">
                <ul class="toc-list">
                    {
                        groupedToc.map((group) => (
                            <li class="toc-group">
                                <a
                                    href={`#${group.id}`}
                                    class="toc-link"
                                    data-toc-target={group.id}
                                >
                                    {group.num && (
                                        <span class="toc-num">{group.num}</span>
                                    )}
                                    <span>{group.text}</span>
                                </a>

                                {group.children &&
                                    group.children.length > 0 && (
                                        <ul class="toc-sublist">
                                            {group.children.map((child) => (
                                                <li
                                                    class={`toc-item toc-lvl-${child.level}`}
                                                >
                                                    <a
                                                        href={`#${child.id}`}
                                                        class="toc-link"
                                                        data-toc-target={
                                                            child.id
                                                        }
                                                    >
                                                        {child.num && (
                                                            <span class="toc-num">
                                                                {child.num}
                                                            </span>
                                                        )}
                                                        <span>
                                                            {child.text}
                                                        </span>
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    )}
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>
    </div>

    {
        collapsible && (
            <div class="toc-bottom-toggle">
                <button
                    type="button"
                    class="toc-chevron-btn"
                    aria-label="Toggle contents"
                >
                    <svg
                        class="toc-chevron"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="#111827"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </button>
            </div>
        )
    }

    <!-- ─── Styles ─────────────────────────────────────────────────────────── -->
    <style>
        /* Container */
        .blog-toc {
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: 6px;
            margin: 2rem 0;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
            font-family:
                "Work Sans",
                system-ui,
                -apple-system,
                sans-serif;
            overflow: visible; /* Now visible so the absolute button can overflow the border */
            position: relative;
        }

        /* Header */
        .toc-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.25rem 1.5rem 0.5rem 1.75rem;
            cursor: pointer;
            list-style: none;
            user-select: none;
            transition: background 0.15s ease;
        }
        .blog-toc:not(details) .toc-header {
            cursor: default;
        }
        .toc-header::-webkit-details-marker {
            display: none;
        }

        /* When details is open, but we use JS for smooth transition so we just style the header */
        .blog-toc.is-expanded .toc-chevron {
            transform: rotate(180deg);
        }
        .blog-toc:not(.is-expanded) .toc-chevron {
            transform: rotate(0deg);
        }

        .toc-bottom-toggle {
            position: absolute;
            bottom: -16px; /* Halfway over the border */
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
        }

        .toc-chevron-btn {
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.1);
            color: #111827;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05); /* Gives it a slight lift */
        }

        .toc-chevron-btn:hover {
            transform: scale(1.05);
            background: #f9fafb;
        }

        .toc-title-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .toc-book-icon {
            color: var(--toc-accent, #f59e0b);
        }

        .toc-label {
            font-weight: 800;
            font-size: 1.25rem;
            color: #1a1a1a;
            letter-spacing: -0.01em;
        }

        .toc-header-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .toc-jump-btn {
            background-color: var(--toc-accent, #f59e0b);
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 0.375rem 0.75rem;
            border-radius: 4px;
            text-decoration: none;
            transition: opacity 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .toc-jump-btn:hover {
            opacity: 0.9;
        }

        .toc-chevron {
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            flex-shrink: 0;
        }

        /* Navigation / Accordion wrapper */
        .toc-nav-wrapper {
            display: grid;
            grid-template-rows: 0fr;
            transition: grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .blog-toc.is-open .toc-nav-wrapper {
            grid-template-rows: 1fr;
        }

        .toc-nav-inner {
            position: relative;
            overflow: hidden;
        }

        .toc-nav {
            padding: 0.25rem 1.5rem 1rem 1.75rem;
            opacity: 0;
            transition: opacity 0.3s ease;
            visibility: hidden;
            /* Maximum initial height before 'Show More' */
            max-height: var(--collapsed-height, 250px);
            overflow-y: hidden;
            /* Custom variable for transitioning max-height */
            --max-h: var(--collapsed-height, 250px);
        }

        .blog-toc.is-expanded .toc-nav {
            max-height: 3000px; /* Big enough to fit everything */
            --max-h: 3000px;
            transition:
                max-height 0.5s ease-in-out,
                opacity 0.4s ease 0.1s;
        }

        .blog-toc.is-open .toc-nav {
            opacity: 1;
            visibility: visible;
            transition:
                max-height 0.5s ease-in-out,
                opacity 0.4s ease 0.1s;
        }

        .toc-list {
            list-style: none;
            padding: 0;
            margin: 0;
            column-count: 2;
            column-gap: 2rem;
        }

        /* Grouping to prevent column breaks */
        .toc-group {
            margin: 0;
            break-inside: avoid;
            padding: 0;
            /* Removed bottom border from group to prevent double lines */
        }
        .toc-group:last-child {
            margin-bottom: 0;
        }

        .toc-sublist {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        /* Items */
        .toc-item {
            margin: 0;
            padding: 0;
            position: relative; /* For pseudo-element positioning */
        }

        /* The separator line directly under an H2 before its H3 children start */
        /* Replaced by pseudo-elements on .toc-link below */

        .toc-link {
            position: relative; /* Context for ::after separator */
            display: flex;
            align-items: flex-start;
            gap: 0.625rem;
            padding: 0.625rem 0; /* Standardized height/padding for all links */
            text-decoration: none;
            font-size: 0.9375rem;
            font-weight: 700;
            line-height: 1.3;
            color: #1a1a1a;
            border-left: 2px solid transparent;
            transition: all 0.15s ease;
        }

        /* The custom separator line that starts *with* the number */
        .toc-link::after {
            content: "";
            position: absolute;
            left: 0; /* starts exactly at the left edge of the number box */
            right: 0;
            bottom: 0;
            height: 1px;
            background: #e5e7eb;
        }

        /* Remove border from ONLY the very last item in the entire TOC list */
        .toc-list > .toc-group:last-child .toc-link::after {
            display: none;
        }
        /* Except if that last group has children, then the very last child's link gets no border instead */
        .toc-list
            > .toc-group:last-child
            .toc-sublist
            .toc-item:last-child
            > .toc-link::after {
            display: none;
            /* But we must restore the group's link border if it has children */
        }
        .toc-list > .toc-group:last-child:has(.toc-sublist) > .toc-link::after {
            display: block;
        }
        .toc-link:hover {
            color: var(--toc-accent, #f59e0b);
        }

        /* Active heading highlight */
        .toc-link.active {
            color: var(--toc-accent, #f59e0b);
        }

        .toc-num {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #1a1a1a;
            color: #ffffff;
            font-weight: 800;
            min-width: 1.5rem;
            height: 1.5rem;
            font-size: 0.75rem;
            border-radius: 4px;
            margin-top: 1px;
            flex-shrink: 0;
            padding: 0 0.35rem;
        }

        /* Level indentation — using margin so borders start at number position */
        .toc-lvl-3 {
            margin-left: 1.5rem;
        }
        .toc-lvl-4 {
            margin-left: 3rem;
        }

        /* Print */
        @media print {
            .blog-toc {
                border: 1px solid #e5e7eb;
                background: #fff;
                box-shadow: none;
            }
            .toc-chevron {
                display: none;
            }
        }

        /* Mobile */
        @media (max-width: 768px) {
            .toc-list {
                column-count: 1;
            }
            .toc-group {
                margin: 0;
                padding-bottom: 0;
                border-bottom: none;
            }
            .toc-item {
                border-bottom: none;
                padding: 0; /* Keep padding on the link itself */
            }
            .toc-link::after {
                background: #f3f4f6; /* Lighter mobile border */
            }
            .toc-group > .toc-link {
                padding: 0.625rem 0;
            }
            .blog-toc {
                margin: 1.25rem 0;
            }
            .toc-header {
                padding: 0.75rem 1rem;
            }
            .toc-nav {
                padding: 0.375rem 0.75rem 0.875rem;
            }
            .toc-link {
                font-size: 0.8125rem;
                padding: 0.375rem 0.5rem;
            }
            .toc-lvl-3 {
                margin-left: 1rem; /* Reduced from 1.5rem for mobile */
            }
            .toc-lvl-4 {
                margin-left: 2rem; /* Reduced from 3rem for mobile */
            }
        }
    </style>

    <!-- ─── Smooth scroll + active heading highlight ───────────────────────── -->
    <script>
        // Smooth scroll
        document.querySelectorAll('.blog-toc a[href^="#"]').forEach((link) => {
            link.addEventListener("click", (e) => {
                const href = link.getAttribute("href");
                if (!href) return;
                const target = document.querySelector(href);
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({
                        behavior: "smooth",
                        block: "start",
                    });
                    history.pushState(null, "", href);
                }
            });
        });

        // Active heading tracking via IntersectionObserver
        const tocLinks = document.querySelectorAll<HTMLAnchorElement>(
            ".blog-toc .toc-link",
        );
        if (tocLinks.length > 0) {
            const ids = Array.from(tocLinks).map((a) => a.dataset.tocTarget!);
            const headings = ids
                .map((id) => document.getElementById(id))
                .filter(Boolean) as HTMLElement[];

            if (headings.length > 0) {
                const observer = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (entry.isIntersecting) {
                                tocLinks.forEach((l) =>
                                    l.classList.remove("active"),
                                );
                                const match = document.querySelector(
                                    `.blog-toc .toc-link[data-toc-target="${entry.target.id}"]`,
                                );
                                match?.classList.add("active");
                            }
                        }
                    },
                    { rootMargin: "-80px 0px -60% 0px", threshold: 0 },
                );
                headings.forEach((h) => observer.observe(h));
            }
        }

        // Smooth Details/Summary Toggle
        const tocs = document.querySelectorAll(".blog-toc");
        tocs.forEach((toc) => {
            if (toc.tagName.toLowerCase() === "details") {
                const summary = toc.querySelector("summary");

                // Make sure the TOC is always technically open in the details tag
                toc.setAttribute("open", "");
                toc.classList.add("is-open");

                summary?.addEventListener("click", (e) => {
                    e.preventDefault(); // Stop default instant toggle

                    if (toc.classList.contains("is-expanded")) {
                        // Collapse to partial height
                        toc.classList.remove("is-expanded");
                    } else {
                        // Expand fully
                        toc.classList.add("is-expanded");
                    }
                });

                // Dynamic height calculation
                const tocNav = toc.querySelector(".toc-nav") as HTMLElement;

                const calculateAndSetHalfHeight = () => {
                    if (tocNav) {
                        // Temporarily expand to get full height
                        const wasExpanded =
                            toc.classList.contains("is-expanded");
                        if (!wasExpanded) toc.classList.add("is-expanded");

                        const fullHeight = tocNav.scrollHeight;
                        const halfHeight = Math.floor(fullHeight / 2);

                        // Set CSS Custom Variable for collapsed state
                        tocNav.style.setProperty(
                            "--collapsed-height",
                            `${halfHeight}px`,
                        );

                        // Revert expansion state if it wasn't expanded
                        if (!wasExpanded) toc.classList.remove("is-expanded");
                    }
                };

                // Calculate initially and on resize
                setTimeout(calculateAndSetHalfHeight, 100);
                window.addEventListener("resize", calculateAndSetHalfHeight);

                // Set initial state to partially collapsed
                toc.classList.remove("is-expanded");

                // Handle Jump to Recipe Button correctly within `<summary>`
                // Without this, clicking the button toggles the `<details>` immediately.
                const jumpBtn = summary?.querySelector(".toc-jump-btn");
                if (jumpBtn) {
                    jumpBtn.addEventListener("click", (e) => {
                        e.stopPropagation(); // prevent `<summary>` click
                    });
                }

                // Handle Bottom Chevron Toggle
                const bottomBtn = toc.querySelector(".toc-chevron-btn");
                if (bottomBtn) {
                    bottomBtn.addEventListener("click", (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        if (toc.classList.contains("is-expanded")) {
                            toc.classList.remove("is-expanded");
                        } else {
                            toc.classList.add("is-expanded");
                        }
                    });
                }
            } else {
                // Not a details tag (collapsible = false), so it's always open by default in CSS wrapper.
                toc.classList.add("is-open");
            }
        });
    </script>
</Tag>
