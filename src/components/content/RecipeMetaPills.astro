---
/**
 * RecipeMetaPills - Recipe time/serving pills component
 *
 * Displays prep time, cook time, total time, and servings as pills.
 */

interface RecipeJson {
    prep?: number;
    prepTime?: string;
    cook?: number;
    cookTime?: string;
    total?: number;
    totalTime?: string;
    servings?: number | string;
    difficulty?: string;
}

interface Props {
    recipe: RecipeJson | null | undefined;
}

const { recipe } = Astro.props;

// Early return if no recipe data
if (!recipe) {
    return null;
}

const hasPrep = recipe.prep || recipe.prepTime;
const hasCook = recipe.cook || recipe.cookTime;
const hasTotal = recipe.total || recipe.totalTime;
const hasServings = recipe.servings;
const hasDifficulty = recipe.difficulty;

// Hide if nothing to display
if (!hasPrep && !hasCook && !hasTotal && !hasServings && !hasDifficulty) {
    return null;
}
---

<div class="recipe-meta-pills">
    {
        hasPrep && (
            <div class="meta-pill">
                <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
                <span class="label">Prep</span>
                <span class="value">
                    {recipe.prep ? `${recipe.prep} min` : recipe.prepTime}
                </span>
            </div>
        )
    }

    {
        hasCook && (
            <div class="meta-pill">
                <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83" />
                </svg>
                <span class="label">Cook</span>
                <span class="value">
                    {recipe.cook ? `${recipe.cook} min` : recipe.cookTime}
                </span>
            </div>
        )
    }

    {
        hasTotal && (
            <div class="meta-pill">
                <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
                <span class="label">Total</span>
                <span class="value">
                    {recipe.total ? `${recipe.total} min` : recipe.totalTime}
                </span>
            </div>
        )
    }

    {
        hasServings && (
            <div class="meta-pill">
                <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75" />
                </svg>
                <span class="label">Servings</span>
                <span class="value">{recipe.servings}</span>
            </div>
        )
    }

    {
        hasDifficulty && (
            <div class="meta-pill">
                <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                </svg>
                <span class="label">Level</span>
                <span class="value">{recipe.difficulty}</span>
            </div>
        )
    }
</div>

<style>
    .recipe-meta-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin: 1.5rem 0;
    }

    .meta-pill {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: transparent;
        border: 1px solid #eee;
        border-radius: 8px;
        font-size: 0.875rem;
    }

    .meta-pill .icon {
        width: 1.25rem;
        height: 1.25rem;
        color: #f97316;
        flex-shrink: 0;
    }

    .meta-pill .label {
        color: #666;
        font-weight: 500;
    }

    .meta-pill .value {
        color: #333;
        font-weight: 600;
    }
</style>
