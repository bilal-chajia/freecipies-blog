---
/**
 * NutritionFacts - Modern nutrition label component
 *
 * Grid variant inspired by premium health-app design:
 * - Circular calorie ring with energy summary
 * - 4 macro cards with icons & mini progress bars
 * - Two-column micronutrient/vitamin grid
 * - Responsive: full-width desktop, stacked mobile
 */

interface Props {
  nutrition?: Record<string, string | number> | null;
  variant?: "label" | "grid" | "compact";
}

const { nutrition, variant = "label" } = Astro.props;

const data = {
  calories: nutrition?.calories ?? null,
  totalFat: nutrition?.totalFat ?? nutrition?.fatContent ?? null,
  saturatedFat:
    nutrition?.saturatedFat ?? nutrition?.saturatedFatContent ?? null,
  transFat: nutrition?.transFat ?? nutrition?.transFatContent ?? null,
  cholesterol: nutrition?.cholesterol ?? nutrition?.cholesterolContent ?? null,
  sodium: nutrition?.sodium ?? nutrition?.sodiumContent ?? null,
  totalCarbohydrates:
    nutrition?.totalCarbohydrates ?? nutrition?.carbohydrateContent ?? null,
  dietaryFiber: nutrition?.dietaryFiber ?? nutrition?.fiberContent ?? null,
  totalSugars: nutrition?.totalSugars ?? nutrition?.sugarContent ?? null,
  protein: nutrition?.protein ?? nutrition?.proteinContent ?? null,
  vitaminC: nutrition?.vitaminC ?? null,
  calcium: nutrition?.calcium ?? null,
  iron: nutrition?.iron ?? null,
  vitaminD: nutrition?.vitaminD ?? null,
  potassium: nutrition?.potassium ?? null,
  servingSize: nutrition?.servingSize ?? "1 serving",
  servingsPerRecipe: nutrition?.servingsPerRecipe ?? 1,
};

const hasData = Object.entries(data).some(([key, value]) => {
  if (["servingSize", "servingsPerRecipe"].includes(key)) return false;
  return value !== null && value !== undefined;
});

if (!hasData) return null;

function fmt(
  value: string | number | null | undefined,
  unit: string = "g",
): string {
  if (value === null || value === undefined || value === "") return "-";
  const num = typeof value === "string" ? parseFloat(value) : value;
  if (isNaN(num)) return String(value);
  return Math.round(num) + unit;
}

function fmtPct(value: string | number | null | undefined): string {
  if (value === null || value === undefined) return "-";
  const num = typeof value === "string" ? parseFloat(value) : value;
  if (isNaN(num)) return "-";
  return `${Math.round(num)}%`;
}

function pctNum(value: string | number | null | undefined): number {
  if (value === null || value === undefined) return 0;
  const num = typeof value === "string" ? parseFloat(value) : value;
  return isNaN(num) ? 0 : Math.min(100, Math.max(0, Math.round(num)));
}

function numVal(value: string | number | null | undefined): number {
  if (value === null || value === undefined) return 0;
  const num = typeof value === "string" ? parseFloat(value) : value;
  return isNaN(num) ? 0 : Math.round(num);
}

// SVG ring math (r=40, circumference = 2*PI*40 ≈ 251.3)
const ringR = 40;
const ringC = 2 * Math.PI * ringR;
// We'll show the ring at a fixed 65% fill as a visual indicator
const ringOffset = ringC * (1 - 0.65);

// FDA Daily Values (2,000 cal diet) — reference for auto-calculating DV%
// Source: FDA 2020 Nutrition Facts Label (21 CFR 101.9)
const dvRecommended: Record<string, number> = {
  // Macronutrients (grams)
  protein: 50,
  totalFat: 78,
  saturatedFat: 20,
  carbs: 275,
  fiber: 28,
  totalSugars: 50, // Added sugars DV
  // Minerals (milligrams unless noted)
  sodium: 2300, // mg
  cholesterol: 300, // mg
  calcium: 1300, // mg
  iron: 18, // mg
  potassium: 4700, // mg
  magnesium: 420, // mg
  zinc: 11, // mg
  phosphorus: 1250, // mg
  copper: 0.9, // mg
  manganese: 2.3, // mg
  selenium: 55, // mcg → mg = 0.055
  // Vitamins
  vitaminA: 900, // mcg RAE
  vitaminC: 90, // mg
  vitaminD: 20, // mcg
  vitaminE: 15, // mg
  vitaminK: 120, // mcg
  vitaminB6: 1.7, // mg
  vitaminB12: 2.4, // mcg
  thiamin: 1.2, // mg
  riboflavin: 1.3, // mg
  niacin: 16, // mg
  folate: 400, // mcg DFE
  biotin: 30, // mcg
  pantothenicAcid: 5, // mg
  choline: 550, // mg
};

function autoDvPct(
  rawValue: string | number | null | undefined,
  providedPct: string | number | null | undefined,
  dvGrams: number,
): number {
  const provided = pctNum(providedPct);
  if (provided > 0) return provided;
  const raw = numVal(rawValue);
  if (raw <= 0 || dvGrams <= 0) return 0;
  return Math.min(100, Math.round((raw / dvGrams) * 100));
}

const proteinPct = autoDvPct(
  data.protein,
  nutrition?.proteinPercent,
  dvRecommended.protein,
);
const fatPct = autoDvPct(
  data.totalFat,
  nutrition?.totalFatPercent,
  dvRecommended.totalFat,
);
const carbsPct = autoDvPct(
  data.totalCarbohydrates,
  nutrition?.carbohydratePercent,
  dvRecommended.carbs,
);
const fiberPct = autoDvPct(
  data.dietaryFiber,
  nutrition?.fiberPercent,
  dvRecommended.fiber,
);

// Check which secondary/vitamin items exist
const hasMicros =
  data.sodium || data.potassium || data.calcium || data.cholesterol;
const hasVitamins =
  data.vitaminD ||
  data.vitaminC ||
  data.iron ||
  data.totalSugars ||
  data.dietaryFiber;
---

{
  variant === "grid" ? (
    <section
      class="recipe-card-section nutrition-section"
      id="recipe-nutrition"
    >
      {/* ── Header (Premium Style) ── */}
      <div class="section-heading-group">
        <span class="section-heading-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 2v2M15 2v2M12 2v8M8 10h8v10a2 2 0 01-2 2h-4a2 2 0 01-2-2V10z" />
          </svg>
        </span>
        <div class="nf-title-group">
          <h2 class="section-heading">Nutrition Facts</h2>
          <p class="nf-subtitle">Daily values based on a 2,000 calorie diet.</p>
        </div>
        <div class="nf-serving-badge">
          <span class="nf-serving-prefix">Per Serving</span>
          <span class="nf-serving-value">{data.servingSize}</span>
        </div>
      </div>

      {/* ── Energy Summary (Calorie Ring + Text) ── */}
      {data.calories && (
        <div class="nf-energy">
          <div class="nf-ring-wrap">
            <svg class="nf-ring" viewBox="0 0 100 100">
              <circle
                cx="50"
                cy="50"
                r={ringR}
                fill="none"
                stroke="#f3f4f6"
                stroke-width="8"
              />
              <circle
                cx="50"
                cy="50"
                r={ringR}
                fill="none"
                stroke="#6B8F71"
                stroke-width="8"
                stroke-linecap="round"
                stroke-dasharray={ringC}
                stroke-dashoffset={ringOffset}
                transform="rotate(-90 50 50)"
              />
            </svg>
            <div class="nf-ring-text">
              <span class="nf-ring-value">{numVal(data.calories)}</span>
              <span class="nf-ring-label">KCAL</span>
            </div>
          </div>
          <div class="nf-energy-info">
            <h3 class="nf-energy-title">Energy Summary</h3>
            <p class="nf-energy-desc">
              This serving provides <strong>{numVal(data.calories)}</strong>{" "}
              calories
              {data.protein ? ` with ${fmt(data.protein)} protein` : ""}
              {data.totalFat ? ` and ${fmt(data.totalFat)} fat` : ""}.
            </p>
          </div>
        </div>
      )}

      {/* ── 4 Macro Cards ── */}
      <div class="nf-macros-grid">
        {data.protein && (
          <div class="nf-macro-card">
            <div class="nf-macro-icon nf-icon-protein">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                width="18"
                height="18"
              >
                <path d="M12 2a5 5 0 015 5v3a5 5 0 01-10 0V7a5 5 0 015-5zM8.21 13.89L7 23l5-3 5 3-1.21-9.12" />
              </svg>
            </div>
            <span class="nf-macro-val">{fmt(data.protein)}</span>
            <span class="nf-macro-name">Protein</span>
            <div class="nf-mini-bar">
              <div
                class="nf-mini-fill nf-fill-protein"
                style={`width:${proteinPct || 8}%`}
              />
            </div>
            {proteinPct > 0 && (
              <span class="nf-macro-dv">{proteinPct}% DV</span>
            )}
          </div>
        )}

        {data.totalFat && (
          <div class="nf-macro-card">
            <div class="nf-macro-icon nf-icon-fat">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                width="18"
                height="18"
              >
                <path d="M12 22c-4.97 0-9-2.69-9-6v-.01C3 9.55 12 2 12 2s9 7.55 9 13.99V16c0 3.31-4.03 6-9 6z" />
              </svg>
            </div>
            <span class="nf-macro-val">{fmt(data.totalFat)}</span>
            <span class="nf-macro-name">Total Fat</span>
            <div class="nf-mini-bar">
              <div
                class="nf-mini-fill nf-fill-fat"
                style={`width:${fatPct || 8}%`}
              />
            </div>
            {fatPct > 0 && <span class="nf-macro-dv">{fatPct}% DV</span>}
          </div>
        )}

        {data.totalCarbohydrates && (
          <div class="nf-macro-card">
            <div class="nf-macro-icon nf-icon-carbs">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                width="18"
                height="18"
              >
                <path d="M2 22l1-1h18l1 1M12 2L9.1 8.6 2 9.2l5.5 4.8L6 22l6-3.6L18 22l-1.5-8 5.5-4.8-7.1-.6L12 2z" />
              </svg>
            </div>
            <span class="nf-macro-val">{fmt(data.totalCarbohydrates)}</span>
            <span class="nf-macro-name">Carbs</span>
            <div class="nf-mini-bar">
              <div
                class="nf-mini-fill nf-fill-carbs"
                style={`width:${carbsPct || 8}%`}
              />
            </div>
            {carbsPct > 0 && <span class="nf-macro-dv">{carbsPct}% DV</span>}
          </div>
        )}

        {data.dietaryFiber && (
          <div class="nf-macro-card">
            <div class="nf-macro-icon nf-icon-fiber">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                width="18"
                height="18"
              >
                <path d="M17 8C8 10 5.9 16.17 3.82 21.34M5.65 14.32C9 8 14 6 17 5M22 2L2 22" />
              </svg>
            </div>
            <span class="nf-macro-val">{fmt(data.dietaryFiber)}</span>
            <span class="nf-macro-name">Fiber</span>
            <div class="nf-mini-bar">
              <div
                class="nf-mini-fill nf-fill-fiber"
                style={`width:${fiberPct || 8}%`}
              />
            </div>
            {fiberPct > 0 && <span class="nf-macro-dv">{fiberPct}% DV</span>}
          </div>
        )}
      </div>

      {/* ── Two-column Micronutrients & Vitamins ── */}
      {(hasMicros || hasVitamins) && (
        <div class="nf-details-grid">
          {/* Left column */}
          <div class="nf-detail-col">
            <h4 class="nf-detail-heading">Micronutrients</h4>
            {data.sodium && (
              <div class="nf-detail-row">
                <span class="nf-detail-name">Sodium</span>
                <span class="nf-detail-val">{fmt(data.sodium, "mg")}</span>
              </div>
            )}
            {data.potassium && (
              <div class="nf-detail-row">
                <span class="nf-detail-name">Potassium</span>
                <span class="nf-detail-val">{fmt(data.potassium, "mg")}</span>
              </div>
            )}
            {data.calcium && (
              <div class="nf-detail-row">
                <span class="nf-detail-name">Calcium</span>
                <span class="nf-detail-val">{fmt(data.calcium, "mg")}</span>
              </div>
            )}
            {data.cholesterol && (
              <div class="nf-detail-row">
                <span class="nf-detail-name">Cholesterol</span>
                <span class="nf-detail-val">{fmt(data.cholesterol, "mg")}</span>
              </div>
            )}
          </div>

          {/* Right column */}
          <div class="nf-detail-col">
            <h4 class="nf-detail-heading">Vitamins & Others</h4>
            {data.vitaminD && (
              <div class="nf-detail-row">
                <span class="nf-detail-name">Vitamin D</span>
                <span class="nf-detail-val">{fmt(data.vitaminD, "mcg")}</span>
              </div>
            )}
            {data.iron && (
              <div class="nf-detail-row">
                <span class="nf-detail-name">Iron</span>
                <span class="nf-detail-val">{fmt(data.iron, "mg")}</span>
              </div>
            )}
            {data.totalSugars && (
              <div class="nf-detail-row">
                <span class="nf-detail-name">Sugars</span>
                <span class="nf-detail-val">{fmt(data.totalSugars)}</span>
              </div>
            )}
            {data.vitaminC && (
              <div class="nf-detail-row">
                <span class="nf-detail-name">Vitamin C</span>
                <span class="nf-detail-val">{fmt(data.vitaminC, "mg")}</span>
              </div>
            )}
            {data.saturatedFat && (
              <div class="nf-detail-row">
                <span class="nf-detail-name">Sat. Fat</span>
                <span class="nf-detail-val">{fmt(data.saturatedFat)}</span>
              </div>
            )}
          </div>
        </div>
      )}

      {/* ── Footer ── */}
      <div class="nf-footer">
        <span class="nf-disclaimer">
          * The % Daily Value (DV) tells you how much a nutrient in a serving
          contributes to a daily diet.
        </span>
        <button type="button" class="nf-toggle-btn" data-toggle-nutrition>
          Full Details
        </button>
      </div>

      {/* Full USDA label (hidden by default) */}
      <div class="full-nutrition" hidden data-full-nutrition>
        <hr class="nutrition-divider" />
        <div class="nutrition-facts-label">
          <div class="label-header">
            <h3 class="label-title">Nutrition Facts</h3>
          </div>
          <div class="nutrient-row serving-row-label">
            <span class="nutrient-name">
              <strong>Serving Size</strong>
            </span>
            <span class="nutrient-val">{data.servingSize}</span>
          </div>
          <div class="daily-value-header">%Daily Value*</div>
          <div class="nutrient-row">
            <span class="nutrient-name">
              <strong>Calories</strong>
            </span>
            <span class="nutrient-val">{data.calories ?? "-"}</span>
          </div>
          <div class="nutrient-row">
            <span class="nutrient-name">
              <strong>Total Fat</strong>
            </span>
            <span class="nutrient-val">{fmt(data.totalFat)}</span>
          </div>
          {data.saturatedFat && (
            <div class="nutrient-row sub">
              <span class="nutrient-name">– Saturated Fat</span>
              <span class="nutrient-val">{fmt(data.saturatedFat)}</span>
            </div>
          )}
          {data.transFat && (
            <div class="nutrient-row sub">
              <span class="nutrient-name">– Trans Fat</span>
              <span class="nutrient-val">{fmt(data.transFat)}</span>
            </div>
          )}
          <div class="nutrient-row">
            <span class="nutrient-name">
              <strong>Cholesterol</strong>
            </span>
            <span class="nutrient-val">{fmt(data.cholesterol, "mg")}</span>
          </div>
          <div class="nutrient-row">
            <span class="nutrient-name">
              <strong>Sodium</strong>
            </span>
            <span class="nutrient-val">{fmt(data.sodium, "mg")}</span>
          </div>
          <div class="nutrient-row">
            <span class="nutrient-name">
              <strong>Total Carbohydrates</strong>
            </span>
            <span class="nutrient-val">{fmt(data.totalCarbohydrates)}</span>
          </div>
          {data.dietaryFiber && (
            <div class="nutrient-row sub">
              <span class="nutrient-name">– Dietary Fiber</span>
              <span class="nutrient-val">{fmt(data.dietaryFiber)}</span>
            </div>
          )}
          {data.totalSugars && (
            <div class="nutrient-row sub">
              <span class="nutrient-name">– Sugars</span>
              <span class="nutrient-val">{fmt(data.totalSugars)}</span>
            </div>
          )}
          <div class="nutrient-row">
            <span class="nutrient-name">
              <strong>Protein</strong>
            </span>
            <span class="nutrient-val">{fmt(data.protein)}</span>
          </div>
          {data.vitaminD && (
            <div class="nutrient-row">
              <span class="nutrient-name">Vitamin D</span>
              <span class="nutrient-val">
                {fmt(data.vitaminD, "mcg")}
                {nutrition?.vitaminDPercent
                  ? ` (${fmtPct(nutrition.vitaminDPercent)} DV)`
                  : ""}
              </span>
            </div>
          )}
          {data.potassium && (
            <div class="nutrient-row">
              <span class="nutrient-name">Potassium</span>
              <span class="nutrient-val">{fmt(data.potassium, "mg")}</span>
            </div>
          )}
          {data.calcium && (
            <div class="nutrient-row">
              <span class="nutrient-name">Calcium</span>
              <span class="nutrient-val">
                {fmt(data.calcium, "mg")}
                {nutrition?.calciumPercent
                  ? ` (${fmtPct(nutrition.calciumPercent)} DV)`
                  : ""}
              </span>
            </div>
          )}
          {data.iron && (
            <div class="nutrient-row">
              <span class="nutrient-name">Iron</span>
              <span class="nutrient-val">
                {fmt(data.iron, "mg")}
                {nutrition?.ironPercent
                  ? ` (${fmtPct(nutrition.ironPercent)} DV)`
                  : ""}
              </span>
            </div>
          )}
          <p class="footnote">
            DV stands for Daily Value, and it is based on a 2,000 calorie diet.
            These values are approximate and can vary based on preparation.
          </p>
        </div>
      </div>
    </section>
  ) : variant === "compact" ? (
    <div class="nutrition-compact">
      {data.calories && <span class="nutrition-pill">{data.calories} cal</span>}
      {data.protein && (
        <span class="nutrition-pill">{fmt(data.protein)} protein</span>
      )}
      {data.totalFat && (
        <span class="nutrition-pill">{fmt(data.totalFat)} fat</span>
      )}
    </div>
  ) : (
    <div class="nutrition-facts-label">
      <div class="label-header">
        <h3 class="label-title">Nutrition Facts</h3>
      </div>
      <div class="nutrient-row serving-row-label">
        <span class="nutrient-name">
          <strong>Serving Size</strong>
        </span>
        <span class="nutrient-val">{data.servingSize}</span>
      </div>
      <div class="daily-value-header">%Daily Value*</div>
      <div class="nutrient-row">
        <span class="nutrient-name">
          <strong>Calories</strong>
        </span>
        <span class="nutrient-val">{data.calories ?? "-"}</span>
      </div>
      <div class="nutrient-row">
        <span class="nutrient-name">
          <strong>Total Fat</strong>
        </span>
        <span class="nutrient-val">{fmt(data.totalFat)}</span>
      </div>
      {data.saturatedFat && (
        <div class="nutrient-row sub">
          <span class="nutrient-name">– Saturated Fat</span>
          <span class="nutrient-val">{fmt(data.saturatedFat)}</span>
        </div>
      )}
      {data.transFat && (
        <div class="nutrient-row sub">
          <span class="nutrient-name">– Trans Fat</span>
          <span class="nutrient-val">{fmt(data.transFat)}</span>
        </div>
      )}
      <div class="nutrient-row">
        <span class="nutrient-name">
          <strong>Cholesterol</strong>
        </span>
        <span class="nutrient-val">{fmt(data.cholesterol, "mg")}</span>
      </div>
      <div class="nutrient-row">
        <span class="nutrient-name">
          <strong>Sodium</strong>
        </span>
        <span class="nutrient-val">{fmt(data.sodium, "mg")}</span>
      </div>
      <div class="nutrient-row">
        <span class="nutrient-name">
          <strong>Total Carbohydrates</strong>
        </span>
        <span class="nutrient-val">{fmt(data.totalCarbohydrates)}</span>
      </div>
      {data.dietaryFiber && (
        <div class="nutrient-row sub">
          <span class="nutrient-name">– Dietary Fiber</span>
          <span class="nutrient-val">{fmt(data.dietaryFiber)}</span>
        </div>
      )}
      {data.totalSugars && (
        <div class="nutrient-row sub">
          <span class="nutrient-name">– Sugars</span>
          <span class="nutrient-val">{fmt(data.totalSugars)}</span>
        </div>
      )}
      <div class="nutrient-row">
        <span class="nutrient-name">
          <strong>Protein</strong>
        </span>
        <span class="nutrient-val">{fmt(data.protein)}</span>
      </div>
      {data.vitaminD && (
        <div class="nutrient-row">
          <span class="nutrient-name">Vitamin D</span>
          <span class="nutrient-val">
            {fmt(data.vitaminD, "mcg")}
            {nutrition?.vitaminDPercent
              ? ` (${fmtPct(nutrition.vitaminDPercent)} DV)`
              : ""}
          </span>
        </div>
      )}
      {data.potassium && (
        <div class="nutrient-row">
          <span class="nutrient-name">Potassium</span>
          <span class="nutrient-val">{fmt(data.potassium, "mg")}</span>
        </div>
      )}
      {data.calcium && (
        <div class="nutrient-row">
          <span class="nutrient-name">Calcium</span>
          <span class="nutrient-val">
            {fmt(data.calcium, "mg")}
            {nutrition?.calciumPercent
              ? ` (${fmtPct(nutrition.calciumPercent)} DV)`
              : ""}
          </span>
        </div>
      )}
      {data.iron && (
        <div class="nutrient-row">
          <span class="nutrient-name">Iron</span>
          <span class="nutrient-val">
            {fmt(data.iron, "mg")}
            {nutrition?.ironPercent
              ? ` (${fmtPct(nutrition.ironPercent)} DV)`
              : ""}
          </span>
        </div>
      )}
      <p class="footnote">
        DV stands for Daily Value, and it is based on a 2,000 calorie diet.
        These values are approximate and can vary based on preparation.
      </p>
    </div>
  )
}

<style>
  /* ================================================
     GRID VARIANT — Health-app inspired design
     ================================================ */

  /* ── Header (Premium Style) ── */
  .section-heading-group {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
    margin-left: calc(-1 * clamp(16px, 4cqw, 24px));
    margin-right: calc(-1 * clamp(16px, 4cqw, 24px));
    padding: 14px clamp(16px, 4cqw, 24px);
    background: linear-gradient(135deg, #f0f7f1 0%, #f8faf8 100%);
    border-left: 4px solid var(--accent, #6b8f71);
    border-radius: 0;
    position: relative;
  }

  @container (min-width: 0px) {
  } /* fallback if no container query */

  .nf-title-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

