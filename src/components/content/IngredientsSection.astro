---
/**
 * IngredientsSection - Clean ingredient list with checkboxes
 */

import type { IngredientGroup } from "@modules/articles/types/recipes.types";

interface Props {
  ingredients: IngredientGroup[];
  servings?: number;
}

const { ingredients } = Astro.props;

function formatAmount(amount: number | string | null | undefined): string {
  let num = typeof amount === "string" ? parseFloat(amount) : amount;
  if (num === null || num === undefined || isNaN(num)) return "";
  if (num === 0) return "";

  const whole = Math.floor(num);
  const remainder = num - whole;

  let fractionStr = "";
  if (remainder > 0.01) {
    const fraction = Math.round(remainder * 16) / 16;
    if (Math.abs(fraction - 0.125) < 0.01) fractionStr = "⅛";
    else if (Math.abs(fraction - 0.25) < 0.01) fractionStr = "¼";
    else if (Math.abs(fraction - 0.33) < 0.02) fractionStr = "⅓";
    else if (Math.abs(fraction - 0.375) < 0.01) fractionStr = "⅜";
    else if (Math.abs(fraction - 0.5) < 0.01) fractionStr = "½";
    else if (Math.abs(fraction - 0.625) < 0.01) fractionStr = "⅝";
    else if (Math.abs(fraction - 0.66) < 0.02) fractionStr = "⅔";
    else if (Math.abs(fraction - 0.75) < 0.01) fractionStr = "¾";
    else if (Math.abs(fraction - 0.875) < 0.01) fractionStr = "⅞";
    else if (whole === 0) fractionStr = remainder.toFixed(2).replace(/\.?0+$/, "");
  }

  if (whole > 0) {
    return fractionStr ? `${whole} ${fractionStr}` : String(whole);
  }
  return fractionStr || "0";
}

function formatUnit(unit: string, amount: number): string {
  if (!unit) return "";
  if (amount > 1 && !unit.endsWith("s")) {
    const irregulars: Record<string, string> = {
      tbsp: "tbsp",
      tsp: "tsp",
      oz: "oz",
      lb: "lbs",
      cup: "cups",
      can: "cans",
      clove: "cloves",
      slice: "slices",
      piece: "pieces",
      bunch: "bunches",
    };
    return irregulars[unit] || unit + "s";
  }
  return unit;
}
---

<div class="ingredients-list">
  {
    ingredients.map((group, groupIdx) => (
      <div class="ingredient-group" data-group={groupIdx}>
        {group.group_title && <h3 class="group-title">{group.group_title}</h3>}
        <ul class="group-items list-none">
          {group.items.map((item, itemIdx) => {
            const globalIdx =
              ingredients
                .slice(0, groupIdx)
                .reduce((acc, g) => acc + g.items.length, 0) + itemIdx;

            return (
              <li class="ingredient-item !list-none">
                <label class="ingredient-label">
                  <input
                    type="checkbox"
                    class="ingredient-check"
                    data-ingredient-check
                    data-index={globalIdx}
                  />
                  <span class="checkmark" />
                  <span class="ingredient-text">
                    <span
                      class="amount"
                      data-ingredient-amount
                      data-original-amount={item.amount}
                    >
                      {formatAmount(item.amount)}
                    </span>
                    {item.unit && (
                      <span 
                        class="unit" 
                        data-ingredient-unit 
                        data-original-unit={item.unit}
                      >
                        {formatUnit(item.unit, Number(item.amount) || 0)}
                      </span>
                    )}
                    <span class="name">{item.name}</span>
                    {item.prep && <span class="prep">, {item.prep}</span>}
                    {item.isOptional && (
                      <span class="optional">(optional)</span>
                    )}
                  </span>
                </label>
                {item.notes && <p class="ingredient-note">{item.notes}</p>}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .ingredients-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .group-title {
    font-size: 16px;
    font-weight: 700;
    color: #374151;
    margin: 0 0 12px 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* The horizontal line that spans the remaining space */
  .group-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background-color: #e5e7eb; /* Gray color */
  }

  .group-items {
    list-style: none !important;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Force remove bullets from all li elements inside group-items */
  .group-items li,
  .group-items li.ingredient-item {
    list-style-type: none !important;
    list-style: none !important;
  }

  .group-items li::before,
  .group-items li::after,
  .group-items li::marker {
    content: none !important;
    display: none !important;
  }

  .ingredient-item {
    padding: 12px 16px;
    background: #f9fafb;
    border-radius: 8px;
    transition: background 0.2s;
  }

  .ingredient-item:hover {
    background: #f3f4f6;
  }

  .ingredient-label {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    cursor: pointer;
  }

  .ingredient-check {
    display: none;
  }

  .checkmark {
    width: 22px;
    height: 22px;
    border: 1px solid #d1d5db;
    border-radius: 25%; /* Slightly rounded square, matching the reference image closely */
    flex-shrink: 0;
    margin-top: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }

  .ingredient-check:checked + .checkmark {
    background: #10b981;
    border-color: #10b981;
  }

  .ingredient-check:checked + .checkmark::after {
    content: "✓";
    color: white;
    font-size: 14px;
  }

  .ingredient-check:checked ~ .ingredient-text {
    opacity: 0.5;
    text-decoration: line-through;
  }

  .ingredient-text {
    font-size: 1.125rem;
    line-height: 1.5;
    color: #374151;
  }

  .amount {
    font-weight: 700;
    color: #111827;
    margin-right: 4px;
  }

  .unit {
    color: #6b7280;
    margin-right: 4px;
  }

  .name {
    color: #111827;
  }

  .prep {
    color: #6b7280;
    font-style: italic;
  }

  .optional {
    color: #9ca3af;
    font-size: 13px;
    margin-left: 4px;
  }

  .ingredient-note {
    margin: 6px 0 0 34px;
    font-size: 13px;
    color: #6b7280;
    font-style: italic;
  }

  @media print {
    .ingredient-check {
      display: inline-block;
    }
    .checkmark {
      display: none;
    }
  }
</style>
