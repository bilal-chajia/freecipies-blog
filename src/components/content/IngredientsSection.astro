---
/**
 * IngredientsSection - Recipe ingredients display component
 *
 * Renders grouped ingredients with checkboxes.
 * Supports both legacy string format and new object format.
 */

interface IngredientItem {
    name?: string;
    amount?: string | number;
    unit?: string;
}

interface IngredientGroup {
    group?: string;
    group_title?: string;
    items?: (string | IngredientItem)[];
}

interface Props {
    ingredients: IngredientGroup[] | null | undefined;
    id?: string;
}

const { ingredients, id = "recipe-card" } = Astro.props;

// Early return if no ingredients
if (!ingredients || !Array.isArray(ingredients) || ingredients.length === 0) {
    return null;
}
---

<section id={id} class="content-section ingredients-section">
    <h2>Ingredients</h2>
    {
        ingredients.map((group) => (
            <div class="ingredient-group">
                {(group.group_title || group.group) && (
                    <h3>{group.group_title || group.group}</h3>
                )}
                <ul class="ingredient-list">
                    {group.items &&
                        Array.isArray(group.items) &&
                        group.items.map((item) => {
                            // Handle both legacy string format and new object format
                            const displayText =
                                typeof item === "string"
                                    ? item
                                    : [item.amount, item.unit, item.name]
                                          .filter(Boolean)
                                          .join(" ");
                            return (
                                <li>
                                    <span class="checkbox" />
                                    <span>{displayText}</span>
                                </li>
                            );
                        })}
                </ul>
            </div>
        ))
    }
</section>

<style>
    .ingredients-section h2 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1.5rem;
    }

    .ingredient-group {
        margin-bottom: 1.5rem;
    }

    .ingredient-group h3 {
        font-size: 1.1rem;
        font-weight: 600;
        color: #555;
        margin-bottom: 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #eee;
    }

    .ingredient-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .ingredient-list li {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.625rem 0;
        border-bottom: 1px solid #f5f5f5;
        font-size: 1rem;
        color: #444;
        line-height: 1.5;
    }

    .ingredient-list li:last-child {
        border-bottom: none;
    }

    .checkbox {
        width: 1.25rem;
        height: 1.25rem;
        border: 2px solid #ddd;
        border-radius: 0.25rem;
        flex-shrink: 0;
        margin-top: 0.125rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .checkbox:hover {
        border-color: #f97316;
        background: #fff7ed;
    }

    /* Click to check off */
    .ingredient-list li:has(.checkbox:active) {
        opacity: 0.5;
        text-decoration: line-through;
    }
</style>
