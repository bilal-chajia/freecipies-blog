---
/**
 * Skeleton — Placeholder de chargement shimmer
 * Usage: <Skeleton width="100%" height="200px" radius="xl" />
 */
interface Props {
  width?: string;
  height?: string;
  radius?: "sm" | "md" | "lg" | "xl" | "full";
  class?: string;
  circle?: boolean;
}

const {
  width = "100%",
  height = "1rem",
  radius = "md",
  class: className = "",
  circle = false,
} = Astro.props;

const radiusValue = circle ? "9999px" : `var(--radius-${radius})`;
---

<span
  class:list={["ui-skeleton", className]}
  aria-hidden="true"
  style={`width: ${width}; height: ${height}; border-radius: ${radiusValue};`}
></span>

<style>
  .ui-skeleton {
    display: inline-block;
    background: var(--bg-hover);
    position: relative;
    overflow: hidden;
  }

  .ui-skeleton::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.25) 50%,
      transparent 100%
    );
    transform: translateX(-100%);
    animation: skeleton-shimmer 1.5s infinite;
  }

  @keyframes skeleton-shimmer {
    100% {
      transform: translateX(100%);
    }
  }

  html.dark .ui-skeleton::after {
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.06) 50%,
      transparent 100%
    );
  }
</style>
