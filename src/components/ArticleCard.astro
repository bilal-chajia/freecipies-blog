---
import type { HydratedArticle } from "@modules/articles";
import { extractImage, getImageSrcSet } from "@shared/utils";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  article: HydratedArticle;
  loading?: "lazy" | "eager";
  cardStyle?: "full" | "compact" | "minimal";
  layoutMode?: "grid" | "list" | "masonry";
}

const { article, loading = "lazy", cardStyle = "full", layoutMode = "grid" } = Astro.props;
const isCompact = cardStyle === "compact";
const isMinimal = cardStyle === "minimal";
const isList = layoutMode === "list";

const thumbnail = extractImage(article.imagesJson, "thumbnail", 720);
const cover = extractImage(article.imagesJson, "cover", 720);
const slotName = thumbnail.imageUrl ? "thumbnail" : "cover";
const selected = thumbnail.imageUrl ? thumbnail : cover;
const srcSet = getImageSrcSet(article.imagesJson, slotName);
const sizes = "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 360px";
const listSizes = "(max-width: 768px) 100vw, 320px";
const image = {
  url:
    selected.imageUrl ||
    article.imageUrl ||
    "https://images.unsplash.com/photo-1495521821757-a1efb6729352?w=800&q=80",
  alt: selected.imageAlt || article.imageAlt || article.headline,
  width: selected.imageWidth || article.imageWidth || 800,
  height: selected.imageHeight || article.imageHeight || 600,
  style: selected.imageStyle,
};

// Parse recipeJson if it's a string
const recipe = 'recipeJson' in article && article.recipeJson
  ? typeof article.recipeJson === "string"
    ? JSON.parse(article.recipeJson)
    : article.recipeJson
  : null;

const ratingValue = recipe?.aggregateRating?.ratingValue ?? null;
const ratingCount = recipe?.aggregateRating?.ratingCount ?? 0;
const normalizedRating = ratingValue ? Math.max(0, Math.min(5, ratingValue)) : 0;
const hasRating = ratingValue !== null && ratingCount > 0;
const authorLabel = article.authorName || article.authorSlug || "Unknown";
const ratingStars = Array.from({ length: 5 });
const showBookmark = article.type === "recipe";
---

{isList ? (
  <article class="recipe-list-card">
    <a href={article.route} class="list-image">
      <img
        src={image.url}
        alt={image.alt || article.headline}
        width={image.width || 800}
        height={image.height || 600}
        srcset={srcSet || undefined}
        sizes={srcSet ? listSizes : undefined}
        loading={loading}
        decoding="async"
        style={image.style || undefined}
        class="list-image-img"
      />
      {showBookmark && (
        <button
          type="button"
          class="bookmark-chip"
          data-bookmark-button
          data-bookmark-slug={article.slug}
          aria-pressed="false"
          aria-label="Bookmark recipe"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4a2 2 0 012-2h8a2 2 0 012 2v18l-6-4-6 4V4z" />
          </svg>
        </button>
      )}
    </a>
    <div class="list-content">
      <h3 class="list-title">{article.headline}</h3>
      <div class="list-divider"></div>
      <p class="list-excerpt">{article.shortDescription}</p>
      <div class="list-meta">
        <div class="list-meta-left">
          <span class="meta-item">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.4 0-8 2.2-8 5v1h16v-1c0-2.8-3.6-5-8-5z"
              />
            </svg>
            <span>{authorLabel}</span>
          </span>
          <span class="meta-item">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V3a1 1 0 0 1 1-1zm12 8H5v8h14z"
              />
            </svg>
            <FormattedDate date={article.publishedAt || article.createdAt || undefined} />
          </span>
        </div>
        {hasRating && (
          <div class="list-rating">
            <div class="list-stars">
              {ratingStars.map((_, index) => (
                <svg
                  class:list={["rating-star", { "is-active": normalizedRating >= index + 1 }]}
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M12 2l3.09 6.26 6.91 1-5 4.87 1.18 6.87L12 17.77 5.82 21l1.18-6.87-5-4.87 6.91-1L12 2z" />
                </svg>
              ))}
            </div>
            <span class="rating-text">{normalizedRating.toFixed(1)}/5</span>
          </div>
        )}
      </div>
    </div>
  </article>
) : (
  <article
    class="group bg-white rounded-2xl overflow-hidden shadow-[0_2px_15px_rgba(0,0,0,0.04)] ring-1 ring-gray-100 transition-all duration-300 transform hover:-translate-y-1 flex flex-col h-full"
  >
    <a href={article.route} class="block relative aspect-[4/3] overflow-hidden">
      <!-- Image -->
      <img
        src={image.url}
        alt={image.alt || article.headline}
        width={image.width || 800}
        height={image.height || 600}
        srcset={srcSet || undefined}
        sizes={srcSet ? sizes : undefined}
        loading={loading}
        decoding="async"
        style={image.style || undefined}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
      />
      
      <!-- Favorite Badge -->
      {
        article.isFavorite && (
          <div class="absolute top-3 left-3 bg-[#ff3b5c] text-white px-3 py-1.5 rounded-full text-[10px] uppercase font-bold tracking-[0.05em] flex items-center gap-1.5 z-10 shadow-sm">
            <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
            </svg>
            <span>Featured</span>
          </div>
        )
      }
      
      <!-- Bookmark -->
      {showBookmark && (
        <button
          type="button"
          class="absolute top-3 right-3 flex items-center justify-center w-8 h-8 rounded-full bg-white/95 text-gray-700 shadow-sm hover:scale-110 hover:text-[#ff3b5c] transition-all z-10"
          data-bookmark-button
          data-bookmark-slug={article.slug}
          aria-pressed="false"
          aria-label="Bookmark recipe"
        >
          <svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
          </svg>
        </button>
      )}
    </a>

    <!-- Info -->
    <div class:list={["flex-grow flex flex-col", isMinimal || isCompact ? "p-4" : "p-5"]}>
      <!-- Category & Time Row -->
      <div class:list={["flex items-center gap-2", isMinimal || isCompact ? "mb-2.5" : "mb-3"]}>
        <span
          class="text-[10px] font-bold uppercase tracking-[0.05em] px-2 py-1 rounded bg-opacity-10"
          style={`color: ${article.categoryColor || "#4f46e5"}; background-color: ${article.categoryColor ? article.categoryColor + "1A" : "#4f46e51A"};`}
        >
          {article.categoryLabel || article.categorySlug?.replace(/-/g, " ") || "Uncategorized"}
        </span>
        
        {recipe && recipe.prepTime && String(recipe.prepTime).toLowerCase() !== "n/a" && (
          <>
            <span class="text-gray-300 text-[10px]">•</span>
            <span class="text-[12px] text-gray-400">{recipe.prepTime}</span>
          </>
        )}
      </div>

      <!-- Title -->
      <a href={article.route} class="block group/title focus:outline-none focus:ring-2 focus:ring-blue-500 rounded-sm mb-4">
        <h3
          class:list={[
            "font-serif font-medium text-gray-900 line-clamp-3 leading-[1.3] group-hover/title:text-blue-600 transition-colors tracking-tight",
            isMinimal || isCompact ? "text-lg" : "text-xl",
          ]}
        >
          {article.headline}
        </h3>
      </a>

      <!-- Meta Info Footer -->
      <div
        class:list={[
          "flex items-center justify-between text-gray-400 pt-3.5 mt-auto border-t border-gray-100",
          isCompact ? "text-[11px]" : "text-[12px] font-medium",
        ]}
      >
        <!-- Date -->
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>{new Date(article.publishedAt || article.createdAt || new Date().toISOString()).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
        </div>
        
        <!-- Read Time -->
        <div class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{article.readingTimeMinutes ? `${article.readingTimeMinutes} min read` : '4 min read'}</span>
        </div>
      </div>
    </div>
  </article>
)}

<style>
  /* ===== LIST CARD LAYOUT ===== */
  .recipe-list-card {
    display: grid;
    grid-template-columns: 1fr;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.03);
  }

  /* Horizontal layout at wider widths.
     NOTE: We use @media here (not @container on self) because CSS
     container queries cannot style the container element itself —
     only descendants. The card is always full-width of its parent,
     so a media query is equivalent. */
  @media (min-width: 640px) {
    .recipe-list-card {
      grid-template-columns: 220px 1fr;
    }

    .list-content {
      border-left: 1px solid #e5e7eb;
      border-top: 0;
    }

    .recipe-list-card:has(.list-rating) .list-image {
      min-height: 240px;
    }
  }

  @media (min-width: 768px) {
    .list-title {
      font-size: 1.15rem;
    }

    .list-content {
      padding: 1.5rem 2rem;
    }
  }

  /* :has() selector - Card with bookmark styling */
  .recipe-list-card:has(.bookmark-chip) .list-image {
    --bookmark-offset: 3rem;
  }

  /* :has() selector - Card with rating gets accent border */
  .recipe-list-card:has(.list-rating) {
    border-left: 3px solid #6db24a;
  }

  /* :has() selector - Excerpt truncation based on content */
  .list-content:has(.list-rating) .list-excerpt {
    -webkit-line-clamp: 1;
  }

  .list-image {
    display: block;
    position: relative;
    height: 100%;
    min-height: 140px;
    max-height: 200px;
    overflow: hidden;
  }

  article:has(a):hover .list-image-img {
    transform: scale(1.02);
  }

  .list-image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .bookmark-chip {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25);
    pointer-events: auto;
    border: none;
    z-index: 2;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .recipe-list-card:hover:has(.bookmark-chip) .bookmark-chip {
    transform: scale(1.1);
  }

  .bookmark-chip svg {
    width: 18px;
    height: 18px;
  }

  .bookmark-chip[data-bookmarked="true"] {
    background: rgba(255, 255, 255, 0.9);
    color: #111;
  }

  .list-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
  }

  .list-title {
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #111;
    margin: 0;
  }

  .list-divider {
    width: 42px;
    height: 3px;
    background: #6db24a;
  }

  .list-excerpt {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .list-meta {
    margin-top: 0.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid #eee;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .list-meta-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #666;
    font-size: 0.85rem;
  }

  .meta-item svg {
    width: 16px;
    height: 16px;
    fill: #6b7280;
  }

  .list-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #6db24a;
    font-size: 0.85rem;
  }

  .list-stars {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  .rating-star {
    width: 14px;
    height: 14px;
    fill: #e5e7eb;
  }

  .rating-star.is-active {
    fill: #6db24a;
  }

  .rating-text {
    color: #4b5563;
  }
</style>

