  .preset-btn:hover {
    background: #f3f4f6;
    color: #111827;
  }

  .preset-btn.active {
    background: #111827;
    color: #fff;
    border-color: #111827;
  }

  /* Container-based 2x2 grid is now the default — see .stats-grid above */

  /* ===== Section Navigation ===== */
  .section-nav {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
