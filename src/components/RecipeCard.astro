  .nav-icon {
    width: 24px;
    height: 24px;
    transition: all 0.3s ease;
  }

  .nav-item:hover .nav-icon {
    color: #6b8f71; /* Primary brand green */
    transform: translateY(-2px) scale(1.05);
  }

  .nav-label {
    font-size: 12px;
    font-weight: 500;
  }

  /* ===== Cook Mode Bar ===== */
  .cook-mode-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: clamp(12px, 3cqi, 16px);
    background: #f0fdf4;
    border-radius: 12px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .cook-mode-toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
  }

  .cook-mode-toggle input {
    display: none;
  }

  .toggle-slider {
    width: 48px;
    height: 26px;
    background: #d1d5db;
    border-radius: 13px;
    position: relative;
    transition: background 0.3s;
  }

  .toggle-slider::after {
    content: "";
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.3s;
  }

  .cook-mode-toggle input:checked + .toggle-slider {
    background: #10b981;
  }

  .cook-mode-toggle input:checked + .toggle-slider::after {
    transform: translateX(22px);
  }

  .toggle-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: #111827;
  }

  .toggle-label svg {
    width: 20px;
    height: 20px;
  }

  .cook-mode-hint {
    font-size: 13px;
    color: #6b7280;
  }

  /* ===== Recipe Sections ===== */
  .recipe-sections {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .recipe-section {
    scroll-margin-top: 100px;
  }

  .section-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .section-heading {
    font-size: clamp(20px, 4cqi, 24px);
    font-weight: 700;
    color: #111827;
    margin: 0;
  }

  /* ===== Premium Section Heading Group ===== */
  .section-heading-group {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
    margin-left: calc(-1 * clamp(16px, 4cqi, 24px));
    margin-right: calc(-1 * clamp(16px, 4cqi, 24px));
    padding: 14px clamp(16px, 4cqi, 24px);
    background: linear-gradient(135deg, #f0f7f1 0%, #f8faf8 100%);
    border-left: 4px solid #6b8f71;
    border-radius: 0;
    position: relative;
  }

  .section-heading-group .section-heading {
    margin: 0;
    position: relative;
  }

  .section-heading-group .section-heading::after {
    content: "";
    display: block;
    width: 32px;
    height: 3px;
    background: #6b8f71;
    border-radius: 2px;
    margin-top: 6px;
  }

  .section-heading-icon {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #6b8f71;
    border-radius: 10px;
    color: white;
    flex-shrink: 0;
  }

  .section-heading-icon svg {
    width: 20px;
    height: 20px;
  }

  .clear-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: #f3f4f6;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    color: #6b7280;
    cursor: pointer;
    margin-left: auto;
  }

  .clear-btn:hover {
    background: #e5e7eb;
  }

  .clear-btn svg {
    width: 16px;
    height: 16px;
  }

  /* ===== Equipment List ===== */
  .equipment-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }

  .equipment-item {
