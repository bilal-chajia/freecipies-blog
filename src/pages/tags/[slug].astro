---
import { env } from 'cloudflare:workers';
import Layout from "@layouts/Layout.astro";
import RecipeCard from "@components/RecipeCard.astro";
import { getTagBySlug } from "@modules/tags";
import { getArticles } from "@modules/articles";
import { hydrateArticles } from "@shared/utils/hydration";

const { slug } = Astro.params;

if (!slug) return Astro.redirect("/404");

let tag: any = null;
let articles: any[] = [];
let total = 0;

try {
  if (env.DB) {
    tag = await getTagBySlug(env.DB, slug);
    if (tag) {
      const result = await getArticles(env.DB, {
        tagSlug: slug,
      });
      articles = result.items;
      total = result.total;
    }
  }
} catch (error) {
  console.error(`Error fetching tag recipes (${slug}):`, error);
}

if (!tag) return Astro.redirect("/404");
---

<Layout
  title={`${tag.label} Recipes`}
  description={`Discover delicious recipes tagged with ${tag.label}`}
>
  <main class="tag-archive">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-container">
        <h1 class="hero-title">{tag.label}</h1>
        <div class="tag-meta">
          <span class="recipe-count"
            >{total} {total === 1 ? "recipe" : "recipes"}</span
          >
        </div>
      </div>
    </section>

    <!-- Recipes Grid -->
    <section class="recipes-section">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">Recipes tagged "{tag.label}"</h2>
        </div>
        {
          articles.length > 0 ? (
            <div class="recipes-grid">
              {articles.map((article) => (
                <RecipeCard article={article} recipe_json={article.recipe_json} />
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <p>No recipes found with this tag.</p>
            </div>
          )
        }
      </div>
    </section>

    <!-- Back to Tags -->
    <section class="back-section">
      <div class="section-container">
        <a href="/tags" class="back-link">← Browse all tags</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .tag-archive {
    min-height: 100vh;
  }

  .hero-section {
    background: var(--bg-alt);
    padding: clamp(var(--space-12), 8vw, var(--space-20)) 0;
    text-align: center;
  }

  .hero-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 clamp(var(--space-4), 3vw, var(--space-6));
  }

  .hero-title {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-5xl));
    font-weight: var(--font-extrabold);
    margin: 0 0 var(--space-3) 0;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .tag-meta {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
  }

  .recipe-count {
    background: var(--bg-elevated);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
  }

  .recipes-section {
    padding: clamp(var(--space-12), 8vw, var(--space-20)) 0;
    background: var(--bg);
  }

  .section-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 clamp(var(--space-4), 3vw, var(--space-6));
  }

  .section-header {
    margin-bottom: var(--space-8);
  }

  .section-title {
    font-size: clamp(var(--text-2xl), 3vw, var(--text-3xl));
    font-weight: var(--font-bold);
    margin: 0;
    color: var(--text);
  }

  .recipes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-8);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-16) 0;
    color: var(--text-secondary);
  }

  .back-section {
    padding: var(--space-8) 0;
    background: var(--bg-elevated);
    border-top: 1px solid var(--border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--brand-primary);
    text-decoration: none;
    font-weight: var(--font-medium);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--brand-primary-hover);
  }

  @media (max-width: 768px) {
    .recipes-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: var(--space-6);
    }
  }
</style>
