---
import { env } from 'cloudflare:workers';
import Layout from "@layouts/Layout.astro";
import AuthorCard from "@components/AuthorCard.astro";
import { getAuthors } from "@modules/authors";
import { getArticles } from "@modules/articles";
import { hydrateAuthor } from "@shared/utils";
let authors: any[] = [];
let authorArticleCounts = new Map<string, number>();

try {
  const rawAuthors = await getAuthors(env.DB, { workflow_status: 'published' });
  authors = rawAuthors.map(hydrateAuthor);

  // Get article counts for each author
  for (const author of authors) {
    try {
      const { total } = await getArticles(env.DB, { authorSlug: author.slug });
      authorArticleCounts.set(author.slug, total);
    } catch (e) {
      authorArticleCounts.set(author.slug, 0);
    }
  }
} catch (error) {
  console.error("Authors index: Error fetching authors:", error);
}

const pageTitle = "Our Recipe Creators - SaaS Blog";
const pageDescription =
  "Meet the talented chefs and food enthusiasts behind our delicious recipes. Discover their culinary journeys and cooking expertise.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="authors-page">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-container">
        <h1 class="hero-title">Meet Our Creators</h1>
        <p class="hero-subtitle">
          Talented chefs and food enthusiasts sharing their passion through
          delicious recipes
        </p>
      </div>
    </section>

    <!-- Authors Grid -->
    <section class="authors-section">
      <div class="section-container">
        <h2 class="sr-only">Author list</h2>
        {
          authors.length > 0 ? (
            <div class="authors-grid">
              {authors.map((author) => (
                <AuthorCard
                  author={author}
                  showArticleCount={true}
                  articleCount={authorArticleCounts.get(author.slug) || 0}
                />
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <p>No authors found.</p>
            </div>
          )
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .authors-page {
    min-height: 100vh;
  }

  .hero-section {
    background: var(--bg-alt);
    padding: clamp(var(--space-12), 8vw, var(--space-20)) 0;
    text-align: center;
  }

  .hero-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 clamp(var(--space-4), 3vw, var(--space-6));
  }

  .hero-title {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-5xl));
    font-weight: var(--font-extrabold);
    margin: 0 0 var(--space-4) 0;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: clamp(var(--text-base), 2vw, var(--text-lg));
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin: 0;
  }

  .authors-section {
    padding: clamp(var(--space-12), 8vw, var(--space-20)) 0;
    background: var(--bg);
  }

  .section-container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 clamp(var(--space-4), 3vw, var(--space-6));
  }

  .authors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-8);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-16) 0;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .authors-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: var(--space-6);
    }
  }
</style>
