---
import Layout from "@layouts/Layout.astro";
---

<Layout
	title="About Us | SaaS Blog"
	description="Learn about SaaS Blog - your destination for delicious, easy-to-follow recipes from around the world."
>
	<main class="about-page">
		<!-- Hero Section -->
		<section class="hero">
			<div class="hero-content">
				<h1>About <span class="highlight">SaaS Blog</span></h1>
				<p class="tagline">Where passion meets flavor</p>
			</div>
		</section>

		<!-- Mission Section -->
		<section class="mission">
			<div class="container">
				<div class="mission-content">
					<div class="mission-icon">🍳</div>
					<h2>Our Mission</h2>
					<p>
						At SaaS Blog, we believe that great food should be
						accessible to everyone. Our mission is to inspire home
						cooks around the world with delicious, easy-to-follow
						recipes that bring joy to the kitchen and smiles to the
						table.
					</p>
				</div>
			</div>
		</section>

		<!-- Story Section -->
		<section class="story">
			<div class="container">
				<div class="story-grid">
					<div class="story-image">
						<div class="image-placeholder">
							<span>🥘</span>
						</div>
					</div>
					<div class="story-text">
						<h2>Our Story</h2>
						<p>
							SaaS Blog started with a simple idea: sharing the
							recipes we love with the world. What began as a
							small collection of family favorites has grown into
							a vibrant community of food lovers.
						</p>
						<p>
							Every recipe on our site is carefully tested and
							crafted to ensure success in your kitchen. From
							quick weeknight dinners to impressive weekend
							feasts, we've got you covered.
						</p>
						<p>
							We're passionate about celebrating diverse cuisines,
							supporting local ingredients, and making cooking an
							enjoyable experience for everyone—whether you're a
							beginner or a seasoned chef.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Values Section -->
		<section class="values">
			<div class="container">
				<h2>What We Stand For</h2>
				<div class="values-grid">
					<div class="value-card">
						<div class="value-icon">✨</div>
						<h3>Quality</h3>
						<p>
							Every recipe is tested multiple times to ensure
							perfect results every time.
						</p>
					</div>
					<div class="value-card">
						<div class="value-icon">🌍</div>
						<h3>Diversity</h3>
						<p>
							We celebrate cuisines from around the world,
							bringing global flavors to your kitchen.
						</p>
					</div>
					<div class="value-card">
						<div class="value-icon">💚</div>
						<h3>Sustainability</h3>
						<p>
							We promote seasonal ingredients and sustainable
							cooking practices.
						</p>
					</div>
					<div class="value-card">
						<div class="value-icon">👨‍👩‍👧‍👦</div>
						<h3>Community</h3>
						<p>
							We're building a community where food lovers can
							share, learn, and grow together.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Stats Section -->
		<section class="stats">
			<div class="container">
				<div class="stats-grid">
					<div class="stat-item">
						<span class="stat-number">1000+</span>
						<span class="stat-label">Recipes</span>
					</div>
					<div class="stat-item">
						<span class="stat-number">50K+</span>
						<span class="stat-label">Happy Cooks</span>
					</div>
					<div class="stat-item">
						<span class="stat-number">25+</span>
						<span class="stat-label">Cuisines</span>
					</div>
					<div class="stat-item">
						<span class="stat-number">100%</span>
						<span class="stat-label">Free Forever</span>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="cta">
			<div class="container">
				<h2>Ready to Start Cooking?</h2>
				<p>
					Explore our collection of delicious recipes and find your
					next favorite dish.
				</p>
				<a href="/recipes" class="cta-button">Browse Recipes</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	.about-page {
		--primary-color: var(--brand-primary);
		--text-dark: var(--text);
		--text-light: var(--text-secondary);
		--bg-light: var(--bg-alt);
	}

	.container {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 var(--space-6);
	}

	/* Hero Section */
	.hero {
		background: var(--brand-gradient);
		padding: var(--space-24) var(--space-6);
		text-align: center;
		color: var(--text-inverse);
	}

	.hero h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: var(--font-extrabold);
		margin: 0 0 var(--space-4);
	}

	.hero .highlight {
		display: block;
	}

	.tagline {
		font-size: var(--text-xl);
		opacity: 0.9;
		margin: 0;
	}

	/* Mission Section */
	.mission {
		padding: var(--space-20) 0;
		background: var(--bg-elevated);
	}

	.mission-content {
		max-width: 700px;
		margin: 0 auto;
		text-align: center;
	}

	.mission-icon {
		font-size: calc(4 * var(--text-base));
		margin-bottom: var(--space-6);
	}

	.mission h2 {
		font-size: var(--text-3xl);
		color: var(--text-dark);
		margin: 0 0 var(--space-5);
	}

	.mission p {
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--text-light);
		margin: 0;
	}

	/* Story Section */
	.story {
		padding: var(--space-20) 0;
		background: var(--bg-light);
	}

	.story-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-14);
		align-items: center;
	}

	.story-image {
		aspect-ratio: 1;
		border-radius: var(--radius-xl);
		overflow: hidden;
	}

	.image-placeholder {
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, var(--brand-primary-light), var(--bg-inset));
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: calc(8 * var(--text-base));
	}

	.story-text h2 {
		font-size: var(--text-3xl);
		color: var(--text-dark);
		margin: 0 0 var(--space-6);
	}

	.story-text p {
		font-size: var(--text-base);
		line-height: var(--leading-relaxed);
		color: var(--text-light);
		margin: 0 0 var(--space-4);
	}

	.story-text p:last-child {
		margin-bottom: 0;
	}

	/* Values Section */
	.values {
		padding: var(--space-20) 0;
		background: var(--bg-elevated);
		text-align: center;
	}

	.values h2 {
		font-size: var(--text-3xl);
		color: var(--text-dark);
		margin: 0 0 var(--space-12);
	}

	.values-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-8);
	}

	.value-card {
		padding: var(--space-8) var(--space-6);
		background: var(--bg-light);
		border-radius: var(--radius-lg);
		transition:
			transform var(--transition-base),
			box-shadow var(--transition-base);
	}

	.value-card:hover {
		transform: translateY(calc(-1 * var(--space-2)));
		box-shadow: var(--shadow-xl);
	}

	.value-icon {
		font-size: var(--text-5xl);
		margin-bottom: var(--space-4);
	}

	.value-card h3 {
		font-size: var(--text-xl);
		color: var(--text-dark);
		margin: 0 0 var(--space-3);
	}

	.value-card p {
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		color: var(--text-light);
		margin: 0;
	}

	/* Stats Section */
	.stats {
		padding: var(--space-14) 0;
		background: linear-gradient(135deg, var(--neutral-950), var(--neutral-900));
		color: var(--text-inverse);
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--space-8);
		text-align: center;
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.stat-number {
		font-size: var(--text-4xl);
		font-weight: var(--font-extrabold);
		color: var(--primary-color);
	}

	.stat-label {
		font-size: var(--text-base);
		opacity: 0.8;
	}

	/* CTA Section */
	.cta {
		padding: var(--space-20) 0;
		background: var(--bg-light);
		text-align: center;
	}

	.cta h2 {
		font-size: var(--text-3xl);
		color: var(--text-dark);
		margin: 0 0 var(--space-4);
	}

	.cta p {
		font-size: var(--text-lg);
		color: var(--text-light);
		margin: 0 0 var(--space-8);
	}

	.cta-button {
		display: inline-block;
		padding: var(--space-4) var(--space-10);
		background: var(--brand-gradient);
		color: var(--text-inverse);
		text-decoration: none;
		font-weight: var(--font-bold);
		font-size: var(--text-base);
		border-radius: var(--radius-full);
		transition:
			transform var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.cta-button:hover {
		transform: translateY(calc(-3 * var(--space-px)));
		box-shadow: var(--shadow-lg);
	}

	/* Responsive */
	@media (max-width: 900px) {
		.story-grid {
			grid-template-columns: 1fr;
			gap: var(--space-10);
		}

		.story-image {
			max-width: 400px;
			margin: 0 auto;
		}

		.values-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.stats-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.hero {
			padding: var(--space-14) var(--space-6);
		}

		.mission,
		.story,
		.values,
		.cta {
			padding: var(--space-14) 0;
		}

		.values-grid {
			grid-template-columns: 1fr;
		}

		.stats-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-6);
		}

		.stat-number {
			font-size: var(--text-3xl);
		}
	}
</style>
