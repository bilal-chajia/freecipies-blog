---
import { env } from 'cloudflare:workers';
import Layout from "@layouts/Layout.astro";
import { getArticles } from "@modules/articles";
import { getCategories } from "@modules/categories";
import {
  hydrateArticles,
  hydrateCategories,
} from "@shared/utils/hydration";
import { extractImage, getImageSrcSet } from "@shared/utils";

export const prerender = false;

const url = Astro.url;
const page = parseInt(url.searchParams.get("page") || "1");
const limit = 12;
const offset = (page - 1) * limit;

let roundups: any[] = [];
let totalRoundups = 0;
let categories: any[] = [];

try {
  if (env.DB) {
    const result = await getArticles(env.DB, {
      type: "roundup",
      isOnline: true,
      limit,
      offset,
    });
    roundups = result.items;
    totalRoundups = result.total;

    const rawCategories = await getCategories(env.DB, { isOnline: true });
    categories = hydrateCategories(rawCategories);
  }
} catch (error) {
  console.error("Error fetching roundups:", error);
}

const totalPages = Math.ceil(totalRoundups / limit);

const getCardImage = (article: any) => {
  const cover = extractImage(article.imagesJson, "cover", 600);
  const thumbnail = extractImage(article.imagesJson, "thumbnail", 600);
  const selected = cover.imageUrl ? cover : thumbnail;
  const slotName = cover.imageUrl ? "cover" : "thumbnail";
  const srcSet = getImageSrcSet(article.imagesJson, slotName);
  return { selected, srcSet };
};

const siteTitle = "Recipe Roundups & Collections - Freecipies";
const siteDescription = "Curated collections of our best recipes, hand-picked for every occasion.";
---

<Layout title={siteTitle} description={siteDescription}>
  <main class="roundups-page">
    <section class="page-header">
      <div class="container">
        <h1 class="page-title">
          <span class="title-dot"></span>
          Recipe Roundups
        </h1>
        <p class="subtitle">Hand-picked collections of our favorite dishes for every occasion.</p>
        <div class="header-divider"></div>
      </div>
    </section>

    <section class="roundups-grid-section">
      <div class="container">
        {roundups.length > 0 ? (
          <div class="roundups-grid">
            {roundups.map((roundup) => {
              const { selected, srcSet } = getCardImage(roundup);
              return (
                <article class="roundup-card">
                  <a href={`/roundups/${roundup.slug}`} class="card-image-link">
                    {selected.imageUrl && (
                      <img
                        src={selected.imageUrl}
                        alt={selected.imageAlt || roundup.headline}
                        width={selected.imageWidth || 600}
                        height={selected.imageHeight || 400}
                        srcset={srcSet || undefined}
                        sizes="(max-width: 768px) 100vw, 400px"
                        loading="lazy"
                        style={selected.imageStyle}
                      />
                    )}
                    <div class="card-overlay">
                      <span class="item-count">
                        {Array.isArray(roundup.roundupJson?.items) ? roundup.roundupJson.items.length : 0} Items
                      </span>
                    </div>
                  </a>
                  <div class="card-body">
                    <h2 class="card-title">
                      <a href={`/roundups/${roundup.slug}`}>{roundup.headline}</a>
                    </h2>
                    {roundup.shortDescription && (
                      <p class="card-excerpt">{roundup.shortDescription}</p>
                    )}
                    <a href={`/roundups/${roundup.slug}`} class="read-more">
                      Explore Collection 
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="no-results">
            <p>No roundups found. We're currently curating our first collections!</p>
          </div>
        )}

        {totalPages > 1 && (
          <nav class="pagination">
            {page > 1 && (
              <a href={`/roundups?page=${page - 1}`} class="page-btn">← Previous</a>
            )}
            <div class="page-numbers">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                <a href={`/roundups?page=${p}`} class:list={["page-num", { active: p === page }]}>{p}</a>
              ))}
            </div>
            {page < totalPages && (
              <a href={`/roundups?page=${page + 1}`} class="page-btn">Next →</a>
            )}
          </nav>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .roundups-page {
    background: #fff;
    min-height: 100vh;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-header {
    padding: 5rem 0 3rem;
    text-align: center;
  }

  .page-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    color: #111;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    font-family: "Playfair Display", Georgia, serif;
  }

  .title-dot {
    display: inline-block;
    width: 14px;
    height: 14px;
    background: #ff6600;
    border-radius: 50%;
    margin-right: 0.5rem;
  }

  .subtitle {
    font-size: 1.25rem;
    color: #666;
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .header-divider {
    width: 80px;
    height: 4px;
    background: #111;
    margin: 0 auto;
    border-radius: 2px;
  }

  .roundups-grid-section {
    padding-bottom: 6rem;
  }

  .roundups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 3rem;
  }

  .roundup-card {
    display: flex;
    flex-direction: column;
    group-hover: transform translateY(-8px);
    transition: transform 0.3s ease;
  }

  .card-image-link {
    display: block;
    position: relative;
    aspect-ratio: 4/3;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }

  .card-image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .roundup-card:hover .card-image-link img {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    display: flex;
    gap: 0.5rem;
  }

  .item-count {
    background: rgba(0,0,0,0.7);
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-title {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.25;
    margin: 0;
    font-family: "Playfair Display", Georgia, serif;
  }

  .card-title a {
    text-decoration: none;
    color: #111;
    transition: color 0.2s;
  }

  .card-title a:hover {
    color: #ff6600;
  }

  .card-excerpt {
    font-size: 1.05rem;
    color: #555;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: #111;
    text-decoration: none;
    font-size: 0.9375rem;
    margin-top: 0.5rem;
    transition: color 0.2s;
  }

  .read-more:hover {
    color: #ff6600;
  }

  .read-more svg {
    transition: transform 0.2s;
  }

  .read-more:hover svg {
    transform: translateX(4px);
  }

  .no-results {
    text-align: center;
    padding: 4rem 0;
    color: #666;
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-top: 5rem;
  }

  .page-num {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    text-decoration: none;
    color: #111;
    font-weight: 700;
    transition: all 0.2s;
  }

  .page-num.active {
    background: #ff6600;
    color: white;
  }

  .page-btn {
    font-weight: 700;
    text-decoration: none;
    color: #111;
  }

  .page-btn:hover {
    color: #ff6600;
  }

  /* Dark mode */
  :global(.dark) .roundups-page { background: #0f172a; }
  :global(.dark) .page-title { color: #f8fafc; }
  :global(.dark) .subtitle { color: #9ca3af; }
  :global(.dark) .header-divider { background: #ff6600; }
  :global(.dark) .card-title a { color: #f3f4f6; }
  :global(.dark) .card-excerpt { color: #9ca3af; }
  :global(.dark) .read-more { color: #f8fafc; }
</style>
