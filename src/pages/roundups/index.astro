---
import { env } from 'cloudflare:workers';
import Layout from "@layouts/Layout.astro";
import { getArticles } from "@modules/articles";
import { getCategories } from "@modules/categories";
import {
  hydrateArticles,
  hydrateCategories,
} from "@shared/utils/hydration";
import { extractImage, getImageSrcSet } from "@shared/utils";
import { parseCachedCard } from "@modules/articles/utils/cached-fields";

export const prerender = false;

const url = Astro.url;
const page = parseInt(url.searchParams.get("page") || "1");
const limit = 12;
const offset = (page - 1) * limit;

let roundups: any[] = [];
let totalRoundups = 0;
let categories: any[] = [];

try {
  if (env.DB) {
    const result = await getArticles(env.DB, {
      type: "roundup",
      workflow_status: "published",
      limit,
      offset,
    });
    roundups = result.items;
    totalRoundups = result.total;

    const rawCategories = await getCategories(env.DB, { workflow_status: "published" });
    categories = hydrateCategories(rawCategories);
  }
} catch (error) {
  console.error("Error fetching roundups:", error);
}

const totalPages = Math.ceil(totalRoundups / limit);

const getCardImage = (article: any) => {
  const hero = extractImage(article.images_json, "hero", 600);
  const thumbnail = extractImage(article.images_json, "thumbnail", 600);
  const selected = hero.image_url ? hero : thumbnail;
  const slotName = hero.image_url ? "hero" : "thumbnail";
  const srcSet = getImageSrcSet(article.images_json, slotName);
  return { selected, srcSet };
};

const siteTitle = "Recipe Roundups & Collections - SaaS Blog";
const siteDescription = "Curated collections of our best recipes, hand-picked for every occasion.";
---

<Layout title={siteTitle} description={siteDescription}>
  <main class="roundups-page">
    <section class="page-header">
      <div class="container">
        <h1 class="page-title">
          <span class="title-dot"></span>
          Recipe Roundups
        </h1>
        <p class="subtitle">Hand-picked collections of our favorite dishes for every occasion.</p>
        <div class="header-divider"></div>
      </div>
    </section>

    <section class="roundups-grid-section">
      <div class="container">
        {roundups.length > 0 ? (
          <div class="roundups-grid">
            {roundups.map((roundup) => {
              const { selected, srcSet } = getCardImage(roundup);
              const cachedCard = parseCachedCard(roundup.cached_card_json);
              const itemCount = cachedCard?.item_count ?? 0;
              return (
                <article class="roundup-card">
                  <a href={`/roundups/${roundup.slug}`} class="card-image-link">
                    {selected.image_url && (
                      <img
                        src={selected.image_url}
                        alt={selected.imageAlt || roundup.headline}
                        width={selected.imageWidth || 600}
                        height={selected.imageHeight || 400}
                        srcset={srcSet || undefined}
                        sizes="(max-width: 768px) 100vw, 400px"
                        loading="lazy"
                        style={selected.imageStyle}
                      />
                    )}
                    <div class="card-overlay">
                      <span class="item-count">
                        {itemCount} Items
                      </span>
                    </div>
                  </a>
                  <div class="card-body">
                    <h2 class="card-title">
                      <a href={`/roundups/${roundup.slug}`}>{roundup.headline}</a>
                    </h2>
                    {roundup.short_description && (
                      <p class="card-excerpt">{roundup.short_description}</p>
                    )}
                    <a href={`/roundups/${roundup.slug}`} class="read-more">
                      Explore Collection 
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="no-results">
            <p>No roundups found. We're currently curating our first collections!</p>
          </div>
        )}

        {totalPages > 1 && (
          <nav class="pagination">
            {page > 1 && (
              <a href={`/roundups?page=${page - 1}`} class="page-btn">← Previous</a>
            )}
            <div class="page-numbers">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                <a href={`/roundups?page=${p}`} class:list={["page-num", { active: p === page }]}>{p}</a>
              ))}
            </div>
            {page < totalPages && (
              <a href={`/roundups?page=${page + 1}`} class="page-btn">Next →</a>
            )}
          </nav>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .roundups-page {
    background: var(--bg);
    min-height: 100vh;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .page-header {
    padding: var(--space-20) 0 var(--space-12);
    text-align: center;
  }

  .page-title {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-5xl));
    font-weight: var(--font-extrabold);
    color: var(--text);
    margin-bottom: var(--space-6);
    letter-spacing: -0.02em;
    font-family: var(--font-heading);
  }

  .title-dot {
    display: inline-block;
    width: 14px;
    height: 14px;
    background: var(--brand-primary);
    border-radius: var(--radius-full);
    margin-right: var(--space-2);
  }

  .subtitle {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto var(--space-8);
    line-height: var(--leading-relaxed);
  }

  .header-divider {
    width: 80px;
    height: 4px;
    background: var(--text);
    margin: 0 auto;
    border-radius: var(--radius-xs);
  }

  .roundups-grid-section {
    padding-bottom: var(--space-24);
  }

  .roundups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: var(--space-12);
  }

  .roundup-card {
    display: flex;
    flex-direction: column;
    group-hover: transform translateY(-8px);
    transition: transform var(--transition-slow);
  }

  .card-image-link {
    display: block;
    position: relative;
    aspect-ratio: 4/3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-6);
    box-shadow: var(--shadow-md);
  }

  .card-image-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .roundup-card:hover .card-image-link img {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    top: var(--space-6);
    left: var(--space-6);
    display: flex;
    gap: var(--space-2);
  }

  .item-count {
    background: var(--bg-overlay);
    color: var(--text-inverse);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
    backdrop-filter: blur(4px);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-title {
    font-size: var(--text-3xl);
    font-weight: var(--font-extrabold);
    line-height: var(--leading-tight);
    margin: 0;
    font-family: var(--font-heading);
  }

  .card-title a {
    text-decoration: none;
    color: var(--text);
    transition: color var(--transition-fast);
  }

  .card-title a:hover {
    color: var(--brand-primary);
  }

  .card-excerpt {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--font-bold);
    color: var(--text);
    text-decoration: none;
    font-size: var(--text-sm);
    margin-top: var(--space-2);
    transition: color var(--transition-fast);
  }

  .read-more:hover {
    color: var(--brand-primary);
  }

  .read-more svg {
    transition: transform var(--transition-fast);
  }

  .read-more:hover svg {
    transform: translateX(4px);
  }

  .no-results {
    text-align: center;
    padding: var(--space-16) 0;
    color: var(--text-secondary);
  }

  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-20);
  }

  .page-num {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    text-decoration: none;
    color: var(--text);
    font-weight: var(--font-bold);
    transition: all var(--transition-fast);
  }

  .page-num.active {
    background: var(--brand-primary);
    color: var(--text-inverse);
  }

  .page-btn {
    font-weight: var(--font-bold);
    text-decoration: none;
    color: var(--text);
  }

  .page-btn:hover {
    color: var(--brand-primary);
  }
</style>
