---
import { env } from 'cloudflare:workers';
import RoundupLayout from "@layouts/RoundupLayout.astro";
import SEO from "@components/SEO.astro";
import { getArticleBySlug, getArticleById } from "@modules/articles";
import { getAuthorById } from "@modules/authors/services/authors.service";
import { getCategoryById } from "@modules/categories/services/categories.service";
import { extractImage } from "@shared/utils";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  return new Response("Slug is missing", { status: 400 });
}

let roundup: any = null;
let author: any = null;
let category: any = null;

try {
  if (env.DB) {
    // Smart routing: support both numeric ID and slug
    const isNumeric = /^\d+$/.test(slug);
    if (isNumeric) {
      roundup = await getArticleById(env.DB, parseInt(slug));
      // Ensure it's a roundup
      if (roundup && roundup.type !== 'roundup') {
        roundup = null;
      }
    } else {
      roundup = await getArticleBySlug(env.DB, slug, "roundup");
    }

    if (roundup) {
      if (roundup.authorId) {
        author = await getAuthorById(env.DB, roundup.authorId);
      }
      if (roundup.categoryId) {
        category = await getCategoryById(env.DB, roundup.categoryId);
      }
    }
  }
} catch (error) {
  console.error(`Error fetching roundup (${slug}):`, error);
}

if (!roundup) {
  return Astro.redirect("/404");
}

const heroCover = extractImage(roundup.imagesJson, "cover", 1200);
const heroThumb = extractImage(roundup.imagesJson, "thumbnail", 1200);
const heroImage = heroCover.imageUrl ? heroCover : heroThumb;

const pageTitle = roundup.metaTitle || roundup.headline;
const pageDescription = roundup.metaDescription || roundup.shortDescription;
const faqs = typeof roundup.faqsJson === 'string' ? JSON.parse(roundup.faqsJson || '[]') : (roundup.faqsJson || []);

// Parse roundupJson for the content
const parsedRoundupJson = typeof roundup.roundupJson === 'string'
  ? JSON.parse(roundup.roundupJson || '{"items":[]}')
  : (roundup.roundupJson || { items: [] });
---

<RoundupLayout article={roundup} author={author} category={category} roundupJson={parsedRoundupJson}>
  <SEO
    slot="head"
    title={pageTitle}
    description={pageDescription}
    type="article"
    publishedTime={roundup.publishedAt || undefined}
    modifiedTime={roundup.updatedAt || roundup.publishedAt || undefined}
    author={{ 
      name: author?.name || "Freecipies Team",
      url: author?.slug ? `${Astro.url.origin}/authors/${author.slug}` : undefined
    }}
    image={heroImage.imageUrl || roundup.imageUrl || ""}
    imageAlt={heroImage.imageAlt || roundup.imageAlt || undefined}
    faqs={faqs}
    roundup={{
      itemList: roundup.jsonldJson
    }}
  />
</RoundupLayout>

