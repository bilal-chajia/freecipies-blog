---
// src/pages/api/preview/render.astro
import { env } from 'cloudflare:workers';
import RecipeLayout from "@layouts/RecipeLayout.astro";
import { getAuthorById } from "@modules/authors/services/authors.service";
import { getCategoryById } from "@modules/categories/services/categories.service";
import { getArticleBySlug } from "@modules/articles/services/articles.service";
import { normalizeContentDocument } from "@modules/content-blocks";

if (Astro.request.method !== "POST") {
    return new Response("Method Not Allowed", { status: 405 });
}

let formData;
try {
    formData = await Astro.request.json();
} catch (e) {
    return new Response("Invalid JSON", { status: 400 });
}

const db = env?.DB;
let author = null;
let category = null;
let savedArticle = null;

if (db) {
    // Fetch the saved article from DB to get server-side fields
    // (cached_toc_json, faqs_json, etc.)
    if (formData.slug) {
        savedArticle = await getArticleBySlug(db, formData.slug).catch(
            () => null,
        );
    }

    if (formData.author_id) {
        author = await getAuthorById(db, formData.author_id).catch(() => null);
    }
    if (formData.category_id) {
        category = await getCategoryById(db, formData.category_id).catch(
            () => null,
        );
    }
}

// --- Parse recipe_json safely with defaults ---
let parsedRecipe = {};
try {
    parsedRecipe =
        typeof formData.recipe_json === "string"
            ? JSON.parse(formData.recipe_json || "{}")
            : formData.recipe_json || {};
} catch (e) {
    console.warn("[preview/render] Failed to parse recipe_json:", e);
}

const recipe_json = JSON.stringify({
    ingredients: [],
    instructions: [],
    equipment: [],
    ...parsedRecipe,
});

const content_json = normalizeContentDocument(formData.content_json);

// --- Parse images_json safely ---
const images_json =
    typeof formData.imagesData === "string"
        ? formData.imagesData
        : JSON.stringify({
              hero: { url: formData.heroUrl },
              ...formData.imagesData,
          });

// Use saved article's cached fields when available (these are built server-side on save)
const cached_toc_json = savedArticle?.cached_toc_json ?? null;
const faqs_json = savedArticle?.faqs_json ?? formData.faqs_json ?? null;

// Format the data exactly as RecipeLayout.astro expects on the `recipe` object
const recipe = {
    // Core identifiers
    id: savedArticle?.id || "preview",
    slug: formData.slug || "preview",

    // Title & text
    headline: formData.label || "Preview Title",
    short_description: formData.summary || "Preview Description",
    tldr: formData.tldr || null,

    // Type
    type: formData.type || "recipe",

    // JSON data blobs  (form data overrides saved for editable fields)
    recipe_json: recipe_json,
    content_json: content_json,
    images_json: images_json,

    // Server-side cached fields  (always from saved article)
    faqs_json: faqs_json,
    cached_toc_json: cached_toc_json,

    // SEO
    metaTitle: formData.metaTitle,
    metaDescription: formData.metaDescription,

    // Images
    image_url: formData.heroUrl || undefined,
    imageAlt: formData.label || "Preview Image",

    // Category references (hydrated from DB or formData) — nested snake_case
    category: (category || formData.categoryLabel) ? {
      label: category?.label ?? formData.categoryLabel ?? null,
      slug: category?.slug ?? formData.categorySlug ?? null,
      color: category?.color ?? formData.categoryColor ?? null,
    } : null,

    // Author references — nested snake_case
    author: (author || formData.authorName) ? {
      name: author?.name ?? formData.authorName ?? null,
      slug: author?.slug ?? formData.authorSlug ?? null,
    } : null,

    // Dates
    published_at: formData.published_at || savedArticle?.published_at || null,

    // Stats
    view_count: savedArticle?.view_count || 0,
};
---

<RecipeLayout recipe={recipe} author={author} category={category} />
