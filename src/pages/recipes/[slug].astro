---
import { env } from 'cloudflare:workers';
import RecipeLayout from "@layouts/RecipeLayout.astro";
import SEO from "@components/SEO.astro";
import { getArticleBySlug } from "@modules/articles";
import { getAuthorById } from "@modules/authors/services/authors.service";
import { getCategoryById } from "@modules/categories/services/categories.service";
import { extractImage, getImageSrcSet } from "@shared/utils";
import type { RecipeDetails, RecipeContent, IngredientGroup, IngredientItem, InstructionSection, InstructionStep } from "@modules/articles/types";
import type { Author } from "@modules/authors/schema/authors.schema";
import type { Category } from "@modules/categories/schema/categories.schema";

/**
 * In SSR mode, Astro doesn't require getStaticPaths.
 * It renders pages on-demand. We get the slug from Astro.params.
 */

const { slug } = Astro.params;

if (!slug) {
  return new Response("Slug is missing", { status: 400 });
}

let recipe: any = null;

try {
  if (env.DB) {
    recipe = await getArticleBySlug(env.DB, slug, "recipe");
  }
} catch (error) {
  console.error(`Error fetching recipe (${slug}):`, error);
}

// If no recipe is found for the slug, return a 404 page.
if (!recipe) {
  return Astro.redirect("/404");
}

const author = recipe.author;
const category = recipe.category;

const recipeDetails = (recipe as RecipeContent | null)?.recipeJson || undefined;

const heroCover = extractImage(recipe.imagesJson, "cover", 1200);
const heroThumb = extractImage(recipe.imagesJson, "thumbnail", 1200);
const coverSrcSet = getImageSrcSet(recipe.imagesJson, "cover");
const thumbSrcSet = getImageSrcSet(recipe.imagesJson, "thumbnail");
const useCover = heroCover.imageUrl && (coverSrcSet || !heroThumb.imageUrl);
const heroImage = useCover ? heroCover : heroThumb;

const recipeDetailsObj = typeof recipeDetails === 'string' ? JSON.parse(recipeDetails) : recipeDetails;
const faqs = typeof recipe.faqsJson === 'string' ? JSON.parse(recipe.faqsJson || '[]') : (recipe.faqsJson || []);

const pageTitle = recipe.metaTitle || recipe.headline;
const pageDescription = recipe.metaDescription || recipe.shortDescription;
---

<RecipeLayout recipe={recipe} author={author} category={category}>
  <SEO
    slot="head"
    title={pageTitle}
    description={pageDescription}
    type="recipe"
    publishedTime={recipe.publishedAt || undefined}
    modifiedTime={recipe.updatedAt || recipe.publishedAt || undefined}
    author={{ 
      name: author?.name || "Freecipies Team",
      url: author?.slug ? `${Astro.url.origin}/authors/${author.slug}` : undefined
    }}
    image={heroImage.imageUrl || recipe.imageUrl || ""}
    imageAlt={heroImage.imageAlt || recipe.imageAlt || undefined}
    faqs={faqs}
    recipe={{
      name: recipe.headline || recipe.label,
      description: recipe.shortDescription,
      image: heroImage.imageUrl || recipe.imageUrl || "",
      prepTime: recipeDetailsObj?.prep ? `PT${recipeDetailsObj.prep}M` : undefined,
      cookTime: recipeDetailsObj?.cook ? `PT${recipeDetailsObj.cook}M` : undefined,
      totalTime: recipeDetailsObj?.total 
        ? `PT${recipeDetailsObj.total}M` 
        : (recipeDetailsObj?.prep || recipeDetailsObj?.cook)
          ? `PT${(recipeDetailsObj?.prep || 0) + (recipeDetailsObj?.cook || 0)}M`
          : undefined,
      recipeYield: recipeDetailsObj?.recipeYield,
      recipeCategory: recipeDetailsObj?.recipeCategory || category?.label,
      recipeCuisine: recipeDetailsObj?.recipeCuisine,
      keywords: recipeDetailsObj?.keywords,
      recipeIngredient: recipeDetailsObj?.ingredients?.flatMap((g: any) =>
        (g.items || []).map((item: any) =>
          typeof item === "string"
            ? item
            : [item.amount, item.unit, item.name].filter(Boolean).join(" ")
        )
      ),
      recipeInstructions: recipeDetailsObj?.instructions?.flatMap((section: any) =>
        (section.steps || []).map((step: any) => ({
          text: typeof step === "string" ? step : step.text
        }))
      ),
      nutrition: recipeDetailsObj?.nutrition,
      aggregateRating: recipeDetailsObj?.aggregateRating
    }}
  />
</RecipeLayout>
