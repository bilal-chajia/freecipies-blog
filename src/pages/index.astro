---
import { env } from 'cloudflare:workers';
import Layout from '@layouts/Layout.astro';
import HomeSections from '@components/home/HomeSections.astro';
import { resolveHomeData, type HomeSectionVM } from '@site/utils/home-data';
import { buildHomeJsonLd, serializeJsonLd } from '@site/utils/home-jsonld';
import {
  getPublicHomepageSettings,
  getStories,
  getPublicSiteIdentity,
  getPublicOrganizationProfile,
  getPublicSocialLinks,
} from '@server/site-data';

const homepageSettings = await getPublicHomepageSettings();

const [stories, identity, organization, socialLinks] = await Promise.all([
  getStories(),
  getPublicSiteIdentity(),
  getPublicOrganizationProfile(),
  getPublicSocialLinks(),
]);

let sectionVms: HomeSectionVM[] = [];
try {
  sectionVms = await resolveHomeData(homepageSettings.sections, { db: env.DB, stories });
} catch (error) {
  console.error('Error resolving homepage data:', error);
}

const jsonLdRecipes = [
  ...sectionVms.filter((section) => section.kind === 'hero'),
  ...sectionVms.filter((section) => section.kind === 'featured_recipes'),
].flatMap((section) => section.recipes).map((article) => ({
  id: article.id,
  name: article.headline,
  url: article.route || `/recipes/${article.slug}`,
}));
const faqItems = sectionVms.find((section) => section.kind === 'faq')?.items ?? [];

const jsonLd = buildHomeJsonLd({
  identity,
  organization,
  socialLinks,
  searchUrlTemplate: `${identity.site_url.replace(/\/$/, '')}/recipes?search={search_term_string}`,
  recipes: jsonLdRecipes,
  faqItems,
});

const hasRenderedHero = sectionVms.some(
  (section) => section.kind === 'hero' && section.recipes.length > 0,
);
---

<Layout
  title={homepageSettings.seo.meta_title}
  description={homepageSettings.seo.meta_description}
  image={homepageSettings.seo.og_image}
  noindex={homepageSettings.seo.no_index}
>
  <main class="homepage">
    {!hasRenderedHero && (
      <header class="home-fallback-intro" data-fade-up>
        <h1>{identity.tagline || identity.site_name}</h1>
      </header>
    )}
    <HomeSections sections={sectionVms} siteTagline={identity.tagline || identity.site_name} />
  </main>
  {jsonLd.map((node) => (
    <script type="application/ld+json" set:html={serializeJsonLd(node)} />
  ))}
</Layout>

<style>
  .home-fallback-intro {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-6) var(--space-5);
    text-align: left;
  }

  .home-fallback-intro h1 {
    margin: 0;
    max-width: 18ch;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.5rem + 1.8vw, 3rem);
    font-weight: var(--font-bold);
    line-height: var(--leading-tight);
    letter-spacing: 0;
    color: var(--text);
  }

  @media (max-width: 640px) {
    .home-fallback-intro {
      padding-inline: var(--space-4);
    }

    .home-fallback-intro h1 {
      max-width: 14ch;
      font-size: clamp(1.9rem, 9vw, 2.45rem);
    }
  }

  .homepage {
    background: var(--bg);
  }
</style>
