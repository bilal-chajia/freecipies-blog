---
import { env } from 'cloudflare:workers';
import Layout from "@layouts/Layout.astro";
import StoriesBar from "@components/StoriesBar.astro";
import WebStoryViewer from "@components/WebStoryViewer.astro";
import { getArticles } from "@modules/articles";
import { getCategories } from "@modules/categories";
import { getAuthors } from "@modules/authors";
import { hydrateCategory } from "@shared/utils/hydration";
import { extractImage, getImageSrcSet } from "@shared/utils";
import { parseCachedRecipe } from "@modules/articles/utils/cached-fields";
import { getPublicHomepageSettings, getStories } from "@server/site-data";
import type { HydratedArticle } from "@modules/articles/types";
import type { HydratedCategory } from "@modules/categories/types/categories.types";
import type { Author } from "@modules/authors/schema/authors.schema";

const homepageSettings = await getPublicHomepageSettings();
const siteTitle = homepageSettings.seo.meta_title;
const siteDescription = homepageSettings.seo.meta_description;

// Fetch data from database
let allRecipes: HydratedArticle[] = [];
let categories: HydratedCategory[] = [];
let featuredAuthor: Author | null = null;
const stories = await getStories();

try {
  // Get all recipes for various sections
  const { items: recipes } = await getArticles(env.DB, { limit: 12 });
  allRecipes = recipes;

  // Get categories
  const rawCategories = await getCategories(env.DB, { workflow_status: 'published' });
  categories = rawCategories.map(hydrateCategory);

  // Get featured author for About section
  const allAuthors = await getAuthors(env.DB, { workflow_status: 'published' });
  featuredAuthor = allAuthors.find(a => a.is_featured) || allAuthors[0] || null;
} catch (error) {
  console.error("Error fetching data for homepage:", error);
}

// Split recipes for different sections
const featuredRecipes = allRecipes.slice(0, 4);  // Hero grid
const popularRecipes = allRecipes.slice(0, 4);   // Popular section (can overlap with hero)
const moreRecipes = allRecipes.slice(4, 8);      // More recipes

// Create a map for category colors by slug
const categoryColorMap = new Map(categories.map(c => [c.slug, c.color || 'var(--brand-primary)']));

// Helper function for recipe URL
const getRecipeUrl = (recipe: HydratedArticle) =>
  recipe.route || `/recipes/${recipe.slug}`;

// Helper function for category color
const getCategoryColor = (categorySlug?: string) =>
  categoryColorMap.get(categorySlug || '') || 'var(--brand-primary)';

const getRecipeImage = (recipe: HydratedArticle, targetWidth: number, prefer: 'hero' | 'thumbnail' = 'hero') => {
  const hero = extractImage(recipe.images_json, 'hero', targetWidth);
  const thumbnail = extractImage(recipe.images_json, 'thumbnail', targetWidth);
  const slotName = prefer === 'hero'
    ? (hero.image_url ? 'hero' : 'thumbnail')
    : (thumbnail.image_url ? 'thumbnail' : 'hero');
  const selected = slotName === 'hero' ? hero : thumbnail;
  const srcSet = getImageSrcSet(recipe.images_json, slotName);
  return { selected, srcSet };
};

const getCategoryImage = (category: HydratedCategory, targetWidth: number, prefer: 'hero' | 'thumbnail' = 'thumbnail') => {
  const hero = extractImage(category.images_json, 'hero', targetWidth);
  const thumbnail = extractImage(category.images_json, 'thumbnail', targetWidth);
  const slotName = prefer === 'hero'
    ? (hero.image_url ? 'hero' : 'thumbnail')
    : (thumbnail.image_url ? 'thumbnail' : 'hero');
  const selected = slotName === 'hero' ? hero : thumbnail;
  const srcSet = getImageSrcSet(category.images_json, slotName);
  return { selected, srcSet };
};
---

<Layout
  title={siteTitle}
  description={siteDescription}
  image={homepageSettings.seo.og_image}
  noindex={homepageSettings.seo.no_index}
>
  <main class="homepage">
    <StoriesBar stories={stories} />
    {
      featuredRecipes.length > 0 && (
        <section class="hero-grid-section">
          <div class="hero-grid">
            {/* Main Slider */}
            <div class="hero-slider" id="heroSlider">
              <div class="slider-track">
                {featuredRecipes.slice(0, 4).map((recipe: HydratedArticle, index: number) => {
const { selected, srcSet } = getRecipeImage(recipe, 1200, "hero");
                  const sizes = "(max-width: 900px) 100vw, 60vw";
                  return (
                  <a
                    href={getRecipeUrl(recipe)}
                    class:list={["slide", { active: index === 0 }]}
                    data-index={index}
                  >
                    <div class="card-image">
                      {(selected.image_url || recipe.image_url) && (
                        <img
                          src={selected.image_url || recipe.image_url}
                          alt={selected.imageAlt || recipe.imageAlt || recipe.headline}
                          width={selected.imageWidth || recipe.imageWidth || 1200}
                          height={selected.imageHeight || recipe.imageHeight || 675}
                          srcset={srcSet || undefined}
                          sizes={srcSet ? sizes : undefined}
                          loading={index === 0 ? "eager" : "lazy"}
                          fetchpriority={index === 0 ? "high" : "auto"}
                          style={selected.imageStyle || undefined}
                        />
                      )}
                      <div class="card-overlay" />
                    </div>
                    <div class="card-content">
                      <span
                        class="badge card-category"
                        style={`--badge-color: ${getCategoryColor(recipe.category?.slug)};`}
                      >
                        {recipe.category?.label}
                      </span>
                      <h2 class="card-title">{recipe.headline}</h2>
                    </div>
                  </a>
                )})}
              </div>
              {/* Navigation Dots */}
              <div class="slider-dots">
                {featuredRecipes.slice(0, 4).map((_: HydratedArticle, index: number) => (
                  <button
                    class:list={["dot", { active: index === 0 }]}
                    data-index={index}
                    aria-label={`Slide ${index + 1}`}
                  />
                ))}
              </div>
            </div>

            {/* Side cards */}
            <div class="hero-side-cards">
              {featuredRecipes.slice(1, 3).map((recipe: HydratedArticle) => {
const { selected, srcSet } = getRecipeImage(recipe, 600, "hero");
                const sizes = "(max-width: 900px) 100vw, 40vw";
                return (
                <a
                  href={getRecipeUrl(recipe)}
                  class="recipe-card recipe-card-small"
                >
                  <div class="card-image">
                    {(selected.image_url || recipe.image_url) && (
                      <img
                        src={selected.image_url || recipe.image_url}
                        alt={selected.imageAlt || recipe.imageAlt || recipe.headline}
                        width={selected.imageWidth || recipe.imageWidth || 600}
                        height={selected.imageHeight || recipe.imageHeight || 400}
                        srcset={srcSet || undefined}
                        sizes={srcSet ? sizes : undefined}
                        loading="lazy"
                        style={selected.imageStyle || undefined}
                      />
                    )}
                    <div class="card-overlay" />
                  </div>
                  <div class="card-content">
                    <span
                      class="badge card-category"
                      style={`--badge-color: ${getCategoryColor(recipe.category?.slug)};`}
                    >{recipe.category?.label}</span>
                    <h3 class="card-title">{recipe.headline}</h3>
                  </div>
                </a>
              )})}
            </div>
          </div>
        </section>
      )
    }

    <!-- Popular Recipes Section -->
    {
      popularRecipes.length > 0 && (
        <section class="section popular-recipes-section">
          <div class="container">
            <div class="section-header">
              <h2 class="section-title">
                <span class="title-dot"></span>
                Popular Recipes
              </h2>
            </div>
            <div class="popular-grid">
              {popularRecipes.map((recipe: HydratedArticle) => {
const { selected, srcSet } = getRecipeImage(recipe, 400, "hero");
                const sizes = "(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 25vw";
                const cachedRecipe = parseCachedRecipe(recipe.cached_recipe_json);
                const cookTime = cachedRecipe?.cook_time_minutes ?? null;
                return (
                <article class="foxiz-card">
                  <a href={getRecipeUrl(recipe)} class="foxiz-card-image">
                    {(selected.image_url || recipe.image_url) && (
                      <img
                        src={selected.image_url || recipe.image_url}
                        alt={selected.imageAlt || recipe.imageAlt || recipe.headline}
                        width={selected.imageWidth || recipe.imageWidth || 400}
                        height={selected.imageHeight || recipe.imageHeight || 300}
                        srcset={srcSet || undefined}
                        sizes={srcSet ? sizes : undefined}
                        loading="lazy"
                        style={selected.imageStyle || undefined}
                      />
                    )}
                    <span
                      class="badge foxiz-badge"
                      style={`--badge-color: ${getCategoryColor(recipe.category?.slug)};`}
                    >
                      {recipe.category?.label}
                    </span>
                  </a>
                  <div class="foxiz-card-body">
                    <h3 class="foxiz-card-title">
                      <a href={getRecipeUrl(recipe)}>{recipe.headline}</a>
                    </h3>
                    <div class="foxiz-tags">
                      {recipe.category?.label && (
                        <a href={`/categories/${recipe.category?.slug}`} class="foxiz-tag">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h6l2 3h8v10H4z"/>
                          </svg>
                          {recipe.category?.label}
                        </a>
                      )}
                      {cookTime && (
                        <span class="foxiz-tag">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 6v6l4 2"/>
                          </svg>
                          {`${cookTime} min`}
                        </span>
                      )}
                    </div>
                  </div>
                </article>
                );
              })}
            </div>
          </div>
        </section>
      )
    }

    <!-- Want to Learn How to Make Section -->
    {
      categories.length > 0 && (
        <section class="section categories-section">
          <div class="container">
            <h2 class="section-title centered">Want to Learn How to Make?</h2>

            <!-- Category Filter Buttons -->
            <div class="category-filter-row">
              {categories.slice(0, 4).map((category) => (
                <a href={`/categories/${category.slug}`} class="filter-pill">
                  {category.label}
                </a>
              ))}
            </div>

            <!-- Category Chips with Images -->
            <div class="category-chips-row">
              {categories.map((category: HydratedCategory) => {
                const { selected, srcSet } = getCategoryImage(category, 80, "thumbnail");
                const sizes = "80px";
                return (
                <a href={`/categories/${category.slug}`} class="chip-standard category-chip">
                  <div class="chip-image">
                    {(selected.image_url || category.image_url) ? (
                      <img
                        src={selected.image_url || category.image_url}
                        alt={selected.imageAlt || category.imageAlt || category.label}
                        width={selected.imageWidth || category.imageWidth || 80}
                        height={selected.imageHeight || category.imageHeight || 80}
                        srcset={srcSet || undefined}
                        sizes={srcSet ? sizes : undefined}
                        loading="lazy"
                        style={selected.imageStyle || undefined}
                      />
                    ) : (
                      <div class="chip-placeholder">
                        {category.label.charAt(0)}
                      </div>
                    )}
                  </div>
                  <span class="chip-label">{category.label}</span>
                </a>
                );
              })}
            </div>
          </div>
        </section>
      )
    }

    <!-- About the Author Section -->
    {
      featuredAuthor && (() => {
        const authorImage = extractImage(featuredAuthor.images_json, 'avatar', 600);
        const authorImageUrl = authorImage.image_url || '';
        const authorName = featuredAuthor.name || 'Our Chef';
        const authorBio = featuredAuthor.short_description || '';
        const authorSlug = featuredAuthor.slug || '';
        return (
          <section class="section about-author-section">
            <div class="container">
              <div class="about-author-wrapper">
                <div class="about-author-image">
                  {authorImageUrl ? (
                    <img
                      src={authorImageUrl}
                      alt={authorName}
                      width={authorImage.imageWidth || 600}
                      height={authorImage.imageHeight || 600}
                      loading="lazy"
                      style={authorImage.imageStyle || undefined}
                    />
                  ) : (
                    <div class="about-author-placeholder">
                      <span>{authorName.charAt(0)}</span>
                    </div>
                  )}
                </div>
                <div class="about-author-content">
                  <span class="about-author-eyebrow">meet {authorName.split(' ')[0]?.toLowerCase()}</span>
                  <h2 class="about-author-title">About the Author</h2>
                  <p class="about-author-bio">{authorBio}</p>
                  <a href={`/authors/${authorSlug}`} class="about-author-link">
                    About {authorName.split(' ')[0]} →
                  </a>
                </div>
              </div>
            </div>
          </section>
        );
      })()
    }

    <!-- More Recipes Section -->
    {
      moreRecipes.length > 0 && (
        <section class="section more-recipes-section">
          <div class="container">
            <div class="section-header">
              <h2 class="section-title">
                <span class="title-dot"></span>
                More Recipes
              </h2>
              <a href="/recipes" class="view-all">
                View All →
              </a>
            </div>
            <div class="recipes-grid">
              {moreRecipes.map((recipe: HydratedArticle) => {
const { selected, srcSet } = getRecipeImage(recipe, 400, "hero");
                const sizes = "(max-width: 768px) 50vw, 25vw";
                const cachedRecipe = parseCachedRecipe(recipe.cached_recipe_json);
                const prepTime = cachedRecipe?.prep_time_minutes ?? null;
                return (
                <a href={getRecipeUrl(recipe)} class="recipe-card-vertical">
                  <div class="card-image-wrapper">
                    {(selected.image_url || recipe.image_url) && (
                      <img
                        src={selected.image_url || recipe.image_url}
                        alt={selected.imageAlt || recipe.imageAlt || recipe.headline}
                        width={selected.imageWidth || recipe.imageWidth || 400}
                        height={selected.imageHeight || recipe.imageHeight || 300}
                        srcset={srcSet || undefined}
                        sizes={srcSet ? sizes : undefined}
                        loading="lazy"
                        style={selected.imageStyle || undefined}
                      />
                    )}
                    <span
                      class="badge card-category-badge"
                      style={`--badge-color: ${getCategoryColor(recipe.category?.slug)};`}
                    >
                      {recipe.category?.label}
                    </span>
                  </div>
                  <div class="card-body">
                    <h3 class="card-title">{recipe.headline}</h3>
                    <div class="card-meta">
                      {prepTime && (
                        <span class="meta-item">
                          <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 6v6l4 2" />
                          </svg>
                          {`${prepTime} min`}
                        </span>
                      )}
                    </div>
                  </div>
                </a>
                );
              })}
            </div>
          </div>
        </section>
      )
    }

    <!-- Newsletter Banner -->
    <section class="newsletter-banner">
      <div class="container">
        <div class="newsletter-content">
          <h2>Get New Recipes Weekly</h2>
          <p>Subscribe to receive delicious recipes straight to your inbox.</p>
          <form class="newsletter-form">
            <input type="email" placeholder="Your email address" required />
            <button type="submit">Subscribe</button>
          </form>
        </div>
      </div>
    </section>
  </main>
  <WebStoryViewer />
</Layout>

<style>
  /* === Foxiz Design System === */
  :root {
    --primary: var(--brand-primary);
    --primary-hover: var(--brand-primary-hover);
    --dark: var(--text);
    --text-light: var(--text-tertiary);
    --radius: var(--radius-md);
    --shadow: var(--shadow-md);
    --transition: all 0.3s ease;
  }

  .homepage {
    background: var(--bg);
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 20px;
  }

  .section {
    padding: clamp(3rem, 7vw, 5.5rem) 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 1.25rem + 1.2vw, 2.35rem);
    font-weight: 700;
    color: var(--text);
    margin: 0;
    letter-spacing: 0;
  }

  .view-all {
    color: var(--primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: var(--transition);
  }

  .view-all:hover {
    color: var(--primary-hover);
  }

  /* === Hero Grid (Foxiz style) === */
  .hero-grid-section {
    padding: clamp(1rem, 3vw, 2rem);
    background:
      radial-gradient(circle at 12% 0%, color-mix(in srgb, var(--brand-primary-light) 72%, transparent), transparent 28rem),
      var(--bg);
  }

  .hero-grid {
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .hero-side-cards {
    display: grid;
    gap: 20px;
  }

  /* === Hero Slider === */
  .hero-slider {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    min-height: 500px;
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 900px) {
    .hero-slider {
      min-height: 350px;
    }
  }

  .slider-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease, visibility 0.6s ease;
    text-decoration: none;
  }

  .slide.active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .slide .card-image {
    position: absolute;
    inset: 0;
  }

  .slide .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.2) 50%,
      transparent 100%
    );
  }

  .slide .card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30px;
    z-index: 2;
  }

  .slide .card-category {
    display: inline-block;
    background: linear-gradient(
        rgba(0, 0, 0, 0.35),
        rgba(0, 0, 0, 0.35)
      ),
      var(--badge-color, var(--primary));
    margin-bottom: 12px;
  }

  .slide .card-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.25rem + 1.6vw, 3rem);
    font-weight: 700;
    color: white;
    margin: 0;
    line-height: 1.3;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 600px) {
    .slide .card-title {
      font-size: 22px;
    }
    .slide .card-content {
      padding: 20px;
    }
  }

  /* Slider Navigation Dots */
  .slider-dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  .dot {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
    display: grid;
    place-items: center;
  }

  .dot::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    transition: all 0.3s ease;
  }

  .dot:hover::before,
  .dot.active::before {
    background: white;
    transform: scale(1.2);
  }

  /* === Recipe Cards (Overlay style) === */
  .recipe-card {
    position: relative;
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: var(--text-inverse);
    box-shadow: var(--shadow-md);
  }

  .recipe-card-large {
    min-height: 500px;
  }

  .recipe-card-small {
    min-height: 155px;
  }

  @media (max-width: 900px) {
    .recipe-card-large {
      min-height: 350px;
    }
    .recipe-card-small {
      min-height: 200px;
    }
  }

  .recipe-card .card-image {
    position: absolute;
    inset: 0;
  }

  .recipe-card .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .recipe-card:hover .card-image img {
    transform: scale(1.05);
  }

  .recipe-card .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.2) 50%,
      transparent 100%
    );
  }

  .recipe-card .card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 25px;
    z-index: 1;
  }

  .recipe-card-small .card-content {
    padding: 15px;
  }

  .recipe-card .card-category {
    display: inline-block;
    background: linear-gradient(
        rgba(0, 0, 0, 0.35),
        rgba(0, 0, 0, 0.35)
      ),
      var(--badge-color, var(--primary));
    margin-bottom: 10px;
  }

  .recipe-card .card-title {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 10px;
    line-height: 1.3;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .recipe-card-small .card-title {
    font-size: 16px;
    margin-bottom: 5px;
  }

  .recipe-card .card-meta {
    display: flex;
    gap: 15px;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    opacity: 0.9;
  }

  .meta-item svg {
    width: 14px;
    height: 14px;
  }

  /* === Category Section === */
  .categories-section {
    background: var(--bg);
    padding: 50px 0;
  }

  .section-title.centered {
    text-align: center;
    margin-bottom: 30px;
  }

  .title-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    background: var(--brand-primary);
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: middle;
  }

  /* === Foxiz-style Popular Recipes Cards === */
  .popular-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
    gap: clamp(15px, 3vw, 25px);
  }

  .foxiz-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .foxiz-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .foxiz-card-image {
    position: relative;
    display: block;
    border-radius: 0;
    overflow: hidden;
    aspect-ratio: 4/3;
  }

  .foxiz-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .foxiz-card:hover .foxiz-card-image img {
    transform: scale(1.05);
  }

  .foxiz-badge {
    position: absolute;
