---
import { env } from 'cloudflare:workers';
import Layout from "@layouts/Layout.astro";
import CategoryCard from "@components/CategoryCard.astro";
import { getCategories } from "@modules/categories";
import { hydrateCategory } from "@shared/utils";
import { extractImage, getImageSrcSet } from "@shared/utils";
let categories: any[] = [];

try {
  const rawCategories = await getCategories(env.DB, { workflow_status: 'published' });
  categories = rawCategories.map(hydrateCategory);
} catch (error) {
  console.error("Categories index: Error fetching categories:", error);
}

// Featured category (first one or one marked as featured)
const featured = categories.find((c) => c.is_featured) || categories[0];
const otherCategories = categories.filter((c) => c.id !== featured?.id);

// Get featured image
const featuredImage = featured
  ? extractImage(featured.images_json, "hero", 1200)
  : null;
const featuredSrcSet = featured
  ? getImageSrcSet(featured.images_json, "hero")
  : "";
---

<Layout title="All Categories" description="Browse all recipe categories">
  <section class="categories-page">
    <!-- Hero Section -->
    {
      featured && (
        <a href={`/categories/${featured.slug}`} class="hero-category">
          <div class="hero-image">
            <img
              src={
                featuredImage?.image_url ||
                "https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1200"
              }
              alt={featuredImage?.imageAlt || featured.label}
              srcset={featuredSrcSet || undefined}
              sizes="100vw"
              loading="eager"
              style={featuredImage?.imageStyle || undefined}
            />
            <div class="hero-overlay" />
          </div>
          <div class="hero-content">
            <span class="hero-badge">Featured Collection</span>
            <h1 class="hero-title">{featured.label}</h1>
            <p class="hero-description">{featured.short_description}</p>
            <span class="hero-cta">
              Explore Collection
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      )
    }

    <!-- Grid Section -->
    <div class="categories-grid-section">
      <h2 class="section-title">All Categories</h2>
      <div class="categories-grid">
        {
          otherCategories.map((category) => (
            <CategoryCard category={category} />
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .categories-page {
    background: var(--bg);
    min-height: 100vh;
  }

  /* Hero Section */
  .hero-category {
    display: block;
    position: relative;
    height: 60vh;
    min-height: 400px;
    max-height: 600px;
    overflow: hidden;
    text-decoration: none;
  }

  .hero-image {
    position: absolute;
    inset: 0;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .hero-category:hover .hero-image img {
    transform: scale(1.05);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.4) 50%,
      rgba(0, 0, 0, 0.2) 100%
    );
  }

  .hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-8);
    color: var(--neutral-25);
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    background: var(--brand-gradient);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }

  .hero-title {
    font-size: clamp(var(--text-4xl), 5vw, 3.5rem);
    font-weight: var(--font-extrabold);
    margin: 0 0 var(--space-3) 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .hero-description {
    font-size: var(--text-lg);
    opacity: 0.9;
    margin: 0 0 var(--space-6) 0;
    max-width: 600px;
    line-height: var(--leading-relaxed);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--bg-elevated);
    color: var(--text);
    padding: 0.875rem var(--space-6);
    border-radius: var(--radius-sm);
    font-weight: var(--font-semibold);
    transition: all var(--transition-slow);
  }

  .hero-cta svg {
    width: 20px;
    height: 20px;
    transition: transform var(--transition-slow);
  }

  .hero-category:hover .hero-cta {
    background: var(--brand-primary);
    color: var(--text-inverse);
  }

  .hero-category:hover .hero-cta svg {
    transform: translateX(4px);
  }

  /* Grid Section */
  .categories-grid-section {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-16);
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--text);
    margin: 0 0 var(--space-8) 0;
    padding-bottom: var(--space-4);
    border-bottom: 2px solid var(--border);
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-content {
      padding: var(--space-12);
    }
  }

  @media (min-width: 1024px) {
    .categories-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }

    .hero-content {
      padding: var(--space-16);
    }

    .categories-grid-section {
      padding: var(--space-16) var(--space-8) var(--space-20);
    }
  }
</style>
