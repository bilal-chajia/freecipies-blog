{
  "extends": "astro/tsconfigs/base",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "src/admin/*"
      ],
      "@modules/*": [
        "src/modules/*"
      ],
      "@admin/*": [
        "src/admin/*"
      ],
      "@site/*": [
        "src/site/*"
      ],
      "@server/*": [
        "src/server/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@components/*": [
        "src/site/components/*"
      ],
      "@layouts/*": [
        "src/site/layouts/*"
      ],
      "@styles/*": [
        "src/site/styles/*"
      ]
    }
  }
}
